{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homemew-web",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "env": {
    "production": {
      "name": "homemew-web-production",
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "production",
        "LIFESPACE_IDENTITY_URL": "https://auth.aisr.online",
        "LIFESPACE_CORE_URL": "https://core.aisr.online"
      },
      "services": [
        {
          "binding": "HOMEMEW_BACKEND",
          "service": "homemew-backend-production"
        }
      ]
    }
  }
}
