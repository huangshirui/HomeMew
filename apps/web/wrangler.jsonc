{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homemew-web",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "env": {
    "staging": {
      "name": "homemew-web-staging",
      "workers_dev": false,
      "routes": [
        { "pattern": "homemew-web-staging.aisr.online", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "LIFESPACE_IDENTITY_URL": "https://auth-staging.aisr.online",
        "LIFESPACE_CORE_URL": "https://core-staging.aisr.online"
      }
    },
    "production": {
      "name": "homemew-web-production",
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "production",
        "LIFESPACE_IDENTITY_URL": "https://auth.aisr.online",
        "LIFESPACE_CORE_URL": "https://core.aisr.online"
      }
    }
  }
}
