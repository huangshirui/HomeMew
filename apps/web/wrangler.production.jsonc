{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homemew-web",
  "main": "front-door.mjs",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/_stage/*",
      "/health"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "LIFESPACE_IDENTITY_URL": "https://auth.aisr.online",
    "LIFESPACE_CORE_URL": "https://core.aisr.online"
  },
  "services": [
    {
      "binding": "HOMEMEW_BACKEND",
      "service": "homemew-backend-production"
    },
    {
      "binding": "LIFESPACE_CORE",
      "service": "lifespace-core"
    },
    {
      "binding": "LIFESPACE_IDENTITY",
      "service": "lifespace-identity"
    }
  ],
  "ratelimits": [
    {
      "name": "PLACE_SEARCH_USER_LIMIT",
      "namespace_id": "610001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "PLACE_SEARCH_BURST_LIMIT",
      "namespace_id": "610002",
      "simple": { "limit": 8, "period": 10 }
    }
  ],
  "preview_urls": true,
  "previews": {
    "ratelimits": [
      {
        "name": "PLACE_SEARCH_USER_LIMIT",
        "namespace_id": "610003",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        "name": "PLACE_SEARCH_BURST_LIMIT",
        "namespace_id": "610004",
        "simple": { "limit": 8, "period": 10 }
      }
    ],
    "vars": {
      "ENVIRONMENT": "staging",
      "LIFESPACE_IDENTITY_URL": "https://auth-staging.aisr.online",
      "LIFESPACE_CORE_URL": "https://core-staging.aisr.online"
    },
    "services": [
      {
        "binding": "HOMEMEW_BACKEND",
        "service": "homemew-backend-staging"
      },
      {
        "binding": "LIFESPACE_CORE",
        "service": "lifespace-core-staging"
      },
      {
        "binding": "LIFESPACE_IDENTITY",
        "service": "lifespace-identity-staging"
      }
    ],
    "observability": {
      "enabled": true
    }
  }
}
