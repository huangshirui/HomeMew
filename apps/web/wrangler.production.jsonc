{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homemew-web-production",
  "main": "front-door.mjs",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "LIFESPACE_IDENTITY_URL": "https://auth.aisr.online",
    "LIFESPACE_CORE_URL": "https://core.aisr.online",
    "LIFESPACE_EVENT_CONTRACT": "temporal_range"
  },
  "services": [
    { "binding": "HOMEMEW_BACKEND", "service": "homemew-backend-production" },
    { "binding": "LIFESPACE_CORE", "service": "lifespace-core" },
    { "binding": "LIFESPACE_IDENTITY", "service": "lifespace-identity" }
  ]
}
