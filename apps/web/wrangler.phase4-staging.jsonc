{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homemew-web-staging",
  "main": "front-door.mjs",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "routes": [
    { "pattern": "homemew-web-staging.aisr.online", "custom_domain": true }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "LIFESPACE_IDENTITY_URL": "https://auth-staging.aisr.online",
    "LIFESPACE_CORE_URL": "https://core-staging.aisr.online",
    "LIFESPACE_EVENT_CONTRACT": "temporal_range"
  },
  "services": [
    { "binding": "HOMEMEW_BACKEND", "service": "homemew-backend-staging" },
    { "binding": "LIFESPACE_CORE", "service": "lifespace-core-staging" },
    { "binding": "LIFESPACE_IDENTITY", "service": "lifespace-identity-staging" }
  ]
}
