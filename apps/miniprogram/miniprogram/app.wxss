/* HomeMew 全局样式（以首页为基准统一设计系统） */

/* 设计色板：家事喵品牌色系 */
page {
  /* 主色板 — 品牌绿 #43A047 为基准 */
  --color-primary: #43A047;
  --color-primary-dark: #358539;
  --color-primary-light: #5ABF5E;
  --color-primary-tint: #EAF6EB;
  --color-danger: #E85A5A;
  --color-warning: #FF9800;
  --color-info: #2196F3;

  /* 中性色 */
  --color-bg: #F1F8F4;
  --color-bg-white: #FFFFFF;
  --color-card: #FFFFFF;
  --color-text-primary: #222222;
  --color-text-secondary: #9299A3;
  --color-text-hint: #A6ADB6;
  --color-border: #E8EDEA;
  --color-divider: #EDF1EF;

  /* 首页样式别名（保持首页 wxss 兼容，避免重复定义） */
  --home-primary: #43A047;
  --home-primary-dark: #358539;
  --home-hero: #5ABF5E;
  --home-bg: #F1F8F4;
  --home-card: #FFFFFF;
  --home-text: #222222;
  --home-secondary: #9299A3;
  --home-danger: #E85A5A;
  --home-warning: #FF9800;
  --home-info: #2196F3;
  --home-hint: #A6ADB6;
  --home-primary-tint: #EAF6EB;

  background-color: var(--color-bg);
  color: var(--color-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 容器：底部留白，避免最后一条内容被悬浮按钮遮挡 */
.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 160rpx;
}

/* 卡片：统一为首页绿色调圆角卡片 */
.card {
  background-color: var(--color-card);
  border-radius: 26rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(67, 160, 71, 0.06);
}

/* Record editors: full-width label above an aligned icon and name input. */
.record-title-field {
  min-width: 0;
  padding: 12rpx 0;
}

.record-title-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.record-title-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.record-title-picker {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
}

.record-title-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 18rpx;
  background: var(--color-bg-white);
  font-size: 28rpx;
  color: var(--color-text-primary);
  text-align: left;
}

/* 文本工具类 */
.text-primary {
  color: var(--color-primary);
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-hint {
  color: var(--color-text-hint);
}

.text-danger {
  color: var(--color-danger);
}

.text-center {
  text-align: center;
}

/* Flex 布局 */
.flex {
  display: flex;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

/* 间距 */
.mt-sm { margin-top: 16rpx; }
.mt-md { margin-top: 24rpx; }
.mt-lg { margin-top: 32rpx; }
.mb-sm { margin-bottom: 16rpx; }
.mb-md { margin-bottom: 24rpx; }
.mb-lg { margin-bottom: 32rpx; }

/* 按钮样式（与首页一致） */
.btn-primary {
  background-color: var(--color-primary);
  color: #ffffff;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary.disabled {
  opacity: 0.5;
}

.btn-outline {
  background-color: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  text-align: center;
}

.btn-outline::after {
  border: none;
}

.btn-outline.danger {
  color: var(--color-danger);
  border-color: var(--color-danger);
}

.btn-sm {
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  padding: 0 40rpx;
  border-radius: 36rpx;
}

/* 栏目标题（与首页一致） */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
}

.section-header-right {
  display: flex;
  align-items: center;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-more {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 加载 / 内联刷新 / 错误提示（与首页一致） */
.loading-state {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-hint);
}

.inline-spin {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-right: 12rpx;
  display: inline-block;
  animation: home-spin 0.8s linear infinite;
}

@keyframes home-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.thin-error {
  padding: 18rpx 4rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-danger);
}

/* 空状态（与首页一致） */
.empty-hint {
  padding: 24rpx 4rpx 8rpx;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.empty-link {
  font-size: 26rpx;
  color: var(--color-primary);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 30rpx;
  color: var(--color-text-secondary);
}

.empty-desc {
  font-size: 26rpx;
  color: var(--color-text-hint);
  margin-top: 16rpx;
  text-align: center;
  padding: 0 60rpx;
  line-height: 1.6;
}

.empty-actions {
  margin-top: 48rpx;
  width: 60%;
  display: flex;
  flex-direction: column;
}

/* 悬浮新增按钮（与首页一致） */
.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(56rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  color: #ffffff;
  font-size: 60rpx;
  font-weight: 300;
  line-height: 104rpx;
  text-align: center;
  box-shadow: 0 10rpx 28rpx rgba(67, 160, 71, 0.4);
  z-index: 50;
}

.fab-text {
  font-size: 60rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 加载失败状态（编辑页等复用） */
.load-error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  gap: 24rpx;
}

.load-error-text {
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.load-error-state .btn-sm {
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}
