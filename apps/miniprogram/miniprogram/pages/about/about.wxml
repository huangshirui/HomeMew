<view class="container about-page">
  <view class="card brand-card">
    <view class="brand-mark">喵</view>
    <view class="brand-copy">
      <text class="brand-title">家事喵</text>
      <text class="brand-version">v{{version}}</text>
      <text class="brand-desc">你的家庭事务小助手</text>
    </view>
  </view>

  <view class="card latency-card">
    <view class="latency-header">
      <view>
        <text class="section-title">响应时间测试</text>
        <text class="section-subtitle">Core production · 每项 3 次取中位数</text>
      </view>
      <button class="retry-btn" bindtap="onRetryLatency" disabled="{{testing}}">
        {{testing ? '测试中…' : '重新测试'}}
      </button>
    </view>

    <view wx:if="{{testing && !latency}}" class="testing-state">
      <text class="inline-spin">⟳</text>
      <text class="testing-text">正在测试网络和 D1 响应时间…</text>
    </view>

    <view wx:if="{{errorText}}" class="error-box">
      <text class="error-text">{{errorText}}</text>
    </view>

    <block wx:if="{{latency}}">
      <view wx:if="{{testing}}" class="refreshing-line">
        <text class="inline-spin">⟳</text>
        <text>正在重新测试，当前显示上次结果</text>
      </view>

      <view class="metric-grid">
        <view class="metric-item">
          <text class="metric-label">网络 RTT</text>
          <text class="metric-value">{{latency.networkRttText}}</text>
          <text class="metric-note">微信网络栈提供时显示</text>
        </view>
        <view class="metric-item">
          <text class="metric-label">/health 端到端</text>
          <text class="metric-value">{{latency.healthText}}</text>
          <text class="metric-note">设备 → Edge → Core Worker → 设备</text>
        </view>
        <view class="metric-item">
          <text class="metric-label">Core + D1</text>
          <text class="metric-value">{{latency.statusText}}</text>
          <text class="metric-note">/api/v1/status，包含 1 次 D1 查询</text>
        </view>
        <view class="metric-item">
          <text class="metric-label">Worker + D1 附加</text>
          <text class="metric-value">{{latency.extraText}}</text>
          <text class="metric-note">status − health，仅作估算</text>
        </view>
      </view>

      <view class="sample-block">
        <view class="sample-row">
          <text class="sample-label">Health 三次</text>
          <text class="sample-value">{{latency.healthSamplesText}}</text>
        </view>
        <view class="sample-row">
          <text class="sample-label">Status 三次</text>
          <text class="sample-value">{{latency.statusSamplesText}}</text>
        </view>
      </view>

      <view class="environment-block">
        <text class="environment-line">网络：{{latency.networkTypeText}}</text>
        <text class="environment-line">Core：{{latency.coreBaseUrl}}</text>
        <text class="environment-line">测试时间：{{latency.testedAtText}}</text>
      </view>
    </block>
  </view>

  <view class="card note-card">
    <text class="note-title">怎么看这些数字</text>
    <text class="note-text">/health 不访问 D1，所以它更接近当前设备到 Core Worker 的网络与 Edge 基线。</text>
    <text class="note-text">/api/v1/status 会读取 LifeSpace Core 的 schema metadata，因此包含一次真实 D1 往返。</text>
    <text class="note-text">两者差值会受到连接复用、网络抖动和 Worker 调度影响，不等于 D1 SQL 执行时间。</text>
  </view>
</view>
