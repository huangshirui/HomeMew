/* 日程创建/编辑页样式 */

/* 编辑页使用底部固定保存栏，无需为悬浮按钮预留底部留白 */
.container {
  padding-bottom: 0;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-hint);
}

.section {
  padding: 8rpx 28rpx;
}

.field-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.field-row:last-child {
  border-bottom: none;
}

.field-row.column {
  flex-direction: column;
  align-items: stretch;
  padding: 20rpx 0;
}

.field-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text-primary);
  height: 60rpx;
  text-align: right;
}

.field-textarea {
  width: 100%;
  margin-top: 16rpx;
  min-height: 120rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
}

.field-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.field-text {
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.field-arrow {
  font-size: 32rpx;
  color: #cccccc;
}

.all-day-row {
  justify-content: space-between;
}

.time-hint {
  padding: 16rpx 0 8rpx;
}

.time-hint-text {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

/* 参与人多选 */
.member-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 8rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.select-all {
  padding: 8rpx 16rpx;
}

.select-all-text {
  font-size: 24rpx;
  color: var(--color-primary);
}

.member-list {
  padding-top: 8rpx;
}

.member-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.member-item:last-child {
  border-bottom: none;
}

.member-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #d0d0d0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.member-check.member-check-on {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}

.check-icon {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
  line-height: 1;
}

.member-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--color-bg);
  flex-shrink: 0;
}

.member-name {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.member-item.member-selected .member-name {
  color: var(--color-primary);
  font-weight: 500;
}

/* 底部固定保存栏 */
.footer-spacer {
  height: 180rpx;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  background-color: var(--color-bg-white);
  border-top: 2rpx solid var(--color-divider);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  z-index: 20;
}

.footer-btn {
  flex: 1;
}

.timezone-value {
  max-width: 440rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  text-align: right;
}

.advanced-toggle {
  justify-content: space-between;
}

.timezone-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  background: rgba(0, 0, 0, 0.42);
}

.timezone-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 41;
  padding: 28rpx 28rpx 0;
  border-radius: 28rpx 28rpx 0 0;
  background: var(--color-bg-white);
}

.timezone-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.timezone-sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.timezone-sheet-close {
  color: var(--color-primary);
  font-size: 28rpx;
}

.timezone-search {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--color-bg);
  font-size: 28rpx;
}

.timezone-list {
  height: 620rpx;
  margin-top: 16rpx;
}

.timezone-option {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 22rpx 4rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.timezone-option-label {
  color: var(--color-text-primary);
  font-size: 29rpx;
}

.timezone-option-id {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}
