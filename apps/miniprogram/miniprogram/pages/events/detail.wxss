/* 日程详情页样式 */

.loading-state {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-hint);
}

.hero-card {
  padding: 32rpx 28rpx;
}

.hero-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  flex: 1;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  word-break: break-all;
}

.cancelled-tag {
  font-size: 22rpx;
  color: var(--color-text-hint);
  background-color: var(--color-bg);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.hero-time {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--color-primary);
}

.time-text {
  color: var(--color-primary);
  font-weight: 500;
}

.time-sep {
  color: var(--color-text-hint);
}

.section {
  padding: 24rpx 28rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-bottom: 12rpx;
}

.section-value {
  display: block;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.section-value.multiline {
  white-space: pre-wrap;
  word-break: break-all;
  line-height: 1.6;
}

.meta {
  padding: 24rpx 28rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.meta-label {
  width: 160rpx;
  font-size: 26rpx;
  color: var(--color-text-hint);
}

.meta-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.actions .flex-1 {
  flex: 1;
}

.btn-outline.danger {
  color: var(--color-danger);
  border-color: var(--color-danger);
}