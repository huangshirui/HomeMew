<!-- 日程创建/编辑页 -->
<view class="container">
  <nav-bar title="添加日程" showBack="true" />

  <!-- 加载失败 -->
  <view wx:if="{{loadError}}" class="load-error-state">
    <text class="load-error-text">加载失败</text>
    <button class="btn-outline btn-sm" bindtap="onRetryLoad">重新加载</button>
  </view>

  <view wx:elif="{{!loaded}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 标题 -->
    <view class="card section">
      <view class="field-row">
        <text class="field-label">标题</text>
        <input
          class="field-input"
          value="{{summary}}"
          bindinput="onSummaryInput"
          placeholder="例如：周末家庭聚餐"
          maxlength="60"
        />
      </view>
    </view>

    <!-- 日期 / 时间 -->
    <view class="card section">
      <!-- 起始日期 -->
      <view class="field-row" bindtap="onOpenStartDate">
        <text class="field-label">日期</text>
        <view class="field-value">
          <text class="field-text">{{startDate || '请选择日期'}}</text>
          <text class="field-arrow">›</text>
        </view>
      </view>

      <!-- 结束日期 -->
      <view class="field-row" bindtap="onOpenEndDate">
        <text class="field-label">结束日期</text>
        <view class="field-value">
          <text class="field-text">{{endDate || '请选择结束日期'}}</text>
          <text class="field-arrow">›</text>
        </view>
      </view>

      <!-- 连续重复天数（仅新建，最长 7 天） -->
      <view wx:if="{{mode === 'create'}}" class="field-row">
        <text class="field-label">重复</text>
        <picker
          class="field-picker"
          mode="selector"
          range="{{repeatOptions}}"
          value="{{repeatDays - 1}}"
          bindchange="onRepeatChange"
        >
          <view class="field-value">
            <text class="field-text">{{repeatSummaryText}}</text>
            <text class="field-arrow">›</text>
          </view>
        </picker>
      </view>

      <!-- 全天开关 -->
      <view class="field-row all-day-row">
        <text class="field-label">全天</text>
        <switch checked="{{isAllDay}}" bindchange="onAllDayChange" color="#4CAF50" />
      </view>

      <block wx:if="{{!isAllDay}}">
        <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
          <view class="field-row">
            <text class="field-label">开始时间</text>
            <view class="field-value">
              <text class="field-text">{{startTime}}</text>
              <text class="field-arrow">›</text>
            </view>
          </view>
        </picker>
        <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
          <view class="field-row">
            <text class="field-label">结束时间</text>
            <view class="field-value">
              <text class="field-text">{{endTime}}</text>
              <text class="field-arrow">›</text>
            </view>
          </view>
        </picker>

        <!-- 时区（默认折叠，展开后不可收回） -->
        <view wx:if="{{!showAdvanced}}" class="field-row advanced-toggle" bindtap="onToggleAdvanced">
          <text class="field-label">时区</text>
          <text class="field-arrow">›</text>
        </view>

        <block wx:if="{{showAdvanced}}">
          <view class="field-row" data-target="start" bindtap="onOpenTimezone">
            <text class="field-label">起点时区</text>
            <view class="field-value">
              <text class="timezone-value">{{startTimezoneLabel}} · {{startTimezone}}</text>
              <text class="field-arrow">›</text>
            </view>
          </view>

          <view class="field-row" data-target="end" bindtap="onOpenTimezone">
            <text class="field-label">终点时区</text>
            <view class="field-value">
              <text class="timezone-value">{{endTimezoneLabel}} · {{endTimezone}}</text>
              <text class="field-arrow">›</text>
            </view>
          </view>
        </block>
      </block>

      <view wx:else class="time-hint">
        <text class="time-hint-text">全天日程不选择具体时间</text>
      </view>
    </view>

    <!-- 参与人多选 -->
    <view class="card section">
      <view class="member-header">
        <text class="field-label">参与人</text>
        <view class="select-all" bindtap="onSelectAll">
          <text class="select-all-text">全选/反选</text>
        </view>
      </view>
      <view class="member-list">
        <view
          wx:for="{{members}}"
          wx:key="userId"
          class="member-item {{item.selected ? 'member-selected' : ''}}"
          data-id="{{item.userId}}"
          bindtap="onMemberToggle"
        >
          <view class="member-check {{item.selected ? 'member-check-on' : ''}}">
            <text wx:if="{{item.selected}}" class="check-icon">✓</text>
          </view>
          <image
            class="member-avatar"
            src="{{item.avatarUrl}}"
            mode="aspectFill"
          />
          <text class="member-name">{{item.displayName}}</text>
        </view>
      </view>
    </view>

    <!-- 地点 -->
    <view class="card section">
      <view class="field-row">
        <text class="field-label">地点</text>
        <input
          class="field-input"
          value="{{location}}"
          bindinput="onLocationInput"
          placeholder="选填"
          maxlength="100"
        />
      </view>
    </view>

    <!-- 备注 -->
    <view class="card section">
      <view class="field-row column">
        <text class="field-label">备注</text>
        <textarea
          class="field-textarea"
          value="{{description}}"
          bindinput="onDescriptionInput"
          placeholder="选填"
          maxlength="500"
          auto-height
        />
      </view>
    </view>

    <view class="footer-spacer"></view>
  </block>

  <!-- 底部固定保存栏（仅加载成功后显示，避免加载中 / 失败时仍可点击） -->
  <view wx:if="{{loaded}}" class="footer-bar safe-area-bottom">
    <button class="btn-outline footer-btn" bindtap="onCancel">取消</button>
    <button
      class="btn-primary footer-btn"
      disabled="{{submitting}}"
      bindtap="onSubmit"
    >
      {{submitting ? '保存中...' : (mode === 'edit' ? '保存' : '创建')}}
    </button>
  </view>

  <view wx:if="{{showTimezoneSheet}}" class="timezone-mask" bindtap="onCloseTimezone"></view>
  <view wx:if="{{showTimezoneSheet}}" class="timezone-sheet safe-area-bottom">
    <view class="timezone-sheet-header">
      <text class="timezone-sheet-title">选择{{timezoneTarget === 'start' ? '起点' : '终点'}}时区</text>
      <text class="timezone-sheet-close" bindtap="onCloseTimezone">完成</text>
    </view>
    <input
      class="timezone-search"
      value="{{timezoneQuery}}"
      bindinput="onTimezoneSearch"
      placeholder="搜索城市或 IANA 时区"
      confirm-type="search"
    />
    <scroll-view class="timezone-list" scroll-y>
      <view
        wx:for="{{filteredTimezoneOptions}}"
        wx:key="id"
        class="timezone-option"
        data-id="{{item.id}}"
        bindtap="onSelectTimezone"
      >
        <text class="timezone-option-label">{{item.label}}</text>
        <text class="timezone-option-id">{{item.id}}</text>
      </view>
    </scroll-view>
  </view>

  <date-calendar
    show="{{showStartCalendar}}"
    mode="single"
    value="{{startDate}}"
    min-date="{{minDate}}"
    title="选择开始日期"
    bind:select="onStartDateSelect"
    bind:close="onCloseStartCalendar"
  />

  <date-calendar
    show="{{showEndCalendar}}"
    mode="single"
    value="{{endDate}}"
    min-date="{{startDate}}"
    title="选择结束日期"
    bind:select="onEndDateSelect"
    bind:close="onCloseEndCalendar"
  />
</view>
