<!-- 日程页：成员范围 + 折叠月历 + 双向时间线 -->
<view class="page">
  <nav-bar title="家庭日程" topInset="0" />

  <!-- 无家庭引导 -->
  <block wx:if="{{noFamily}}">
    <view class="empty-state">
      <image class="empty-image" src="/assets/images/empty-family.png" mode="aspectFit" />
      <text class="empty-title">还没有家庭</text>
      <text class="empty-desc">加入或创建家庭后，就可以和家人共享日程和待办。</text>
      <view class="empty-actions">
        <button class="btn-primary" bindtap="onCreateFamily">创建家庭</button>
        <button class="btn-outline" style="margin-top: 24rpx;" bindtap="onJoinFamily">加入家庭</button>
      </view>
    </view>
  </block>

  <!-- 首屏加载失败 -->
  <block wx:elif="{{initError}}">
    <view class="empty-state">
      <text class="empty-title">日程加载失败</text>
      <view class="empty-actions empty-actions-row">
        <button class="btn-outline btn-sm" bindtap="onRetryInit">点击重试</button>
      </view>
    </view>
  </block>

  <block wx:else>
    <!-- 顶栏：成员范围 + 月份（居中，点击展开/折叠月历） + 今天 -->
    <view class="topbar">
      <view class="scope-btn" bindtap="onOpenScope">
        <text class="scope-text">{{scopeLabel}}</text>
        <text class="scope-caret">▾</text>
      </view>
      <view
        class="cal-bar-center"
        bindtap="onToggleCalendar"
        bindtouchstart="onCalTouchStart"
        bindtouchend="onCalTouchEnd"
      >
        <text class="cal-bar-month">{{monthLabel}}</text>
        <text class="cal-bar-caret">{{calendarExpanded ? '⌃' : '⌄'}}</text>
      </view>
      <view class="today-btn" bindtap="onToday">
        <text class="today-text">今天</text>
      </view>
    </view>

    <!-- 折叠态：紧凑周条（当前周）；展开态：完整月历 -->
    <view
      wx:if="{{calendarExpanded}}"
      class="cal-panel"
      bindtouchstart="onCalTouchStart"
      bindtouchend="onCalTouchEnd"
    >
      <view class="cal-header">
        <view class="cal-nav" catchtap="onCalPrevMonth"><text class="cal-nav-text">‹</text></view>
        <text class="cal-title">{{calYear}}年{{calMonth}}月</text>
        <view class="cal-nav" catchtap="onCalNextMonth"><text class="cal-nav-text">›</text></view>
      </view>
      <view class="week-row">
        <view class="week-cell" wx:for="{{weekLabels}}" wx:key="*this">
          <text class="week-text">{{item}}</text>
        </view>
      </view>
      <view class="day-grid">
        <block wx:for="{{calendar}}" wx:for-item="row" wx:for-index="rowIdx" wx:key="rowIdx">
          <view class="day-row">
            <view
              wx:for="{{row}}"
              wx:for-item="cell"
              wx:key="date"
              class="day-cell {{cell.inMonth ? '' : 'day-out'}} {{cell.isToday ? 'day-today' : ''}}"
              data-date="{{cell.date}}"
              catchtap="onCalDayTap"
            >
              <text class="day-num">{{cell.day}}</text>
              <view wx:if="{{cell.hasEvent}}" class="dot"></view>
            </view>
          </view>
        </block>
      </view>
    </view>
    <view wx:else class="cal-week">
      <view
        wx:for="{{weekStrip}}"
        wx:key="date"
        class="cal-week-cell {{item.isToday ? 'cal-week-today' : ''}} {{item.date === visibleDate ? 'cal-week-sel' : ''}}"
        data-date="{{item.date}}"
        bindtap="onWeekDayTap"
      >
        <text class="cal-week-day">{{item.day}}</text>
      </view>
    </view>

    <!-- 首次加载骨架屏 -->
    <view wx:if="{{!loaded}}" class="skeleton">
      <view class="skel-day" wx:for="{{[0, 1, 2]}}" wx:key="*this">
        <view class="skel-bar skel-title"></view>
        <view class="skel-card"></view>
        <view class="skel-card"></view>
      </view>
    </view>

    <!-- 时间线 -->
    <scroll-view
      wx:else
      id="scroller"
      class="timeline"
      scroll-y
      scroll-top="{{scrollTop}}"
      scroll-into-view="{{scrollIntoView}}"
      upper-threshold="{{edgeThreshold}}"
      lower-threshold="{{edgeThreshold}}"
      bindscroll="onScroll"
      bindscrolltoupper="onNearTop"
      bindscrolltolower="onNearBottom"
    >
      <view id="timeline-inner" class="timeline-inner">

        <!-- 顶部：向前加载状态 -->
        <view class="edge-row">
          <block wx:if="{{loadingBack}}">
            <view class="edge-spinner"></view>
            <text class="edge-text">正在加载更早的日程…</text>
          </block>
          <text wx:elif="{{reachedEarliest}}" class="edge-text">已加载到最早</text>
          <text wx:elif="{{backError}}" class="edge-text edge-retry" bindtap="onTapLoadOlder">加载失败，点击重试</text>
          <text wx:else class="edge-text edge-action" bindtap="onTapLoadOlder">点击加载更早的日程</text>
        </view>

        <!-- 当前范围没有日程 -->
        <view wx:if="{{isEmpty}}" class="range-empty">
          <image class="empty-image" src="/assets/images/empty-family.png" mode="aspectFit" />
          <text class="empty-title">这个时间范围内还没有日程</text>
          <view class="empty-actions empty-actions-row">
            <button class="btn-primary btn-sm" bindtap="onCreate">新建日程</button>
          </view>
        </view>

        <!-- 日期分组 -->
        <block wx:else>
          <view
            wx:for="{{sections}}"
            wx:key="date"
            id="{{item.id}}"
            class="day-section"
            data-date="{{item.date}}"
          >
            <view class="day-header {{item.isToday ? 'day-header-today' : ''}}">
              <text class="day-header-date">{{item.dateLabel}}</text>
              <text class="day-header-week">{{item.weekLabel}}</text>
              <text wx:if="{{item.isToday}}" class="day-header-tag">今天</text>
            </view>

            <view wx:if="{{item.items.length === 0}}" class="day-empty">
              <text class="day-empty-text">没有日程</text>
            </view>

            <view
              wx:for="{{item.items}}"
              wx:for-item="ev"
              wx:key="id"
              class="event-card {{ev.isEnded ? 'event-ended' : ''}}"
              data-id="{{ev.id}}"
              bindtap="onEventTap"
            >
              <view class="event-accent {{ev.isAllDay ? 'event-accent-allday' : ''}}"></view>
              <view class="event-body">
                <view class="event-time-row">
                  <text wx:if="{{ev.isAllDay}}" class="event-allday-tag">全天</text>
                  <text wx:else class="event-time">{{ev.timeText}}</text>
                </view>
                <text class="event-title">{{ev.summary}}</text>
                <text wx:if="{{ev.metaText}}" class="event-meta">{{ev.metaText}}</text>
              </view>
            </view>
          </view>
        </block>

        <!-- 底部：向后加载状态 -->
        <view class="edge-row">
          <block wx:if="{{loadingFwd}}">
            <view class="edge-spinner"></view>
            <text class="edge-text">正在加载更多日程…</text>
          </block>
          <text wx:elif="{{reachedLatest}}" class="edge-text">已加载到最晚</text>
          <text wx:elif="{{fwdError}}" class="edge-text edge-retry" bindtap="onTapLoadNewer">加载失败，点击重试</text>
          <text wx:else class="edge-text edge-action" bindtap="onTapLoadNewer">点击加载更多日程</text>
        </view>

        <view class="timeline-bottom-space"></view>
      </view>
    </scroll-view>

    <!-- 成员范围选择弹层 -->
    <view wx:if="{{showScopeSheet}}" class="sheet-mask" bindtap="onCloseScope" catchtouchmove="noop">
      <view class="sheet" catchtap="noop">
        <view class="sheet-header">
          <text class="sheet-title">选择日历</text>
        </view>
        <view
          wx:for="{{scopeOptions}}"
          wx:key="key"
          class="sheet-option {{scope === item.key ? 'sheet-option-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSelectScope"
        >
          <view wx:if="{{item.showAvatar}}" class="sheet-avatar-wrap">
            <image class="sheet-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
          </view>
          <view wx:else class="sheet-avatar-wrap sheet-avatar-all">
            <text class="sheet-avatar-all-text">家</text>
          </view>
          <text class="sheet-option-label">{{item.label}}</text>
          <text wx:if="{{scope === item.key}}" class="sheet-check">✓</text>
        </view>
        <view class="sheet-cancel" bindtap="onCloseScope">
          <text class="sheet-cancel-text">取消</text>
        </view>
      </view>
    </view>
  </block>
</view>
