/* 启动页样式 — 品牌绿背景 */
.launch-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 48rpx;
  box-sizing: border-box;
  background-color: #43A047;
}

.logo-wrapper {
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 48rpx;
}

.logo {
  width: 100%;
  height: 100%;
}

.app-name {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 48rpx;
}

.status-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.error-text {
  font-size: 28rpx;
  color: #ffcccc;
  margin-bottom: 32rpx;
  text-align: center;
}

.retry-btn {
  width: 320rpx;
}
