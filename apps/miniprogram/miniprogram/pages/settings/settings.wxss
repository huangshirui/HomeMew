/* 设置页样式 */

.section {
  padding: 0 8rpx;
}

.section-header {
  padding: 20rpx 16rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* 模式选择 */
.mode-row {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 16rpx;
}

.mode-item {
  flex: 1;
  padding: 24rpx 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  background-color: #ffffff;
}

.mode-active {
  border-color: var(--color-primary);
  background-color: var(--color-primary-tint);
}

.mode-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.mode-desc {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-hint);
}

/* 指定时区入口（包裹 timezone-picker 组件） */
.tz-field {
  padding: 20rpx 16rpx 0;
  border-top: 2rpx solid var(--color-divider);
}

.tz-field-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-hint);
  margin-bottom: 12rpx;
}

.tz-field-control {
  display: block;
  margin: 0 -16rpx;
}

/* 当前生效提示 */
.tz-current {
  padding: 16rpx 16rpx 24rpx;
  border-top: 2rpx solid var(--color-divider);
}

.tz-current-text {
  font-size: 24rpx;
  color: var(--color-text-hint);
}
