.health-page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom));color:#292524}
.health-people{margin:8rpx 0 18rpx;white-space:nowrap}
.health-people-row{display:inline-flex;gap:16rpx;align-items:flex-start;padding:6rpx 8rpx 10rpx}
.health-person{display:flex;flex-direction:column;align-items:center;gap:8rpx;min-width:116rpx;max-width:146rpx;padding:14rpx 12rpx;border-radius:22rpx;color:#78716c;font-size:24rpx;box-sizing:border-box}
.health-person.selected{background:#e8f5ec;color:#166534;font-weight:600}
.health-avatar{border-radius:50%;width:84rpx;height:84rpx;display:flex;align-items:center;justify-content:center}
.selected-avatar{box-shadow:0 0 0 4rpx #e8f5ec,0 0 0 7rpx #43a047}
.health-person-name{max-width:120rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.health-tabs{display:flex;gap:22rpx;border-bottom:2rpx solid #e7e5e4;margin-bottom:22rpx}
.health-tab{flex:1;text-align:center;padding:18rpx 6rpx;border-bottom:4rpx solid transparent;font-size:28rpx;color:#78716c}
.health-tab.selected{border-color:#358539;color:#166534;font-weight:600}
.health-panel{background:#fff;border:2rpx solid #e9ece8;border-radius:24rpx;padding:24rpx;margin-bottom:20rpx;box-sizing:border-box}
.health-heading{font-size:30rpx;font-weight:600;display:block}
.health-heading-row{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-bottom:20rpx}
.health-heading-row .health-heading{flex-shrink:0}
.health-muted{font-size:26rpx;color:#57534e;display:block}
.health-caption{font-size:22rpx;color:#78716c;display:block;line-height:1.45}
.health-link{color:#047857;font-size:25rpx;font-weight:500}
.health-empty{padding:54rpx 20rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18rpx;text-align:center;color:#78716c;font-size:27rpx}
.health-empty.small{padding:28rpx 12rpx;border-radius:16rpx;background:#fafaf9;font-size:25rpx;margin-top:10rpx}
.health-growth-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx}
.health-growth{padding:20rpx 14rpx;min-width:0}
.health-growth-value{font-size:38rpx;font-weight:650;margin:10rpx 0;font-variant-numeric:tabular-nums;line-height:1.2;word-break:break-word}
.health-unit{font-size:21rpx;color:#78716c;font-weight:400}
.health-shortcuts{display:flex;gap:14rpx;margin-top:20rpx}
.health-shortcut{flex:1;min-width:0;background:#fafaf9;border-radius:20rpx;padding:20rpx 8rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;font-size:25rpx;font-weight:500}
.health-shortcut.primary{background:#e8f5ec;color:#166534}
.health-shortcut-icon,.health-entry-icon{font-size:38rpx}
.health-entry-grid{display:grid;grid-template-columns:1fr;gap:0}
.health-entry{display:flex;gap:16rpx;align-items:center}
.health-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:22rpx 0;border-bottom:2rpx solid #f1f0ed}
.health-row:last-child{border-bottom:0}
.health-row-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:5rpx}
.health-row-title{font-weight:550;font-size:28rpx;color:#292524;word-break:break-word}
.health-record-value{font-size:29rpx;font-weight:600;max-width:48%;word-break:break-word;font-variant-numeric:tabular-nums}
.health-truncate{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.health-chevron{font-size:42rpx;color:#a8a29e;line-height:1;flex-shrink:0}
.health-actions{display:flex;align-items:center;gap:10rpx;flex-wrap:wrap;justify-content:flex-end}
.health-flex{flex:1;min-width:0}
.health-primary,.health-secondary,.health-danger,.health-more{min-height:64rpx;box-sizing:border-box;border-radius:16rpx;padding:12rpx 20rpx;font-size:25rpx;line-height:1.45;margin:0;display:flex;align-items:center;justify-content:center;white-space:normal}
.health-primary{background:#358539;color:#fff;font-weight:550}
.health-secondary{background:#fff;color:#44403c;border:2rpx solid #e7e5e4}
.health-danger{background:#fff;color:#b91c1c;border:2rpx solid #fecaca}
.health-more{width:100%;background:#fafaf9;color:#047857;margin-top:16rpx}
.health-primary::after,.health-secondary::after,.health-danger::after,.health-more::after{border:0}
.health-primary[disabled],.health-secondary[disabled],.health-danger[disabled],.health-more[disabled]{opacity:.55}
.health-icon-button{width:60rpx;height:60rpx;display:flex;align-items:center;justify-content:center;border-radius:14rpx;color:#78716c;font-size:38rpx;flex-shrink:0}
.health-metric-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx}
.health-metric{padding:18rpx;border:2rpx solid #e7e5e4;border-radius:18rpx;display:flex;flex-direction:column;gap:4rpx;min-width:0;word-break:break-word;font-weight:500}
.health-metric.selected{border-color:#43a047;background:#ecf8ef;color:#166534}
.health-latest{font-size:52rpx;font-weight:650;line-height:1.25;word-break:break-word}
.health-range{display:flex;gap:6rpx;padding:6rpx;border-radius:18rpx;background:#f5f5f4;margin:18rpx 0}
.health-range-item{flex:1;text-align:center;font-size:24rpx;padding:13rpx 4rpx;color:#78716c;border-radius:12rpx}
.health-range-item.selected{background:#fff;color:#166534;font-weight:600;box-shadow:0 2rpx 8rpx #00000008}
.health-chart{border-radius:18rpx;background:#fafaf9;border:2rpx solid #f5f5f4;padding:12rpx;margin-bottom:20rpx}
.health-chart-placeholder{height:300rpx}
.health-list-title{margin-top:24rpx;margin-bottom:0;border-bottom:2rpx solid #f1f0ed;padding-bottom:12rpx}
.health-month{display:block;font-weight:600;font-size:25rpx;color:#78716c;margin:22rpx 0 10rpx}
.health-timeline-row{display:flex;align-items:flex-start;gap:14rpx;margin-left:20rpx;border-left:2rpx solid #e7e5e4;padding:16rpx 0 20rpx 28rpx;position:relative}
.health-timeline-dot{position:absolute;left:-20rpx;top:16rpx;width:38rpx;height:38rpx;border-radius:50%;background:#e8f5ec;color:#358539;text-align:center;line-height:38rpx;font-size:22rpx;box-shadow:0 0 0 6rpx white}
.health-description{font-size:25rpx;color:#57534e;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;word-break:break-word}
.health-filters{display:flex;gap:10rpx;flex-wrap:wrap;margin-bottom:10rpx}
.health-chip{border-radius:40rpx;background:#f5f5f4;color:#57534e;padding:10rpx 20rpx;font-size:23rpx}
.health-chip.selected{background:#e8f5ec;color:#166534;font-weight:600}
.health-file-icon{width:76rpx;height:76rpx;border-radius:18rpx;background:#e8f5ec;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:38rpx}
.health-mask{position:fixed;inset:0;z-index:90;background:rgba(28,25,23,.4);display:flex;align-items:flex-end;justify-content:center}
.health-sheet{width:100%;max-width:760rpx;max-height:90vh;background:#fff;border-radius:30rpx 30rpx 0 0;padding:0 26rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box;display:flex;flex-direction:column}
.health-sheet-head{display:flex;align-items:center;justify-content:space-between;gap:14rpx;min-height:94rpx;border-bottom:2rpx solid #f1f0ed;flex-shrink:0}
.health-sheet-title{font-size:34rpx;font-weight:650;flex:1;min-width:0;overflow-wrap:anywhere}
.health-sheet-body{max-height:calc(78vh - env(safe-area-inset-bottom));padding:12rpx 0;box-sizing:border-box}
.health-field{display:flex;flex-direction:column;gap:10rpx;margin:20rpx 0;font-size:26rpx;color:#44403c}
.health-field input,.health-field textarea,.health-control{border:2rpx solid #e7e5e4;background:#fafaf9;border-radius:16rpx;min-height:76rpx;box-sizing:border-box;padding:17rpx 18rpx;width:100%;font-size:28rpx;color:#292524}
.health-field input{height:76rpx}
.health-field textarea{min-height:110rpx}
.health-share{display:flex;align-items:flex-start;gap:8rpx;margin:22rpx 0;font-size:25rpx;color:#44403c}
.health-detail-text{display:block;white-space:pre-wrap;word-break:break-word;margin:22rpx 0;font-size:28rpx}
.full{width:100%;margin:18rpx 0}
.save{margin:26rpx 0}
.detail-actions{margin:24rpx 0}
.health-error{display:block;color:#b91c1c;font-size:25rpx;margin:18rpx 0;word-break:break-word}
.health-chooser{border-radius:16rpx;background:#fafaf9;padding:0 16rpx;max-height:320rpx;overflow-y:auto}
