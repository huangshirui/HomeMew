<view class="container football-manage"><nav-bar title="球队与球员" showBack="true"/>
  <view class="manage-heading"><view class="manage-tabs"><button class="{{tab==='teams'?'active':''}}" data-tab="teams" bindtap="onTab"><lucide-icon name="shield" size="16" color="{{tab==='teams'?'#fff':'#57534e'}}"/><text>球队</text></button><button class="{{tab==='players'?'active':''}}" data-tab="players" bindtap="onTab"><lucide-icon name="users" size="16" color="{{tab==='players'?'#fff':'#57534e'}}"/><text>球员</text></button></view><button class="football-icon-button manage-create" bindtap="onCreate" disabled="{{busy}}" aria-label="{{tab==='teams'?'新建球队':'新建球员'}}"><lucide-icon name="plus" size="21" color="#fff"/></button></view>
  <view class="manage-toolbar"><lucide-icon name="search" size="18" color="#a8a29e"/><input value="{{search}}" placeholder="{{tab==='teams'?'搜索球队名称，至少两个字':'搜索球员姓名'}}" bindinput="onInput" bindconfirm="onSearch" confirm-type="search"/><button wx:if="{{search}}" class="football-icon-button" bindtap="onClearSearch" aria-label="清除搜索"><lucide-icon name="x" size="17" color="#78716c"/></button></view>
  <view wx:if="{{tab==='players'}}" class="manage-hint">这里管理其他球员；家庭成员的信息请到家庭管理中修改。</view><view wx:elif="{{!appliedSearch}}" class="manage-hint">常用球队 · 来自近期比赛与本机最近选择</view>
  <view wx:if="{{error && !loadedOnce}}" class="load-error-state"><text class="load-error-text">{{error}}</text><button class="btn-outline btn-sm" bindtap="onSearch">重试</button></view><view wx:if="{{loading}}" class="loading-state">加载中…</view>
  <view wx:else class="card manage-list"><block wx:if="{{tab==='teams'}}"><view wx:for="{{teams}}" wx:key="id" class="manage-row"><football-record-icon family-id="{{familyId}}" record-id="{{item.id}}" icon="{{item.presentation.icon}}"/><view class="manage-name" data-id="{{item.id}}" bindtap="onTeam"><text>{{item.name}}</text><text class="manage-hint">{{item.memberPersonIds.length||0}} 人</text></view><button class="football-icon-button" data-id="{{item.id}}" bindtap="onTeam" aria-label="编辑{{item.name}}及球队球员"><lucide-icon name="pencil" size="17" color="#57534e"/></button><button class="football-icon-button" data-id="{{item.id}}" bindtap="onDeleteTeam" disabled="{{busy}}" aria-label="删除球队{{item.name}}"><lucide-icon name="trash-2" size="17" color="#a8a29e"/></button></view><view wx:if="{{!teams.length}}" class="manage-empty">{{appliedSearch?'没有找到匹配的球队':'还没有常用球队，可以搜索或新建。'}}</view></block>
  <block wx:else><view wx:for="{{players}}" wx:key="id" class="manage-row"><text class="manage-name" data-id="{{item.id}}" bindtap="onPlayer">{{item.displayName}}</text><button class="football-icon-button" data-id="{{item.id}}" bindtap="onPlayer" disabled="{{busy}}" aria-label="编辑球员{{item.displayName}}"><lucide-icon name="pencil" size="17" color="#57534e"/></button><button class="football-icon-button" data-id="{{item.id}}" bindtap="onDeletePlayer" disabled="{{busy}}" aria-label="删除球员{{item.displayName}}"><lucide-icon name="trash-2" size="17" color="#a8a29e"/></button></view><view wx:if="{{!players.length}}" class="manage-empty">没有找到可管理的非家庭球员</view></block></view>
  <view wx:if="{{nextCursor}}" class="manage-more" bindtap="onMore">{{loadingMore?'加载中…':'加载更多'}}</view><button class="manage-activities" bindtap="onActivities"><lucide-icon name="calendar-days" size="17" color="#78716c"/><text>赛事管理 → 活动</text></button>
</view>
