.stats-head{font-weight:600;font-size:30rpx;margin-bottom:18rpx}.stats-person{padding:15rpx 20rpx;background:#f2f8f3;border-radius:20rpx;font-size:25rpx;margin-bottom:15rpx;color:#65866d}.stats-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15rpx}.metric{padding:20rpx;background:#f4f9f5;border-radius:20rpx}.metric-label{display:block;color:#8b9b8d;font-size:23rpx}.metric-value{font-weight:700;color:#334e39;font-size:40rpx;display:block;margin-top:6rpx}.metric-unit{font-weight:400;font-size:23rpx}.stats-footnote{font-size:22rpx;color:#9ca99e;line-height:1.5;margin-top:23rpx}.trend-tabs{margin:5rpx 0 20rpx}.trend-row{display:flex;gap:12rpx}.trend-tab{flex:none;background:#f0f6f1;color:#7c9180;border-radius:15rpx;font-size:24rpx;padding:13rpx 20rpx}.trend-tab.active{background:var(--color-primary);color:white}.trend-legend{font-size:22rpx;color:#859d8a;display:flex;gap:20rpx;margin-bottom:25rpx}.trend-legend text:first-child{color:#408857}.trend-legend text:nth-child(2){color:#a78238}.trend-chart{white-space:nowrap}.trend-columns{display:flex;gap:14rpx;align-items:flex-end;min-height:225rpx}.trend-column{width:132rpx;display:flex;align-items:center;flex-direction:column;flex:none}.trend-top{font-size:18rpx;color:#788a79}.bars{height:155rpx;width:105rpx;display:flex;gap:9rpx;justify-content:center;align-items:flex-end;border-bottom:1rpx solid #d4e2d7}.bar-a{width:37rpx;background:#52a56c;border-radius:7rpx 7rpx 0 0}.bar-b{width:37rpx;background:#c9a467;border-radius:7rpx 7rpx 0 0}.trend-date{font-size:21rpx;color:#718373;margin-top:6rpx}.trend-count{font-size:18rpx;color:#adb9ad;margin-top:2rpx}
.stats-scope{display:flex;align-items:center;justify-content:space-between;gap:16rpx;color:#7c9180;font-size:24rpx;margin-bottom:24rpx}.stats-scope text:last-child{color:var(--color-primary);padding:12rpx 0}
