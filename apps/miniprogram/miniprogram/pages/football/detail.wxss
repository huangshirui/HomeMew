.football-detail{padding-top:0}.match-summary{text-align:center}.match-date{font-size:23rpx;color:#8a998e}.competition-name{font-size:26rpx;color:#699274;margin-top:8rpx}.match-score{display:flex;justify-content:space-between;align-items:center;gap:9rpx;margin:27rpx 0}.match-score text{flex:1;font-size:27rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.match-score .match-result{font-size:36rpx;font-weight:700;color:#458c4e;flex:0 0 auto}.match-edit{color:var(--color-primary);font-size:24rpx;padding-top:15rpx}.match-notes{font-size:25rpx;color:#809182;margin-top:15rpx}.football-player{padding:17rpx;background:#f3f8f4;border-radius:14rpx;color:#678673;font-size:27rpx;margin-top:20rpx}.quick-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12rpx;margin:24rpx 0}.quick-item{background:#f3f8f4;border-radius:19rpx;padding:18rpx 3rpx 16rpx;text-align:center;color:#52795d;font-size:21rpx;display:flex;gap:5rpx;flex-direction:column}.quick-symbol{font-size:35rpx}.more-performance{display:flex;justify-content:space-around;color:var(--color-primary);font-size:24rpx;padding:14rpx}.performance-row{display:flex;gap:15rpx;padding:18rpx 0;border-bottom:1rpx solid #e9f0ea;align-items:center}.performance-row view{flex:1;min-width:0}.performance-type{font-weight:600;font-size:26rpx}.performance-person{margin-left:15rpx;color:#89968b;font-size:23rpx}.performance-detail{font-size:23rpx;color:#8f9d91;max-width:35%}.performance-caret{color:#adb7ae}.performance-empty{color:#8c998e;font-size:24rpx;text-align:center;padding:30rpx}.football-mask{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.4);display:flex;align-items:flex-end}.football-sheet{width:100%;background:#fff;border-radius:29rpx 29rpx 0 0;padding:25rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));max-height:82vh;box-sizing:border-box}.sheet-grip{height:7rpx;width:65rpx;border-radius:20rpx;background:#d3ded5;margin:0 auto 19rpx}.sheet-header{display:flex;justify-content:space-between;font-weight:600;font-size:29rpx}.sheet-close{font-size:28rpx;color:#8a988d}.sheet-body{max-height:52vh;margin:15rpx 0}.form-row{display:flex;justify-content:space-between;align-items:center;border-bottom:1rpx solid #edf1ed;min-height:92rpx;font-size:26rpx}.form-row text{color:#829083;font-size:25rpx}.form-row input{max-width:220rpx;text-align:right}.form-notes{display:block;padding:19rpx 0}.form-notes textarea{margin-top:12rpx;min-height:80rpx;width:100%;font-size:25rpx}.football-sheet .btn-primary{height:80rpx;line-height:80rpx;font-size:28rpx}.form-delete{text-align:center;color:#c36363;padding:20rpx;font-size:25rpx}