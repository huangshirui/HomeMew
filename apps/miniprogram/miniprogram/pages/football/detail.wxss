@import "./shared.wxss";
.match-summary-header{display:flex;align-items:center;justify-content:space-between}.match-date{display:flex;align-items:center;gap:14rpx;font-size:24rpx;color:#78716c}.competition-name{display:inline-block;padding:5rpx 12rpx;border-radius:10rpx;background:#f5f5f4;font-size:23rpx;color:#78716c}.match-score{display:flex;align-items:center;gap:16rpx;margin:24rpx 0}.match-team{flex:1;min-width:0;display:flex;align-items:center;justify-content:center;gap:10rpx}.match-team text{min-width:0;font-size:28rpx;color:#44403c;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.match-result{flex:none;font-size:38rpx;font-weight:600;color:#292524;font-variant-numeric:tabular-nums}.match-notes{font-size:25rpx;line-height:1.7;color:#78716c;margin:12rpx 0}.section-title{font-size:30rpx;font-weight:600;color:#292524}.football-player{display:flex;align-items:center;gap:16rpx;margin-top:20rpx;border:1rpx solid #e7e5e4;background:#fff;padding:20rpx;border-radius:20rpx;font-size:27rpx;color:#78716c}.football-player-name{flex:1;min-width:0;color:#44403c;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.quick-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin:24rpx 0}.quick-item{display:flex;align-items:center;gap:14rpx;min-width:0;min-height:110rpx;box-sizing:border-box;padding:20rpx 16rpx;border:1rpx solid #e7e5e4;border-radius:24rpx;background:#fff;font-size:26rpx;color:#44403c}.quick-symbol{font-size:38rpx;flex:none}.quick-count{margin-left:auto;font-size:23rpx;color:#a8a29e}.more-performance{display:flex;flex-wrap:wrap;gap:14rpx;padding-top:22rpx;border-top:1rpx solid #f5f5f4}.more-performance button{display:flex;align-items:center;gap:12rpx;margin:0;padding:20rpx;border:1rpx solid #e7e5e4;border-radius:20rpx;background:#fff;line-height:1.4;font-size:26rpx;color:#57534e}.more-performance button::after{border:0}.performance-row{display:flex;align-items:center;gap:16rpx;border-bottom:1rpx solid #f5f5f4;padding:14rpx 0}.performance-main{flex:1;min-width:0}.performance-type{font-size:27rpx;font-weight:500;color:#44403c}.performance-person{font-size:23rpx;color:#a8a29e;margin-left:16rpx}.performance-detail{display:block;margin-top:8rpx;font-size:24rpx;line-height:1.6;color:#78716c;word-break:break-word}.performance-empty{font-size:25rpx;color:#78716c;text-align:center;padding:40rpx 10rpx;line-height:1.8}.football-mask{position:fixed;inset:0;z-index:100;background:#0006;display:flex;align-items:flex-end}.football-sheet{display:flex;flex-direction:column;width:100%;max-height:82vh;box-sizing:border-box;background:#fff;border-radius:30rpx 30rpx 0 0;padding:20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom))}.sheet-grip{height:7rpx;width:64rpx;border-radius:8rpx;background:#d6d3d1;margin:0 auto 8rpx;flex:none}.sheet-header{display:flex;align-items:center;justify-content:space-between;font-size:30rpx;font-weight:600;flex:none}.sheet-body{min-height:0;max-height:48vh;margin:12rpx 0}.form-row{display:flex;align-items:center;gap:12rpx;min-height:94rpx;border-bottom:1rpx solid #f5f5f4;font-size:26rpx;color:#44403c}.form-row text{margin-left:auto;color:#78716c;text-align:right}.form-row input{flex:1;min-width:0;text-align:right;font-size:26rpx}.form-notes{display:block;padding:20rpx 0}.form-notes text{color:#44403c}.form-notes textarea{width:100%;height:140rpx;font-size:26rpx;margin-top:14rpx}.sheet-footer{display:flex;justify-content:flex-end;gap:16rpx;padding-top:18rpx;flex:none}.sheet-footer button{margin:0;min-height:82rpx;line-height:1.4;font-size:27rpx}.sheet-footer .btn-primary{width:auto;padding:20rpx 36rpx;border-radius:20rpx}.sheet-footer .football-secondary{width:auto}.form-delete{margin:0;padding:20rpx}

.quick-item{margin:0;line-height:1.4;text-align:left}.quick-item::after{border:0}.quick-item[disabled]{opacity:.5}.quick-item text:nth-child(2){min-width:0}

.sheet-body{height:48vh}
