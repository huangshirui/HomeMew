.football-page,.football-detail,.football-editor,.football-manage{--color-primary:#047857;--color-border:#e7e5e4;--color-text:#292524;background:#f6f8f5;padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.football-page .card,.football-detail .card,.football-editor .card,.football-manage .card{border:1rpx solid #e7e5e4;border-radius:26rpx;box-shadow:0 2rpx 5rpx #00000006}.football-icon-button{display:flex;align-items:center;justify-content:center;flex:none;width:88rpx;height:88rpx;margin:0;padding:0;background:transparent;border-radius:20rpx;line-height:1}.football-icon-button::after{border:0}.football-help{font-size:23rpx;color:#78716c;line-height:1.7;padding:12rpx 0}.football-secondary{border:1rpx solid #e7e5e4;background:#fff;color:#57534e;border-radius:20rpx;font-size:27rpx;line-height:1.4;padding:20rpx 28rpx}.football-delete,.form-delete{display:flex;gap:12rpx;align-items:center;justify-content:center;background:transparent;color:#b91c1c;font-size:25rpx;padding:24rpx}.football-delete::after,.form-delete::after{border:0}.thin-error{font-size:25rpx;color:#b91c1c;background:#fef2f2;border-radius:16rpx;padding:18rpx;margin:12rpx 0}

.football-icon-button{min-width:44px;min-height:44px}
