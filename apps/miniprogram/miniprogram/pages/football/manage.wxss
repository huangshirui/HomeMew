@import "./shared.wxss";
.manage-heading,.manage-tabs,.manage-tabs button,.manage-toolbar,.manage-row,.manage-activities{display:flex;align-items:center}.manage-heading{justify-content:space-between;gap:16rpx;margin-bottom:24rpx}.manage-tabs{gap:12rpx}.manage-tabs button{margin:0;display:flex;gap:12rpx;align-items:center;background:#fff;border:1rpx solid #e7e5e4;border-radius:22rpx;padding:18rpx 24rpx;font-size:27rpx;line-height:1.4;color:#57534e}.manage-tabs .active{background:#047857;border-color:#047857;color:#fff}.manage-heading .manage-create{background:#059669;border-radius:24rpx}.manage-toolbar{gap:14rpx;background:#fff;border:1rpx solid #e7e5e4;border-radius:22rpx;padding-left:20rpx;min-height:88rpx;margin-bottom:20rpx}.manage-toolbar input{flex:1;min-width:0;font-size:26rpx;padding:20rpx 10rpx 20rpx 0}.manage-hint{font-size:23rpx;color:#78716c;line-height:1.7;margin-bottom:18rpx}.manage-list{padding:0 24rpx}.manage-row{gap:12rpx;min-height:110rpx;border-bottom:1rpx solid #f5f5f4}.manage-row:last-child{border:0}.manage-name{flex:1;min-width:0;color:#44403c;font-size:27rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.manage-name text{display:block}.manage-name .manage-hint{margin:4rpx 0 0}.manage-row .football-icon-button{width:76rpx}.manage-empty{padding:48rpx 12rpx;text-align:center;font-size:25rpx;color:#78716c}.manage-more{text-align:center;font-size:26rpx;color:#047857;padding:24rpx}.manage-activities{justify-content:center;gap:12rpx;margin:24rpx auto;background:transparent;color:#78716c;font-size:26rpx}button::after{border:0}
