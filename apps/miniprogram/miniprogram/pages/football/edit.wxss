.football-editor{padding-top:0}.football-field{display:flex;justify-content:space-between;align-items:center;gap:16rpx;padding:22rpx 0;border-bottom:1rpx solid #ecf1ed;font-size:27rpx}.football-field text{font-size:26rpx;color:#778a79;text-align:right}.football-field input{max-width:220rpx;text-align:right;font-size:26rpx;min-width:0;flex:1}.football-notes{width:100%;min-height:120rpx;padding:20rpx 0;box-sizing:border-box;font-size:26rpx}.team-name-row{display:flex;align-items:center;gap:20rpx}.football-input{font-size:30rpx;min-width:0;flex:1;padding:15rpx 0}.football-section-title{font-size:30rpx;font-weight:600;display:flex;justify-content:space-between;margin-bottom:20rpx}.football-section-title text{font-size:23rpx;color:#a0ada1;font-weight:400}.football-find{display:flex;align-items:center;gap:15rpx;padding-bottom:20rpx}.football-find input{flex:1;min-width:0;background:#f3f7f4;border-radius:18rpx;padding:14rpx;font-size:25rpx}.football-find text{font-size:23rpx;color:var(--color-primary)}.football-people{display:flex;gap:13rpx;flex-wrap:wrap}.football-person{padding:12rpx 17rpx;border-radius:22rpx;background:#f3f7f4;color:#788d7a;font-size:24rpx}.football-person.selected{background:#e6f6e9;border:1rpx solid #51a259;color:#368f48}.more-people{padding:20rpx;text-align:center;color:var(--color-primary)}.football-delete{padding:24rpx;color:#ca5b5b;text-align:center;margin-top:18rpx}