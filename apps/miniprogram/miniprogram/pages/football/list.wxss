@import "./shared.wxss";
.football-section{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:30rpx;font-weight:600;padding:2rpx 0 14rpx;color:#292524}.football-filter{padding:24rpx}.football-search-row{display:flex;align-items:center;gap:12rpx}.football-search-row input{flex:1;min-width:0;border:1rpx solid #e7e5e4;border-radius:20rpx;padding:20rpx;font-size:27rpx}.football-filter-row{display:flex;gap:16rpx;margin:20rpx 0}.football-filter-row picker{flex:1;min-width:0}.football-filter-row picker>view{display:flex;align-items:center;justify-content:space-between;gap:12rpx;border:1rpx solid #e7e5e4;border-radius:20rpx;padding:20rpx 16rpx;font-size:26rpx;color:#57534e}.football-reference-grid{display:grid;gap:20rpx}.football-filter-controls{display:flex;justify-content:space-between;align-items:center;margin-top:20rpx;font-size:25rpx;color:#78716c}.football-filter-controls .btn-primary{margin:0;width:auto;border-radius:18rpx;font-size:26rpx;padding:0 26rpx}.football-list{padding:0 24rpx}.football-row{padding:12rpx 0 24rpx;border-bottom:1rpx solid #f5f5f4}.football-row:last-child{border:0}.football-date{display:flex;align-items:center;gap:12rpx;font-size:23rpx;color:#57534e;white-space:nowrap}.football-row-actions{margin-left:auto;display:flex;gap:4rpx}.football-row-actions .football-icon-button{height:70rpx;width:76rpx}.football-score{display:flex;align-items:center;gap:20rpx}.team-side{flex:1;min-width:0;display:flex;align-items:center;gap:10rpx}.team-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:27rpx;color:#44403c}.score{flex:none;font-size:32rpx;font-weight:600;color:#292524;font-variant-numeric:tabular-nums}.football-competition{display:inline-block;margin-top:16rpx;font-size:22rpx;background:#f5f5f4;padding:5rpx 12rpx;border-radius:10rpx;color:#78716c;max-width:100%;box-sizing:border-box;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.football-empty{padding:60rpx 16rpx;text-align:center;color:#78716c;font-size:26rpx;line-height:1.8}.football-more{text-align:center;color:#047857;font-size:26rpx;padding:24rpx}

.football-row-record{margin:0;min-height:44px;display:flex;align-items:center;justify-content:center;background:#fafaf9;border:1rpx solid #e7e5e4;border-radius:18rpx;padding:0 22rpx;font-size:25rpx;color:#57534e;line-height:1.4}.football-row-record::after{border:0}
