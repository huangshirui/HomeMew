.football-page{padding-top:0}.football-top{padding:12rpx 0 23rpx}.football-tabs{display:flex;gap:22rpx;margin-bottom:20rpx}.football-tabs view{font-size:27rpx;color:#768478;padding:11rpx 14rpx}.football-tabs .active{color:var(--color-primary);font-weight:600;border-bottom:4rpx solid var(--color-primary)}.football-actions{display:flex;justify-content:flex-end;gap:18rpx}.football-new{background:var(--color-primary);color:white;padding:12rpx 20rpx;border-radius:21rpx;font-size:25rpx}.football-tool{background:white;color:#65816b;padding:12rpx 22rpx;border-radius:21rpx;font-size:25rpx}.football-filter{padding:20rpx}.football-filter input{padding:16rpx;border-bottom:1rpx solid var(--color-border);font-size:26rpx}.football-filter-row{display:flex;gap:18rpx;align-items:center;justify-content:space-between}.football-filter-row input{width:45%}.football-person{padding:20rpx 5rpx;font-size:25rpx}.football-filter-controls{display:flex;justify-content:space-between;align-items:center;color:#728577}.football-filter-controls button{width:auto;margin:0}.football-list{padding:0 22rpx}.football-row{padding:25rpx 5rpx;border-bottom:1rpx solid #ecf1ed}.football-row:last-child{border:none}.football-date{font-size:22rpx;color:#93a094;margin-bottom:9rpx}.football-score{display:flex;justify-content:space-between;align-items:center;gap:8rpx}.team-name{font-size:26rpx;flex:1;min-width:0;text-align:center;overflow:hidden;text-overflow:ellipsis}.score{font-size:33rpx;font-weight:600;color:#3b7045;flex-shrink:0}.football-competition{font-size:22rpx;color:#8c998d;text-align:center;margin-top:6rpx}.football-empty{padding:60rpx 10rpx;text-align:center;color:#99a69b;font-size:26rpx}.team-row{display:flex;align-items:center;gap:20rpx}.team-emoji{font-size:38rpx}.team-row .team-name{text-align:left}.team-arrow{color:#a8b2a8}.football-more{text-align:center;color:var(--color-primary);padding:26rpx}.football-hint{color:#a2aea4;font-size:21rpx;text-align:center;padding:30rpx 0}