<view class="container football-detail">
  <nav-bar title="比赛详情" showBack="true" />
  <view wx:if="{{loading}}" class="loading-state">正在加载比赛…</view>
  <view wx:elif="{{error&&!match}}" class="load-error-state"><text class="load-error-text">{{error}}</text><button class="btn-outline btn-sm" bindtap="onRetry">重试</button></view>
  <block wx:else>
    <view wx:if="{{error}}" class="thin-error">{{error}}</view>
    <view class="card match-summary">
      <view class="match-summary-header"><view class="match-date"><text>{{match.matchDate}}</text><lucide-icon name="{{match.matchType==='friendly'?'handshake':'trophy'}}" size="16" color="{{match.matchType==='friendly'?'#0284c7':'#d97706'}}"/></view><button class="football-icon-button" bindtap="onEditMatch" aria-label="编辑比赛"><lucide-icon name="pencil" size="18" color="#57534e"/></button></view>
      <view wx:if="{{competition}}" class="competition-name">{{competition}}</view>
      <view class="match-score"><view class="match-team"><football-record-icon family-id="{{familyId}}" record-id="{{match.representativeTeamId}}" icon="{{representativeIcon}}"/><text>{{representative}}</text></view><text class="match-result">{{score}}</text><view class="match-team"><football-record-icon family-id="{{familyId}}" record-id="{{match.opponentTeamId}}" icon="{{opponentIcon}}"/><text>{{opponent}}</text></view></view>
      <view wx:if="{{match.notes}}" class="match-notes">{{match.notes}}</view>

    </view>
    <view class="card">
      <view class="section-title">比赛表现</view>
      <picker mode="selector" range="{{people}}" range-key="displayName" value="{{selectedPersonIndex}}" bindchange="onPlayer">
        <view class="football-player"><text>球员</text><text class="football-player-name">{{people[selectedPersonIndex].displayName||'请先编辑参赛名单'}}</text><lucide-icon name="chevron-down" size="16" color="#78716c"/></view>
      </picker>
      <view class="quick-grid">
        <button wx:for="{{quickTypes}}" wx:key="key" class="quick-item" data-type="{{item.key}}" bindtap="onOpenQuick" disabled="{{busy||!schema||!selectedPersonId}}">
          <text class="quick-symbol">{{item.icon}}</text><text>{{item.name}}</text><text class="quick-count">{{eventsError||performanceBusy?'—':item.count}}</text>
        </button>
      </view>
      <view class="more-performance">
        <button wx:if="{{appearanceAvailable}}" data-type="appearance" bindtap="onOpenQuick"><lucide-icon name="clock" size="17" color="#57534e"/><text>出场记录</text></button>
        <button wx:if="{{moreTypes.length}}" bindtap="onToggleMore" aria-expanded="{{moreOpen}}"><lucide-icon name="plus" size="17" color="#57534e"/><text>更多表现</text><lucide-icon name="chevron-down" size="15" color="#78716c"/></button>
      </view>
      <view wx:if="{{moreOpen}}" class="quick-grid"><button wx:for="{{moreTypes}}" wx:key="key" class="quick-item" data-type="{{item.key}}" bindtap="onOpenQuick" disabled="{{busy||!selectedPersonId}}">{{item.name}}</button></view>
      <view wx:if="{{schemaError}}" class="thin-error">表现模型暂不可用：{{schemaError}}</view>
    </view>
    <view class="card">
      <view class="section-title">已记录的表现</view>
      <view wx:if="{{eventsError}}" class="load-error-state"><text class="load-error-text">{{eventsError}}</text><button class="btn-outline btn-sm" bindtap="onRetry">重新加载</button></view>
      <view wx:elif="{{performanceBusy && !performancesLoaded}}" class="loading-state">读取表现中…</view>
      <view wx:for="{{performances}}" wx:key="id" class="performance-row" data-id="{{item.id}}" bindtap="onPerformanceTap">
        <view class="performance-main"><view><text class="performance-type">{{item.typeText}}</text><text class="performance-person">{{item.personName}}</text></view><text wx:if="{{item.detailText}}" class="performance-detail">{{item.detailText}}</text></view>
        <button class="football-icon-button" data-id="{{item.id}}" catchtap="onPerformanceTap" aria-label="编辑这条表现"><lucide-icon name="pencil" size="17" color="#78716c"/></button>
      </view>
      <view wx:if="{{!performances.length&&!eventsError&&!performanceBusy}}" class="performance-empty">还没有记录表现，点击上方快捷按钮即可开始。</view>
      <view wx:if="{{performanceCursor}}" class="more-performance" bindtap="onMorePerformance">加载更多表现</view>
    </view>
    <view wx:if="{{formOpen}}" class="football-mask" catchtap="onFormClose">
      <view class="football-sheet" catchtap="noop">
        <view class="sheet-grip"></view>
        <view class="sheet-header"><text>{{performanceId?'编辑':'记录'}}{{allTypes[performanceTypeIndex].name||'比赛表现'}}</text><button class="football-icon-button" bindtap="onFormClose" aria-label="关闭表单" disabled="{{busy}}"><lucide-icon name="x" size="20" color="#57534e"/></button></view>
        <scroll-view scroll-y class="sheet-body">
          <picker disabled="{{busy}}" mode="selector" range="{{allTypes}}" range-key="name" value="{{performanceTypeIndex}}" bindchange="onFormType"><view class="form-row">表现类型 <text>{{allTypes[performanceTypeIndex].name}}</text><lucide-icon name="chevron-down" size="16" color="#78716c"/></view></picker>
          <picker disabled="{{busy}}" mode="selector" range="{{people}}" range-key="displayName" value="{{playerIndex}}" data-key="player" bindchange="onFormPicker">
            <view class="form-row">球员 <text>{{people[playerIndex].displayName}}</text><lucide-icon name="chevron-down" size="16" color="#78716c"/></view>
          </picker>
          <view wx:if="{{performanceType==='goal'}}">
            <picker disabled="{{busy}}" mode="selector" range="{{goalMethods}}" range-key="name" value="{{goalMethodIndex}}" data-key="method" bindchange="onFormPicker">
              <view class="form-row">进球方式 <text>{{goalMethods[goalMethodIndex].name}}</text><lucide-icon name="chevron-down" size="16" color="#78716c"/></view>
            </picker>
          </view>
          <view wx:if="{{performanceType==='shot'&&hasShotOutcome}}">
            <picker disabled="{{busy}}" mode="selector" range="{{shotOutcomes}}" range-key="name" value="{{shotOutcomeIndex}}" data-key="outcome" bindchange="onFormPicker">
              <view class="form-row">射门结果 <text>{{shotOutcomes[shotOutcomeIndex].name}}</text><lucide-icon name="chevron-down" size="16" color="#78716c"/></view>
            </picker>
          </view>
          <view wx:if="{{performanceType==='shot'}}" class="football-help">已记录为进球的射门无需再记一次，统计时会自动计入。</view>
          <view wx:if="{{performanceType==='key_pass'}}" class="football-help">同一次助攻无需重复记录关键传球，统计时会自动计入。</view>
          <view wx:if="{{performanceType==='one_on_one_save'}}" class="football-help">单刀扑救会自动计入扑救总数，无需重复记录普通扑救。</view>
          <block wx:if="{{performanceType==='appearance'}}">
            <view class="form-row">本段上场时间（分钟） <input disabled="{{busy}}" type="number" value="{{minutesPlayed}}" placeholder="可选" data-key="minutesPlayed" bindinput="onFormValue"/></view>
            <view class="form-row">场上位置 <input disabled="{{busy}}" value="{{position}}" placeholder="如：左边锋、中前卫" maxlength="80" data-key="position" bindinput="onFormValue"/></view>
            <picker disabled="{{busy}}" mode="selector" range="{{entryModes}}" range-key="name" value="{{entryModeIndex}}" data-key="entry" bindchange="onFormPicker">
              <view class="form-row">进入方式 <text>{{entryModes[entryModeIndex].name}}</text><lucide-icon name="chevron-down" size="16" color="#78716c"/></view>
            </picker>
          </block>
          <view wx:if="{{performanceType==='appearance'}}" class="football-help">换下后再次登场、场内换位可记录多段；每段只填写该段时长。</view>
          <view class="form-row form-notes">
            <text>备注</text>
            <textarea disabled="{{busy}}" placeholder="可补充细节（选填）" maxlength="3000" value="{{notes}}" data-key="notes" bindinput="onFormValue"/>
          </view>
        </scroll-view>
        <view wx:if="{{formError}}" class="thin-error">{{formError}}</view>
        <view class="sheet-footer"><button class="football-secondary" bindtap="onFormClose" disabled="{{busy}}">取消</button><button class="btn-primary" disabled="{{busy}}" loading="{{busy}}" bindtap="onFormSave">确认保存</button></view>
        <button wx:if="{{performanceId}}" class="form-delete" bindtap="onFormDelete" disabled="{{busy}}"><lucide-icon name="trash-2" size="16" color="#b91c1c"/><text>删除此记录</text></button>
      </view>
    </view>
  </block>
</view>