/* 首次资料设置 / 编辑资料页样式 */
.container {
  padding: 48rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 48rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-hint);
}

/* 头像预览 */
.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.avatar-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.avatar-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: var(--color-border);
}

.avatar-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-mask-text {
  font-size: 24rpx;
  color: #ffffff;
}

/* 头像来源操作 */
.avatar-actions {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.avatar-btn {
  flex: 1;
  max-width: 280rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 0;
  margin: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-btn-wechat {
  background-color: #07c160;
  color: #ffffff;
}

.avatar-btn-album {
  background-color: #ffffff;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.avatar-btn[disabled] {
  opacity: 0.6;
}

/* 表单 */
.form-item {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background-color: #ffffff;
  border: 2rpx solid var(--color-border);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.input:focus {
  border-color: var(--color-primary);
}

/* 提交按钮 */
.submit-wrapper {
  margin-top: 64rpx;
}
