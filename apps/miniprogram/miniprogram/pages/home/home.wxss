/* 首页：今天的家庭工作台 */
@import "./home.skeleton.wxss";

/* 需要关注：去掉外层大卡片，露出页面浅绿背景，仅保留标题 + 横向卡片 */
.attention-section {
  margin-bottom: 22rpx;
  padding-bottom: 4rpx;
}

.attention-scroll {
  white-space: nowrap;
  width: 100%;
  margin-top: 8rpx;
}

/* 下拉刷新容器：nav-bar 在容器外固定，仅内容区可下拉刷新 */
.home-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.home-scroll {
  flex: 1;
  min-height: 0;
}

/* 子卡：宽度约 46%，两张完整 + 露出下一张一小部分 */
.attn-card {
  display: inline-flex;
  flex-direction: column;
  vertical-align: top;
  width: 46%;
  height: 248rpx;
  white-space: normal;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  margin-right: 16rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(67, 160, 71, 0.06);
}

.attn-card:first-child {
  margin-left: 0;
}

.attn-card:last-child {
  margin-right: 24rpx;
}

/* 第一行：图标 + 名称 */
.attn-card-head {
  display: flex;
  align-items: center;
}

.attn-card-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--home-primary-tint);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.attn-card-icon {
  font-size: 32rpx;
}

.attn-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--home-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 日子类主行：高亮数字 + 单位 */
.attn-line-main {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--home-secondary);
  line-height: 1.4;
}

.attn-num {
  color: var(--home-info);
  font-weight: 700;
  font-size: 44rpx;
  margin-right: 4rpx;
}

/* 日子类底部补充文案 */
.attn-line-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--home-hint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attn-line-sub.attn-anchor {
  color: var(--home-secondary);
}

/* 周期进度条 */
.attn-progress {
  margin-top: 12rpx;
  height: 10rpx;
  background: rgba(67, 160, 71, 0.14);
  border-radius: 5rpx;
  overflow: hidden;
}

.attn-progress-fill {
  height: 100%;
  background: var(--home-primary);
  border-radius: 5rpx;
}

/* 非日子类（逾期/紧急）：简洁两行 */
.attn-line-simple {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--home-secondary);
  line-height: 1.4;
}

/* 级别配色：图标底色 + 高亮数字 */
.attn-card-icon-wrap.attention-critical {
  background: #fdecec;
}
.attn-card.attention-critical .attn-num {
  color: var(--home-danger);
}
.attn-card.attention-critical .attn-line-simple {
  color: var(--home-danger);
}
.attn-progress-fill.attention-critical {
  background: var(--home-danger);
}

.attn-card-icon-wrap.attention-warning {
  background: #fff4e5;
}
.attn-card.attention-warning .attn-num {
  color: var(--home-warning);
}
.attn-card.attention-warning .attn-line-simple {
  color: var(--home-warning);
}
.attn-progress-fill.attention-warning {
  background: var(--home-warning);
}

.attn-card.attention-info .attn-num {
  color: var(--home-info);
}
.attn-progress-fill.attention-info {
  background: var(--home-info);
}

/* critical 整卡高亮：靠红底区分，让逾期/紧急真正跳出来 */
.attn-card.attention-critical {
  background: #FDECEC;
}

/* 统计卡片（已按需求删除，保留占位注释） */

/* 紧急提醒（已按需求删除，聚合进「需要关注」横向卡片） */

/* 栏目卡片 */
.card.section {
  min-height: 200rpx;
}

/* 栏目标题等公共样式已在全局 app.wxss 统一定义 */

/* 今天安排列表 */
.event-list {
  padding-top: 8rpx;
}

.event-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f2f4f3;
}

.event-item:last-child {
  border-bottom: none;
}

.event-time {
  flex-shrink: 0;
  width: 110rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--home-primary);
}

.event-summary {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--home-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 已过期的日程：视觉弱化并置灰，已在逻辑层过滤不展示 */
.event-item.event-ended .event-time {
  color: var(--home-secondary);
}

.event-item.event-ended .event-summary {
  color: var(--home-secondary);
}

.event-ended-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 20rpx;
  color: var(--home-secondary);
  background-color: #f0f2f1;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

/* 进行中的日程：仅字体高亮（不使用背景色/描边），标签保留 */
.event-item.event-ongoing .event-time {
  color: var(--home-primary);
}

.event-item.event-ongoing .event-summary {
  color: var(--home-primary);
  font-weight: 600;
}

.event-ongoing-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #ffffff;
  background-color: var(--home-primary);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

/* 待办提醒列表 */
.task-list {
  padding-top: 8rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f2f4f3;
}

.task-item:last-child {
  border-bottom: none;
}

.task-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  border: 3rpx solid #d4dbd8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  background-color: #ffffff;
}

.task-check.check-loading {
  opacity: 0.6;
}

.loading-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: var(--home-primary);
  animation: task-pulse 1s ease-in-out infinite;
}

@keyframes task-pulse {
  0%, 100% { opacity: 0.4; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

.task-body {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--home-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-name.name-overdue {
  color: var(--home-danger);
}

/* 负责人 + 截止日期标签组（两者可同时展示） */
.task-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  max-width: 50%;
}

.task-assignee {
  font-size: 22rpx;
  color: var(--home-primary);
  background-color: #EAF6EB;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-due {
  font-size: 22rpx;
  color: var(--home-secondary);
  background-color: #f2f4f3;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.task-due.due-overdue {
  color: var(--home-danger);
  background-color: #fdecec;
}

/* 超出展示上限时的「更多」提示行 */
.task-more {
  padding: 20rpx 0 4rpx;
  text-align: center;
}

.task-more-text {
  font-size: 24rpx;
  color: var(--home-secondary);
}

/* 悬浮新增按钮 */
.fab-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 60;
  display: flex;
  align-items: flex-end;
}

.fab-sheet {
  width: 100%;
  background: #ffffff;
  padding: 16rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
}

.fab-action {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: #f5f8f6;
  color: var(--home-text);
  border-radius: 18rpx;
  font-size: 30rpx;
  margin-top: 16rpx;
  border: none;
}

.fab-action::after {
  border: none;
}

.fab-cancel {
  color: var(--home-secondary);
  background: #f0f2f1;
}

/* 生活进行时：紧凑切换与列表，沿用首页绿色主题。 */
.life-tabs {
  display: flex;
  gap: 12rpx;
  margin: 8rpx 0 10rpx;
}
.life-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  border-radius: 14rpx;
  color: var(--home-secondary);
  font-size: 26rpx;
}
.life-tab-active { background: var(--home-primary-tint); color: var(--home-primary); font-weight: 600; }
.life-error-dot { width: 10rpx; height: 10rpx; margin-left: 8rpx; border-radius: 50%; background: var(--home-danger); }
.life-row { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 2rpx solid #f2f4f3; }
.life-row:last-child { border-bottom: none; }
.life-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: var(--home-primary-tint);
  font-size: 32rpx;
  flex-shrink: 0;
}
.life-body { flex: 1; min-width: 0; }
.life-name-row { display: flex; align-items: center; gap: 10rpx; }
.life-name { min-width: 0; font-size: 28rpx; color: var(--home-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.life-personal-tag { flex-shrink: 0; font-size: 20rpx; color: var(--home-primary); }
.life-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--home-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.life-check {
  flex-shrink: 0;
  margin: 0 0 0 14rpx;
  padding: 0 20rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  border-radius: 16rpx;
  background: var(--home-primary);
  color: #fff;
  font-size: 24rpx;
}
.life-check::after { border: none; }
.life-check[disabled] { background: #f2f4f3; color: var(--home-secondary); }
.life-check.life-check-done { background: var(--home-primary-tint); color: var(--home-primary); }
.life-chevron { margin-left: 14rpx; color: var(--home-hint); font-size: 34rpx; }

/* 首页导航栏左侧：家庭圆形徽章 + 家庭名称（统一 nav-bar 组件的 left slot） */
.home-nav-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.home-nav-title {
  margin-left: 14rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--home-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


