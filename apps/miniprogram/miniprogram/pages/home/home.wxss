/* 首页样式 */

/* 当前家庭头部 */
.family-header {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}

.family-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background-color: #f0f0f0;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.family-info {
  flex: 1;
  min-width: 0;
}

.family-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.family-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #333333;
}

.switch-icon {
  font-size: 28rpx;
  color: #999999;
}

.family-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.switch-btn {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 28rpx;
}

.switch-btn-text {
  font-size: 24rpx;
  color: #4CAF50;
}

/* 区域卡片 */
.section {
  margin-top: 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-more {
  font-size: 24rpx;
  color: #999999;
}

.empty-hint {
  padding: 16rpx 28rpx 24rpx;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: #999999;
}

.quick-action {
  margin: 0 28rpx 28rpx;
  height: 80rpx;
  background-color: #f7faf7;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-action-text {
  font-size: 28rpx;
  color: #4CAF50;
}

/* 无家庭空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.empty-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 48rpx;
  text-align: center;
  padding: 0 48rpx;
}

.empty-actions {
  width: 100%;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.empty-actions .btn-primary,
.empty-actions .btn-outline {
  width: 100%;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}
