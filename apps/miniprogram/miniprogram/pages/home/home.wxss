/* 首页：今天的家庭工作台 */

page {
  --home-primary: #2DBB78;
  --home-primary-dark: #20A968;
  --home-hero: #4AC986;
  --home-bg: #F1F9F5;
  --home-card: #FFFFFF;
  --home-text: #303442;
  --home-secondary: #9299A3;
  --home-danger: #E85A5A;

  background: var(--home-bg);
  color: var(--home-text);
}

.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 160rpx;
}

/* 卡片（覆盖全局 .card，使用首页绿色调） */
.card {
  background: var(--home-card);
  border-radius: 26rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 187, 120, 0.06);
}

/* 欢迎卡片 */
.greeting-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 42rpx 36rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #57CF91, #30BC78);
  color: #ffffff;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(45, 187, 120, 0.18);
}

.greeting-main {
  flex: 1;
  min-width: 0;
}

.greeting-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.greeting-date {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.greeting-subtitle {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.95;
}

.family-switch {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.22);
  padding: 10rpx 18rpx 10rpx 10rpx;
  border-radius: 40rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  max-width: 240rpx;
}

.family-switch-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ffffff;
  flex-shrink: 0;
}

.family-switch-name {
  font-size: 24rpx;
  color: #ffffff;
  margin: 0 6rpx 0 10rpx;
  max-width: 130rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.family-switch-caret {
  font-size: 22rpx;
  color: #ffffff;
}

/* 统计卡片 */
.stat-row {
  display: flex;
  gap: 22rpx;
  margin-bottom: 22rpx;
}

.stat-card {
  flex: 1;
  background: var(--home-card);
  border-radius: 26rpx;
  padding: 30rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(45, 187, 120, 0.06);
}

.stat-num {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--home-primary);
  line-height: 1.1;
}

.stat-label {
  font-size: 26rpx;
  color: var(--home-secondary);
  margin-top: 8rpx;
}

/* 紧急提醒 */
.urgent-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  border-radius: 22rpx;
  margin-bottom: 22rpx;
  font-size: 26rpx;
}

.urgent-event {
  background: #FFF4E5;
  color: #B26A00;
}

.urgent-overdue {
  background: #FDECEC;
  color: var(--home-danger);
}

.urgent-text {
  flex: 1;
  min-width: 0;
}

.urgent-arrow {
  margin-left: 12rpx;
  font-size: 30rpx;
  flex-shrink: 0;
}

/* 栏目卡片 */
.card.section {
  min-height: 200rpx;
}

/* 栏目标题 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--home-text);
}

.section-more {
  font-size: 24rpx;
  color: var(--home-secondary);
}

.section-header-right {
  display: flex;
  align-items: center;
}

/* 非破坏性刷新指示：区头小转圈，不替换已有内容 */
.inline-spin {
  font-size: 26rpx;
  color: var(--home-secondary);
  margin-right: 12rpx;
  display: inline-block;
  animation: home-spin 0.8s linear infinite;
}

@keyframes home-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 有旧数据时后台刷新失败：保留旧数据，仅显示细错误提示条 */
.thin-error {
  padding: 18rpx 4rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--home-danger);
}

/* 今天安排列表 */
.event-list {
  padding-top: 8rpx;
}

.event-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f2f4f3;
}

.event-item:last-child {
  border-bottom: none;
}

.event-time {
  flex-shrink: 0;
  width: 110rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--home-primary);
}

.event-summary {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--home-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 待办提醒列表 */
.task-list {
  padding-top: 8rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f2f4f3;
}

.task-item:last-child {
  border-bottom: none;
}

.task-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  border: 3rpx solid #d4dbd8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  background-color: #ffffff;
}

.task-check.check-loading {
  opacity: 0.6;
}

.loading-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: var(--home-primary);
  animation: task-pulse 1s ease-in-out infinite;
}

@keyframes task-pulse {
  0%, 100% { opacity: 0.4; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

.task-body {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--home-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-name.name-overdue {
  color: var(--home-danger);
}

.task-due {
  font-size: 22rpx;
  color: var(--home-secondary);
  background-color: #eef4f0;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.task-due.due-overdue {
  color: var(--home-danger);
  background-color: #fdecec;
}

/* 空状态 / 加载提示 */
.empty-hint {
  padding: 24rpx 4rpx 8rpx;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: var(--home-secondary);
}

.empty-link {
  font-size: 26rpx;
  color: var(--home-primary);
}

/* 悬浮新增按钮 */
.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(56rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--home-primary);
  color: #ffffff;
  font-size: 60rpx;
  font-weight: 300;
  line-height: 104rpx;
  text-align: center;
  box-shadow: 0 10rpx 28rpx rgba(45, 187, 120, 0.4);
  z-index: 50;
}

.fab-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 60;
  display: flex;
  align-items: flex-end;
}

.fab-sheet {
  width: 100%;
  background: #ffffff;
  padding: 16rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
}

.fab-action {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: #f5f8f6;
  color: var(--home-text);
  border-radius: 18rpx;
  font-size: 30rpx;
  margin-top: 16rpx;
  border: none;
}

.fab-action::after {
  border: none;
}

.fab-cancel {
  color: var(--home-secondary);
  background: #f0f2f1;
}
