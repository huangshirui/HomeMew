/* 首页样式 */

/* 当前家庭头部 */
.family-header {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}

.family-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background-color: #f0f0f0;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.family-info {
  flex: 1;
  min-width: 0;
}

.family-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.family-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #333333;
}

.switch-icon {
  font-size: 28rpx;
  color: #999999;
}

.family-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.switch-btn {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 28rpx;
}

.switch-btn-text {
  font-size: 24rpx;
  color: #4CAF50;
}

/* 区域卡片 */
.section {
  margin-top: 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-more {
  font-size: 24rpx;
  color: #999999;
}

.empty-hint {
  padding: 16rpx 28rpx 24rpx;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: #999999;
}

/* 今日日程列表 */
.event-list {
  padding: 0 28rpx 16rpx;
}

.event-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.event-item:last-child {
  border-bottom: none;
}

.event-time-col {
  flex-shrink: 0;
  width: 180rpx;
}

.event-time {
  font-size: 26rpx;
  color: #4CAF50;
  font-weight: 500;
}

.event-info {
  flex: 1;
  min-width: 0;
}

.event-summary {
  display: block;
  font-size: 28rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-attendees {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-action {
  margin: 0 28rpx 28rpx;
  height: 80rpx;
  background-color: #f7faf7;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-action-text {
  font-size: 28rpx;
  color: #4CAF50;
}

/* 待办任务计数徽标 */
.section-count {
  margin-left: 12rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background-color: #f0f7f1;
  color: #4CAF50;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  line-height: 36rpx;
}

/* 待办任务列表 */
.task-list {
  padding: 0 28rpx 16rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.task-item:last-child {
  border-bottom: none;
}

/* 复选框 */
.task-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #d0d0d0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  background-color: #ffffff;
}

.task-check.check-done {
  background-color: #4CAF50;
  border-color: #4CAF50;
}

.task-check.check-loading {
  opacity: 0.6;
}

.check-icon-done {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
  line-height: 1;
}

.loading-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #4CAF50;
  animation: task-pulse 1s ease-in-out infinite;
}

@keyframes task-pulse {
  0%, 100% { opacity: 0.4; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

/* 任务内容 */
.task-body {
  flex: 1;
  min-width: 0;
}

.task-name {
  display: block;
  font-size: 28rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-name.name-overdue {
  color: #e53935;
}

.task-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 6rpx;
}

.assignee-tag {
  font-size: 22rpx;
  color: #4CAF50;
  background-color: #eaf7ec;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.due-tag {
  font-size: 22rpx;
  color: #999999;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.due-tag.due-overdue {
  color: #e53935;
  background-color: #fff5f5;
}

/* 无家庭空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.empty-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 48rpx;
  text-align: center;
  padding: 0 48rpx;
}

.empty-actions {
  width: 100%;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.empty-actions .btn-primary,
.empty-actions .btn-outline {
  width: 100%;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}
