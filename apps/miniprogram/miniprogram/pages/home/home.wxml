<!-- 首页：今天的家庭工作台 -->
<import src="home.skeleton.wxml" />
<view class="container">

  <!-- 骨架屏：首屏数据就绪前覆盖展示，避免白屏 -->
  <template is="skeleton" wx:if="{{loading}}" />

  <!-- 有家庭时 -->
  <block wx:if="{{currentFamily}}">

    <!-- 欢迎卡片 -->
    <view class="greeting-card">
      <view class="greeting-main">
        <text class="greeting-title">{{greetingText}}</text>
        <text class="greeting-date">{{dateText}}</text>
        <text class="greeting-subtitle">{{greetingSubtitle}}</text>
      </view>

      <!-- 当前家庭入口：始终显示；多家庭显示名称与下拉箭头，单家庭只显示头像 -->
      <view class="family-switch {{canSwitch ? '' : 'single'}}" bindtap="onSwitchFamily">
        <image
          class="family-switch-avatar"
          src="{{currentFamily.avatarUrl || '/assets/images/default-family.png'}}"
          mode="aspectFill"
        />
        <block wx:if="{{canSwitch}}">
          <text class="family-switch-name">{{currentFamily.name}}</text>
          <text class="family-switch-caret">▾</text>
        </block>
      </view>
    </view>

    <!-- 需要关注：横向滚动卡片（有内容时才显示） -->
    <view wx:if="{{attentionCards.length > 0}}" class="card section attention-section">
      <view class="section-header">
        <text class="section-title">需要关注</text>
      </view>

      <scroll-view class="attention-scroll" scroll-x enable-flex>
        <view
          wx:for="{{attentionCards}}"
          wx:key="id"
          class="attn-card attn-{{item.kind}} attention-{{item.level}}"
          data-navigate="{{item.navigate}}"
          data-id="{{item.id}}"
          bindtap="onAttentionCardTap"
        >
          <!-- 第一行：图标 + 名称 -->
          <view class="attn-card-head">
            <view class="attn-card-icon-wrap attention-{{item.level}}">
              <text class="attn-card-icon">{{item.icon}}</text>
            </view>
            <text class="attn-card-name">{{item.title}}</text>
          </view>

          <!-- 日子类：按 kind 渲染不同子结构 -->
          <block wx:if="{{item.kind === 'day'}}">
            <!-- elapsed：三行（已记录天数 + 提醒状态） -->
            <block wx:if="{{item.dayType === 'elapsed'}}">
              <text class="attn-line-main">
                <text class="attn-num">{{item.dayNumber}}</text>{{item.dayUnit}}
              </text>
              <text class="attn-line-sub">{{item.daySubText}}</text>
            </block>

            <!-- countdown：三行（剩余/已过天数 + 锚点日期） -->
            <block wx:elif="{{item.dayType === 'countdown'}}">
              <text class="attn-line-main">
                <text class="attn-num">{{item.dayNumber}}</text>{{item.dayUnit}}
              </text>
              <text class="attn-line-sub attn-anchor">{{item.daySubText}}</text>
            </block>

            <!-- cycle：四行（已使用天数 + 进度条 + 到期信息） -->
            <block wx:elif="{{item.dayType === 'cycle'}}">
              <text class="attn-line-main">
                <text class="attn-num">{{item.dayNumber}}</text>{{item.dayUnit}}
              </text>
              <view class="attn-progress" wx:if="{{item.dayProgress != null}}">
                <view class="attn-progress-fill attention-{{item.level}}" style="width: {{item.dayProgress}}%"></view>
              </view>
              <text class="attn-line-sub">{{item.daySubText}}</text>
            </block>
          </block>

          <!-- 非日子类（逾期/紧急）：简洁两行 -->
          <block wx:else>
            <text class="attn-line-simple">{{item.desc}}</text>
          </block>
        </view>
      </scroll-view>
    </view>

    <!-- 今天安排 -->
    <view class="card section">
      <view class="section-header" bindtap="onViewEvents">
        <text class="section-title">今天安排</text>
        <view class="section-header-right">
          <text wx:if="{{eventsRefreshing}}" class="inline-spin">↻</text>
          <text class="section-more">查看全部 ›</text>
        </view>
      </view>

      <view wx:if="{{eventsLoading && todayEvents.length === 0}}" class="empty-hint">
        <text class="empty-text">加载中...</text>
      </view>
      <view wx:elif="{{eventsError && todayEvents.length === 0}}" class="empty-hint" bindtap="onRetryEvents">
        <text class="empty-text">加载失败，点击重试</text>
      </view>
      <view wx:elif="{{todayEvents.length > 0}}" class="event-list">
        <view
          wx:for="{{todayEvents}}"
          wx:key="id"
          class="event-item {{item.isOngoing ? 'event-ongoing' : ''}} {{item.isEnded ? 'event-ended' : ''}}"
          data-id="{{item.id}}"
          bindtap="onEventTap"
        >
          <text class="event-time">{{item.timeText}}</text>
          <text class="event-summary">{{item.summary}}</text>
          <text wx:if="{{item.isOngoing}}" class="event-ongoing-tag">进行中</text>
          <text wx:elif="{{item.isEnded}}" class="event-ended-tag">已结束</text>
        </view>
      </view>
      <view wx:elif="{{eventsError}}" class="thin-error" bindtap="onRetryEvents">
        <text>更新失败，点击重试</text>
      </view>
      <view wx:else class="empty-hint">
        <text class="empty-link" bindtap="onCreateEvent">今天还没有安排 ＋ 添加日程</text>
      </view>
    </view>

    <!-- 待办提醒 -->
    <view class="card section">
      <view class="section-header" bindtap="onViewTasks">
        <text class="section-title">待办提醒</text>
        <view class="section-header-right">
          <text wx:if="{{tasksRefreshing}}" class="inline-spin">↻</text>
          <text class="section-more">查看全部 ›</text>
        </view>
      </view>

      <view wx:if="{{tasksLoading && pendingTasks.length === 0}}" class="empty-hint">
        <text class="empty-text">加载中...</text>
      </view>
      <view wx:elif="{{tasksError && pendingTasks.length === 0}}" class="empty-hint" bindtap="onRetryTasks">
        <text class="empty-text">加载失败，点击重试</text>
      </view>
      <view wx:elif="{{pendingTasks.length > 0}}" class="task-list">
        <view
          wx:for="{{pendingTasks}}"
          wx:key="id"
          class="task-item"
          data-id="{{item.id}}"
          bindtap="onTaskTap"
        >
          <view
            class="task-check {{item.completing ? 'check-loading' : ''}}"
            data-id="{{item.id}}"
            catchtap="onToggleTaskStatus"
          >
            <text wx:if="{{item.completing}}" class="loading-dot"></text>
          </view>
          <view class="task-body">
            <text class="task-name {{item.isOverdue ? 'name-overdue' : ''}}">{{item.name}}</text>
            <view wx:if="{{item.assigneeText || item.dueText}}" class="task-tags">
              <text wx:if="{{item.assigneeText}}" class="task-assignee">{{item.assigneeText}}</text>
              <text wx:if="{{item.dueText}}" class="task-due {{item.isOverdue ? 'due-overdue' : ''}}">{{item.dueText}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{pendingTaskMore > 0}}" class="task-more" bindtap="onViewTasks">
          <text class="task-more-text">还有 {{pendingTaskMore}} 条待办 ›</text>
        </view>
      </view>
      <view wx:elif="{{tasksError}}" class="thin-error" bindtap="onRetryTasks">
        <text>更新失败，点击重试</text>
      </view>
      <view wx:else class="empty-hint">
        <text class="empty-link" bindtap="onCreateTask">最近 3 天没有到期的待办 ＋ 添加待办</text>
      </view>
    </view>

    <!-- 日子关注项加载失败时的轻量提示（无关注卡时不展示空状态） -->
    <view wx:if="{{daysError && attentionCards.length === 0}}" class="thin-error" bindtap="onRetryDays">
      <text>关注信息更新失败，点击重试</text>
    </view>

    <!-- 常用工具 -->
    <view class="card section tools-section">
      <view class="section-header">
        <text class="section-title">常用工具</text>
      </view>
      <view class="tools-row">
        <view class="tool-card" bindtap="onViewDays">
          <text class="tool-emoji">🗓️</text>
          <view class="tool-body">
            <text class="tool-title">日子</text>
            <text class="tool-desc">记录倒计时与周期</text>
          </view>
        </view>
        <view class="tool-card" bindtap="onViewWishes">
          <text class="tool-emoji">🌟</text>
          <view class="tool-body">
            <text class="tool-title">许愿池</text>
            <text class="tool-desc">看看家人的愿望</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 无家庭时 -->
  <block wx:elif="{{loaded}}">
    <view class="empty-state">
      <image class="empty-image" src="/assets/images/empty-family.png" mode="aspectFit" />
      <text class="empty-title">还没有加入任何家庭</text>
      <text class="empty-desc">创建一个家庭，和家人一起管理日程与待办</text>

      <view class="empty-actions">
        <button class="btn-primary" bindtap="onCreateFamily">创建家庭</button>
        <button class="btn-outline" style="margin-top: 24rpx;" bindtap="onJoinFamily">加入家庭</button>
      </view>
    </view>
  </block>

  <!-- 加载中 -->
  <block wx:else>
    <view class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>
  </block>
</view>
