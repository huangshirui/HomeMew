<!-- 首页 -->
<view class="container">
  <!-- 有家庭时 -->
  <block wx:if="{{currentFamily}}">
    <!-- 家庭头部 -->
    <view class="family-header card">
      <view class="family-info" bindtap="onSwitchFamily">
        <text class="family-name">{{currentFamily.name}}</text>
        <text class="switch-hint">点击切换</text>
      </view>
      <view class="family-meta">
        <text class="member-count">{{currentFamily.memberCount}}人</text>
        <text class="role-tag">{{currentFamily.role === 'admin' ? '管理员' : '成员'}}</text>
      </view>
    </view>

    <!-- 家庭操作 -->
    <view class="card">
      <view class="menu-item" bindtap="onViewDetail">
        <text class="menu-text">家庭详情与成员</text>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onCreateFamily">
        <text class="menu-text">创建家庭</text>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onJoinFamily">
        <text class="menu-text">加入家庭</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 占位：日程区域 -->
    <view class="card">
      <view class="section-header">
        <text class="section-title">今日日程</text>
      </view>
      <view class="empty-hint">
        <text class="empty-text">功能即将上线</text>
      </view>
    </view>

    <!-- 占位：待办区域 -->
    <view class="card">
      <view class="section-header">
        <text class="section-title">待完成任务</text>
      </view>
      <view class="empty-hint">
        <text class="empty-text">功能即将上线</text>
      </view>
    </view>

    <!-- 快速操作（暂未开放） -->
    <view class="quick-actions">
      <view class="action-item" bindtap="onCreateEvent">
        <text class="action-text">+ 新建日程</text>
      </view>
      <view class="action-item" bindtap="onCreateTask">
        <text class="action-text">+ 新建待办</text>
      </view>
    </view>
  </block>

  <!-- 无家庭时 -->
  <block wx:elif="{{loaded}}">
    <view class="empty-state">
      <image class="empty-image" src="/assets/images/empty-family.png" mode="aspectFit" />
      <text class="empty-title">还没有加入任何家庭</text>
      <text class="empty-desc">创建一个家庭，和家人一起管理日程与待办</text>

      <view class="empty-actions">
        <button class="btn-primary" bindtap="onCreateFamily">创建家庭</button>
        <button class="btn-outline" style="margin-top: 24rpx;" bindtap="onJoinFamily">加入家庭</button>
      </view>
    </view>
  </block>

  <!-- 加载中 -->
  <block wx:else>
    <view class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>
  </block>
</view>
