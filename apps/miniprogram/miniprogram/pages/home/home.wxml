<!-- 首页 -->
<view class="container">
  <!-- 有家庭时：当前家庭工作台 -->
  <block wx:if="{{currentFamily}}">
    <!-- 当前家庭头部 -->
    <view class="family-header card">
      <image
        class="family-avatar"
        src="{{currentFamily.avatarUrl || '/assets/images/default-family.png'}}"
        mode="aspectFill"
      />
      <view class="family-info">
        <view class="family-name-row">
          <text class="family-name">{{currentFamily.name}}</text>
          <text wx:if="{{canSwitch}}" class="switch-icon">▾</text>
        </view>
        <text class="family-meta">{{currentFamily.memberCount}} 位成员</text>
      </view>
      <view
        wx:if="{{canSwitch}}"
        class="switch-btn"
        bindtap="onSwitchFamily"
      >
        <text class="switch-btn-text">切换</text>
      </view>
    </view>

    <!-- 快速操作区 -->
    <view class="card section quick-actions">
      <view class="quick-action-item" bindtap="onCreateEvent">
        <view class="qa-icon qa-event">日</view>
        <text class="qa-label">新建日程</text>
      </view>
      <view class="quick-action-item" bindtap="onCreateTask">
        <view class="qa-icon qa-task">✓</view>
        <text class="qa-label">新建待办</text>
      </view>
      <view
        wx:if="{{isAdmin}}"
        class="quick-action-item"
        bindtap="onInviteFamily"
      >
        <view class="qa-icon qa-invite">＋</view>
        <text class="qa-label">邀请家人</text>
      </view>
    </view>

    <!-- 近期日程 -->
    <view class="card section">
      <view class="section-header" bindtap="onViewEvents">
        <text class="section-title">近期日程</text>
        <text class="section-more">查看全部 ›</text>
      </view>

      <!-- 加载中 -->
      <view wx:if="{{eventsLoading}}" class="empty-hint">
        <text class="empty-text">加载中...</text>
      </view>

      <!-- 加载失败 -->
      <view wx:elif="{{eventsError}}" class="empty-hint" bindtap="onRetryEvents">
        <text class="empty-text">加载失败，点击重试</text>
      </view>

      <!-- 日程列表 -->
      <view wx:elif="{{upcomingEvents.length > 0}}" class="event-list">
        <view
          wx:for="{{upcomingEvents}}"
          wx:key="id"
          class="event-item"
          data-id="{{item.id}}"
          bindtap="onEventTap"
        >
          <view class="event-date-col">
            <text class="event-date">{{item.dateText}}</text>
            <text class="event-time">{{item.timeText}}</text>
          </view>
          <view class="event-info">
            <text class="event-summary">{{item.summary}}</text>
            <text wx:if="{{item.attendeeText}}" class="event-attendees">{{item.attendeeText}}</text>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view wx:else class="empty-hint">
        <text class="empty-text">未来 7 天暂无日程</text>
      </view>

      <view wx:if="{{upcomingTotal > 3}}" class="view-more" bindtap="onViewEvents">
        <text class="view-more-text">查看全部 {{upcomingTotal}} 条日程 ›</text>
      </view>
    </view>

    <!-- 待办任务 -->
    <view class="card section">
      <view class="section-header" bindtap="onViewTasks">
        <text class="section-title">待办任务</text>
        <text wx:if="{{pendingTaskCount > 0}}" class="section-count">{{pendingTaskCount}}</text>
        <text class="section-more">查看全部 ›</text>
      </view>

      <!-- 加载中 -->
      <view wx:if="{{tasksLoading}}" class="empty-hint">
        <text class="empty-text">加载中...</text>
      </view>

      <!-- 加载失败 -->
      <view wx:elif="{{tasksError}}" class="empty-hint" bindtap="onRetryTasks">
        <text class="empty-text">加载失败，点击重试</text>
      </view>

      <!-- 任务列表 -->
      <view wx:elif="{{tasks.length > 0}}" class="task-list">
        <view
          wx:for="{{tasks}}"
          wx:key="id"
          class="task-item"
          data-id="{{item.id}}"
          bindtap="onTaskTap"
        >
          <view
            class="task-check {{item.status === 'completed' ? 'check-done' : ''}} {{item.completing ? 'check-loading' : ''}}"
            data-id="{{item.id}}"
            catchtap="onToggleTaskStatus"
          >
            <text wx:if="{{item.status === 'completed' && !item.completing}}" class="check-icon-done">✓</text>
            <text wx:if="{{item.completing}}" class="loading-dot"></text>
          </view>
          <view class="task-body">
            <text class="task-name {{item.isOverdue ? 'name-overdue' : ''}}">{{item.name}}</text>
            <view wx:if="{{item.assigneeText || item.dueText}}" class="task-meta">
              <text wx:if="{{item.assigneeText}}" class="assignee-tag">{{item.assigneeText}}</text>
              <text wx:if="{{item.dueText}}" class="due-tag {{item.isOverdue ? 'due-overdue' : ''}}">{{item.dueText}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view wx:else class="empty-hint">
        <text class="empty-text">暂无待办任务</text>
      </view>

      <view wx:if="{{pendingTaskCount > 3}}" class="view-more" bindtap="onViewTasks">
        <text class="view-more-text">查看全部 {{pendingTaskCount}} 条待办 ›</text>
      </view>
    </view>
  </block>

  <!-- 无家庭时 -->
  <block wx:elif="{{loaded}}">
    <view class="empty-state">
      <image class="empty-image" src="/assets/images/empty-family.png" mode="aspectFit" />
      <text class="empty-title">还没有加入任何家庭</text>
      <text class="empty-desc">创建一个家庭，和家人一起管理日程与待办</text>

      <view class="empty-actions">
        <button class="btn-primary" bindtap="onCreateFamily">创建家庭</button>
        <button class="btn-outline" style="margin-top: 24rpx;" bindtap="onJoinFamily">加入家庭</button>
      </view>
    </view>
  </block>

  <!-- 加载中 -->
  <block wx:else>
    <view class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>
  </block>
</view>
