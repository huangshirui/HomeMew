/* 愿望详情页 */

/* 下拉刷新容器：nav-bar 在容器外固定，仅内容区可下拉刷新 */
.wishes-detail-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.wishes-detail-scroll {
  flex: 1;
  min-height: 0;
}

.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #ffffff 0%, #fbfffc 100%);
  border-radius: 30rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 5rpx 18rpx rgba(67, 160, 71, 0.07);
  border: 1rpx solid rgba(67, 160, 71, 0.08);
}

.hero.status-open .hero-light {
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  right: -90rpx;
  top: -140rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(129, 199, 132, 0.22) 0%, rgba(129, 199, 132, 0) 72%);
  animation: hero-breathe 4.2s ease-in-out infinite;
}

.hero.status-fulfilled {
  background: linear-gradient(145deg, #fffdf6 0%, #fff7df 100%);
  border-color: rgba(240, 183, 65, 0.22);
  box-shadow: 0 8rpx 26rpx rgba(209, 157, 48, 0.12);
}

.hero.status-fulfilled .hero-light {
  position: absolute;
  inset: -80rpx;
  background: radial-gradient(circle at 80% 15%, rgba(255, 213, 98, 0.26), rgba(255, 213, 98, 0) 42%);
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-title {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
  margin-right: 16rpx;
}

.hero-status {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background-color: var(--color-primary-tint);
  color: var(--color-primary);
}

.hero.status-fulfilled .hero-status {
  background-color: rgba(255, 193, 7, 0.16);
  color: #9b6800;
}

.fulfilled-note {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 18rpx;
  font-size: 25rpx;
  color: #8c6a25;
  line-height: 1.6;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.meta-row:last-child { border-bottom: none; }

.meta-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.meta-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  text-align: right;
  margin-left: 24rpx;
}

.desc-text {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.7;
}

.main-btn { margin-bottom: 22rpx; }

.fulfill-btn {
  box-shadow: 0 10rpx 28rpx rgba(67, 160, 71, 0.20);
}

.actions-card {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.action-btn {
  flex: 1;
  min-width: 200rpx;
  height: 78rpx;
  line-height: 78rpx;
  font-size: 28rpx;
}

.quiet-action { color: var(--color-text-secondary); }

.wish-celebration {
  position: fixed;
  inset: 0;
  z-index: 999;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: rgba(255, 252, 238, 0.18);
  animation: celebration-backdrop 1.5s ease-out both;
}

.celebration-halo {
  position: absolute;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 218, 112, 0.48) 0%, rgba(255, 218, 112, 0.08) 48%, rgba(255, 218, 112, 0) 72%);
  animation: celebration-halo 1.2s ease-out both;
}

.celebration-copy {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 54rpx 34rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 60rpx rgba(146, 105, 24, 0.18);
  animation: celebration-copy 1.35s cubic-bezier(0.2, 0.9, 0.3, 1) both;
}

.celebration-emoji {
  font-size: 60rpx;
  line-height: 1;
  margin-bottom: 18rpx;
}

.celebration-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #5f4b20;
}

.celebration-subtitle {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #9a7d43;
}

.spark {
  position: absolute;
  left: 50%;
  top: 50%;
  color: #e5ad2f;
  font-size: 38rpx;
  opacity: 0;
}

.spark-1 { animation: sparkle-1 1s 0.04s ease-out both; }
.spark-2 { animation: sparkle-2 1.05s 0.10s ease-out both; }
.spark-3 { animation: sparkle-3 1.05s 0.14s ease-out both; }
.spark-4 { animation: sparkle-4 0.95s 0.20s ease-out both; }
.spark-5 { animation: sparkle-5 1s 0.08s ease-out both; }
.spark-6 { animation: sparkle-6 1s 0.16s ease-out both; }

@keyframes hero-breathe {
  0%, 100% { transform: scale(0.92); opacity: 0.58; }
  50% { transform: scale(1.08); opacity: 0.95; }
}

@keyframes celebration-backdrop {
  0% { opacity: 0; }
  18%, 75% { opacity: 1; }
  100% { opacity: 0; }
}

@keyframes celebration-halo {
  0% { opacity: 0; transform: scale(0.25); }
  45% { opacity: 1; transform: scale(1.05); }
  100% { opacity: 0; transform: scale(1.45); }
}

@keyframes celebration-copy {
  0% { opacity: 0; transform: translateY(26rpx) scale(0.88); }
  20% { opacity: 1; transform: translateY(0) scale(1.03); }
  72% { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: translateY(-10rpx) scale(0.98); }
}

@keyframes sparkle-1 {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.35) rotate(0deg); }
  22% { opacity: 1; }
  100% { opacity: 0; transform: translate(-280rpx, -230rpx) scale(1.15) rotate(90deg); }
}
@keyframes sparkle-2 {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.35) rotate(0deg); }
  22% { opacity: 1; }
  100% { opacity: 0; transform: translate(170rpx, -200rpx) scale(1.15) rotate(90deg); }
}
@keyframes sparkle-3 {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.35) rotate(0deg); }
  22% { opacity: 1; }
  100% { opacity: 0; transform: translate(-300rpx, 30rpx) scale(1.15) rotate(90deg); }
}
@keyframes sparkle-4 {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.35) rotate(0deg); }
  22% { opacity: 1; }
  100% { opacity: 0; transform: translate(190rpx, 60rpx) scale(1.15) rotate(90deg); }
}
@keyframes sparkle-5 {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.35) rotate(0deg); }
  22% { opacity: 1; }
  100% { opacity: 0; transform: translate(-140rpx, -300rpx) scale(1.15) rotate(90deg); }
}
@keyframes sparkle-6 {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.35) rotate(0deg); }
  22% { opacity: 1; }
  100% { opacity: 0; transform: translate(40rpx, 190rpx) scale(1.15) rotate(90deg); }
}
