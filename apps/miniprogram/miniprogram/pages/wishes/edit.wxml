<!-- 愿望创建 / 编辑页 -->
<view class="container">
  <view wx:if="{{loadError}}" class="load-error-state">
    <text class="load-error-text">加载失败</text>
    <button class="btn-outline btn-sm" bindtap="onRetryLoad">重新加载</button>
  </view>

  <view wx:elif="{{!loaded}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <view class="wish-intro" wx:if="{{mode === 'create'}}">
      <text class="wish-intro-star">✦</text>
      <text class="wish-intro-text">把一个小小的期待，放进许愿池</text>
    </view>

    <view class="card">
      <view class="field-row">
        <text class="field-label">愿望标题</text>
        <input
          class="field-input"
          value="{{title}}"
          bindinput="onTitleInput"
          placeholder="例如：一起去看海"
          maxlength="100"
        />
      </view>
    </view>

    <view class="card">
      <picker mode="date" value="{{desiredDate}}" bindchange="onDesiredDateChange">
        <view class="field-row">
          <text class="field-label">期望实现日期</text>
          <view class="field-value">
            <text class="field-text">{{desiredDate || '未设置'}}</text>
            <text class="field-arrow">›</text>
          </view>
        </view>
      </picker>
      <view class="field-hint">
        <text class="hint-text">选填，不设则不限日期</text>
      </view>
    </view>

    <view class="card">
      <view class="field-row column">
        <text class="field-label">愿望描述</text>
        <textarea
          class="field-textarea"
          value="{{description}}"
          bindinput="onDescriptionInput"
          placeholder="选填，补充一些细节"
          maxlength="500"
          auto-height
        />
      </view>
    </view>

    <view class="footer-spacer"></view>
  </block>

  <view wx:if="{{loaded && !loadError && !wishCreated}}" class="footer-bar safe-area-bottom">
    <button class="btn-outline footer-btn" bindtap="onCancel">取消</button>
    <button
      class="btn-primary footer-btn wish-submit-btn"
      disabled="{{submitting}}"
      bindtap="onSubmit"
    >
      {{submitting ? (mode === 'edit' ? '保存中...' : '许愿中...') : (mode === 'edit' ? '保存' : '许下这个愿望 ✨')}}
    </button>
  </view>
</view>

<view wx:if="{{wishCreated}}" class="wish-created-overlay">
  <view class="pool-glow"></view>
  <view class="pool-ripple ripple-one"></view>
  <view class="pool-ripple ripple-two"></view>
  <text class="falling-star">✦</text>
  <view class="wish-created-copy">
    <text class="wish-created-title">愿望收好啦</text>
    <text class="wish-created-subtitle">✨ 等它慢慢实现</text>
  </view>
</view>
