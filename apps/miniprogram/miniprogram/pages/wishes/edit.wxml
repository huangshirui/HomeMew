<!-- 愿望创建 / 编辑页 -->
<view class="container">
  <!-- 加载失败 -->
  <view wx:if="{{loadError}}" class="load-error-state">
    <text class="load-error-text">加载失败</text>
    <button class="btn-outline btn-sm" bindtap="onRetryLoad">重新加载</button>
  </view>

  <view wx:elif="{{!loaded}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 标题 -->
    <view class="card">
      <view class="field-row">
        <text class="field-label">愿望标题</text>
        <input
          class="field-input"
          value="{{title}}"
          bindinput="onTitleInput"
          placeholder="例如：一起去看海"
          maxlength="100"
        />
      </view>
    </view>

    <!-- 期望日期 -->
    <view class="card">
      <picker mode="date" value="{{desiredDate}}" bindchange="onDesiredDateChange">
        <view class="field-row">
          <text class="field-label">期望实现日期</text>
          <view class="field-value">
            <text class="field-text">{{desiredDate || '未设置'}}</text>
            <text class="field-arrow">›</text>
          </view>
        </view>
      </picker>
      <view class="field-hint">
        <text class="hint-text">选填，不设则不限日期</text>
      </view>
    </view>

    <!-- 说明 -->
    <view class="card">
      <view class="field-row column">
        <text class="field-label">愿望描述</text>
        <textarea
          class="field-textarea"
          value="{{description}}"
          bindinput="onDescriptionInput"
          placeholder="选填，补充一些细节"
          maxlength="500"
          auto-height
        />
      </view>
    </view>

    <view class="footer-spacer"></view>
  </block>

  <!-- 底部操作栏 -->
  <view wx:if="{{loaded && !loadError}}" class="footer-bar safe-area-bottom">
    <button class="btn-outline footer-btn" bindtap="onCancel">取消</button>
    <button
      class="btn-primary footer-btn"
      disabled="{{submitting}}"
      bindtap="onSubmit"
    >
      {{submitting ? '保存中...' : (mode === 'edit' ? '保存' : '许下愿望')}}
    </button>
  </view>
</view>
