/* 许愿池列表页 */

/* 下拉刷新容器：nav-bar 在容器外固定，仅内容区可下拉刷新 */
.wishes-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.wishes-scroll {
  flex: 1;
  min-height: 0;
}

.filter-bar {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.filter-inner {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 0;
}

.filter-chip {
  flex-shrink: 0;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background-color: #ffffff;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.4;
}

.filter-chip.filter-active {
  background-color: var(--color-primary);
  color: #ffffff;
}

.refresh-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 12rpx;
}

.refresh-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.wish-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #ffffff 0%, #fbfffc 100%);
  border-radius: 28rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 5rpx 18rpx rgba(67, 160, 71, 0.07);
  border: 1rpx solid rgba(67, 160, 71, 0.08);
}

.wish-card.status-open .wish-glow {
  position: absolute;
  width: 180rpx;
  height: 180rpx;
  right: -70rpx;
  top: -90rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(129, 199, 132, 0.18) 0%, rgba(129, 199, 132, 0) 72%);
  animation: wish-breathe 4.2s ease-in-out infinite;
}

.wish-card.status-fulfilled {
  background: linear-gradient(145deg, #fffdf6 0%, #fff9e9 100%);
  border-color: rgba(240, 183, 65, 0.18);
  box-shadow: 0 6rpx 22rpx rgba(209, 157, 48, 0.10);
}

.wish-memory-mark {
  position: absolute;
  right: 24rpx;
  bottom: 18rpx;
  color: rgba(220, 164, 43, 0.42);
  font-size: 36rpx;
}

.wish-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.wish-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: var(--color-primary-tint);
  flex-shrink: 0;
  margin-right: 12rpx;
}

.wish-owner {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wish-status {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background-color: var(--color-primary-tint);
  color: var(--color-primary);
}

.wish-status.status-fulfilled {
  background-color: rgba(255, 193, 7, 0.14);
  color: #a96f00;
}

.wish-title {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.wish-desc {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.wish-meta {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.wish-date {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.more-hint {
  padding: 20rpx 0 8rpx;
  text-align: center;
}

.fab.fab-small {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  line-height: normal;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.wish-fab {
  box-shadow: 0 10rpx 30rpx rgba(67, 160, 71, 0.24);
}

.fab-plus {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.fab-plus-line {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 4rpx;
  background-color: #ffffff;
  transform: translate(-50%, -50%);
}

.fab-plus-horizontal {
  width: 34rpx;
  height: 4rpx;
}

.fab-plus-vertical {
  width: 4rpx;
  height: 34rpx;
}

.skeleton {
  padding: 8rpx 0 0;
  overflow: hidden;
}

.skel-day { margin-bottom: 18rpx; }

.skel-card {
  height: 120rpx;
  border-radius: 26rpx;
  background-color: #eef2ef;
  margin-bottom: 18rpx;
}

@keyframes wish-breathe {
  0%, 100% { transform: scale(0.92); opacity: 0.58; }
  50% { transform: scale(1.08); opacity: 0.95; }
}
