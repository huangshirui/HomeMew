<!-- 许愿池列表页 -->
<view class="container wishes-root">
  <nav-bar title="许愿池" showBack="true" />

  <scroll-view
    class="wishes-scroll"
    scroll-y
    enable-flex
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="onReachBottom"
  >
  <block wx:if="{{noFamily}}">
    <view class="empty-state">
      <image class="empty-image" src="/assets/images/empty-family.png" mode="aspectFit" />
      <text class="empty-title">还没有家庭</text>
      <text class="empty-desc">加入或创建家庭后，就可以一起记录和实现愿望。</text>
      <view class="empty-actions">
        <button class="btn-primary" bindtap="onCreateFamily">创建家庭</button>
        <button class="btn-outline" style="margin-top: 24rpx;" bindtap="onJoinFamily">加入家庭</button>
      </view>
    </view>
  </block>

  <block wx:else>
    <scroll-view class="filter-bar" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="filter-inner">
        <view
          wx:for="{{filters}}"
          wx:key="key"
          class="filter-chip {{activeFilter === item.key ? 'filter-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onFilterTap"
        >{{item.label}}</view>
      </view>
    </scroll-view>

    <view wx:if="{{firstLoading}}" class="skeleton">
      <view class="skel-day" wx:for="{{[0, 1, 2]}}" wx:key="*this">
        <view class="skel-card"></view>
        <view class="skel-card"></view>
      </view>
    </view>

    <view wx:elif="{{loadError}}" class="load-error-state">
      <text class="load-error-text">加载失败，请检查网络后重试</text>
      <button class="btn-outline btn-sm" bindtap="onRetry">重新加载</button>
    </view>

    <block wx:else>
      <view wx:if="{{refreshing}}" class="refresh-hint">
        <text class="inline-spin">↻</text>
        <text class="refresh-text">正在更新</text>
      </view>

      <block wx:if="{{items.length > 0}}">
        <view
          wx:for="{{items}}"
          wx:key="id"
          class="wish-card status-{{item.status}}"
          data-id="{{item.id}}"
          bindtap="onWishTap"
        >
          <view class="wish-glow"></view>
          <view class="wish-head">
            <image class="wish-avatar" src="{{item.ownerAvatar}}" mode="aspectFill" />
            <text class="wish-owner">{{item.ownerName}} 的愿望</text>
            <text class="wish-status status-{{item.status}}">{{item.statusLabel}}</text>
          </view>

          <image wx:if="{{item.iconImagePath}}" src="{{item.iconImagePath}}" mode="aspectFit" style="width:48rpx;height:48rpx;margin-right:10rpx" /><text wx:elif="{{item.iconEmoji}}" style="font-size:34rpx;margin-right:10rpx">{{item.iconEmoji}}</text><text class="wish-title">{{item.title}}</text>
          <text wx:if="{{item.descriptionBrief}}" class="wish-desc">{{item.descriptionBrief}}</text>
          <view wx:if="{{item.desiredDateText}}" class="wish-meta">
            <text class="wish-date">{{item.desiredDateText}}</text>
          </view>
          <text wx:if="{{item.status === 'fulfilled'}}" class="wish-memory-mark">✦</text>
        </view>
      </block>

      <view wx:else class="empty-state">
        <block wx:if="{{activeFilter === 'fulfilled'}}">
          <text class="empty-title">还没有实现的愿望</text>
          <text class="empty-desc">等某个愿望成真的时候，这里会留下它。</text>
        </block>
        <block wx:elif="{{activeFilter === 'mine'}}">
          <text class="empty-title">你还没有许下愿望</text>
          <view class="empty-actions">
            <button class="btn-primary" bindtap="onCreate">许下第一个愿望</button>
          </view>
        </block>
        <block wx:else>
          <text class="empty-title">许愿池还是空的</text>
          <text class="empty-desc">写下一个想实现的事，先把期待留在这里。</text>
          <view class="empty-actions">
            <button class="btn-primary" bindtap="onCreate">许下第一个愿望</button>
          </view>
        </block>
      </view>

      <view wx:if="{{loadingMore}}" class="more-hint">
        <text class="empty-text">加载中...</text>
      </view>
      <view wx:elif="{{!hasMore && items.length > 0}}" class="more-hint">
        <text class="empty-text">没有更多了</text>
      </view>
    </block>

  </block>
  </scroll-view>

  <view wx:if="{{!noFamily}}" class="fab fab-small wish-fab" bindtap="onCreate">
    <view class="fab-plus">
      <view class="fab-plus-line fab-plus-horizontal"></view>
      <view class="fab-plus-line fab-plus-vertical"></view>
    </view>
  </view>
</view>
