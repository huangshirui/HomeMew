<!-- 愿望详情页 -->
<view class="container wishes-detail-root">
  <nav-bar title="愿望详情" showBack="true" />

  <scroll-view
    class="wishes-detail-scroll"
    scroll-y
    enable-flex
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
  <view wx:if="{{loadError}}" class="load-error-state">
    <text class="load-error-text">加载失败</text>
    <button class="btn-outline btn-sm" bindtap="onRetry">重新加载</button>
  </view>

  <view wx:elif="{{!loaded}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <view class="hero status-{{status}}">
      <view class="hero-light"></view>
      <view class="hero-top">
        <image wx:if="{{iconImagePath}}" src="{{iconImagePath}}" mode="aspectFit" style="width:56rpx;height:56rpx;border-radius:10rpx;margin-right:12rpx;vertical-align:middle" /><text wx:elif="{{iconEmoji}}" style="font-size:38rpx;margin-right:12rpx">{{iconEmoji}}</text><text class="hero-title">{{title}}</text>
        <text class="hero-status">{{statusLabel}}</text>
      </view>
      <text wx:if="{{status === 'fulfilled'}}" class="fulfilled-note">这个愿望已经成为一段真实的家庭记忆 ✨</text>
    </view>

    <view class="card">
      <view wx:for="{{metaRows}}" wx:key="label" class="meta-row">
        <text class="meta-label">{{item.label}}</text>
        <text class="meta-value">{{item.value}}</text>
      </view>
    </view>

    <view wx:if="{{description}}" class="card">
      <text class="meta-label">愿望描述</text>
      <text class="desc-text">{{description}}</text>
    </view>

    <button
      wx:if="{{canFulfill && status === 'open'}}"
      class="btn-primary main-btn fulfill-btn"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="onFulfill"
    >{{submitting ? '点亮中...' : '实现这个愿望 ✨'}}</button>

    <view wx:if="{{isOwner || status === 'fulfilled'}}" class="card actions-card">
      <button
        wx:if="{{isOwner}}"
        class="btn-outline action-btn"
        disabled="{{submitting}}"
        bindtap="onEdit"
      >编辑愿望</button>
      <button
        wx:if="{{status === 'fulfilled'}}"
        class="btn-outline action-btn quiet-action"
        disabled="{{submitting}}"
        bindtap="onReopen"
      >撤销实现</button>
      <button
        wx:if="{{isOwner}}"
        class="btn-outline danger action-btn"
        disabled="{{submitting}}"
        bindtap="onDelete"
      >删除</button>
    </view>
  </block>
  </scroll-view>
</view>

<view wx:if="{{celebrating}}" class="wish-celebration">
  <view class="celebration-halo"></view>
  <text class="spark spark-1">✦</text>
  <text class="spark spark-2">✧</text>
  <text class="spark spark-3">✦</text>
  <text class="spark spark-4">✧</text>
  <text class="spark spark-5">✦</text>
  <text class="spark spark-6">✧</text>
  <view class="celebration-copy">
    <text class="celebration-emoji">✨</text>
    <text class="celebration-title">愿望实现啦</text>
    <text class="celebration-subtitle">这一刻，值得记住</text>
  </view>
</view>
