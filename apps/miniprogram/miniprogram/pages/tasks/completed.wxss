/* 已完成待办列表页样式（与待办页卡片保持一致） */

.container {
  padding-bottom: 60rpx;
}

/* 首屏加载骨架屏（对齐待办页，仅占位列表区） */
.skeleton {
  padding: 8rpx 0 0;
  overflow: hidden;
}

.skel-day {
  margin-bottom: 16rpx;
}

.skel-card {
  height: 120rpx;
  border-radius: 26rpx;
  background-color: #eef2ef;
  margin-bottom: 16rpx;
}

/* 顶部只读范围条 */
.scope-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 24rpx;
}

.scope-bar-text {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scope-bar-count {
  font-size: 26rpx;
  color: var(--color-text-hint);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 加载失败 */
.list-error {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.list-error-text {
  font-size: 28rpx;
  color: var(--color-text-hint);
}

/* 任务卡片 */
.task-card {
  background-color: var(--color-card);
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 12rpx 20rpx 4rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 187, 120, 0.06);
}

.task-check-hit {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.task-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  border: 3rpx solid #d0d0d0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
}

.task-check.check-done {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}

.task-check.check-loading {
  opacity: 0.6;
}

.check-icon-done {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
  line-height: 1;
}

.loading-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #ffffff;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

.task-body {
  flex: 1;
  min-width: 0;
}

.task-name-row {
  margin-bottom: 8rpx;
}

.task-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.task-name.name-done {
  text-decoration: line-through;
  color: var(--color-text-hint);
}

.task-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.assignee-tag {
  font-size: 22rpx;
  color: var(--color-primary);
  background-color: #eaf7ec;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.due-tag {
  font-size: 22rpx;
  color: var(--color-text-hint);
  background-color: var(--color-bg);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.task-arrow {
  font-size: 40rpx;
  color: #c8c8c8;
  line-height: 1;
  flex-shrink: 0;
  margin-left: 8rpx;
  padding: 0 8rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 30rpx;
  color: var(--color-text-secondary);
}

.empty-desc {
  font-size: 26rpx;
  color: var(--color-text-hint);
  margin-top: 16rpx;
  text-align: center;
  padding: 0 60rpx;
  line-height: 1.6;
}
