<!-- 待办任务列表页 -->
<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{!loaded}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 无家庭引导 -->
  <block wx:elif="{{noFamily}}">
    <view class="empty-state">
      <image class="empty-image" src="/assets/images/empty-family.png" mode="aspectFit" />
      <text class="empty-title">还没有家庭</text>
      <text class="empty-desc">加入或创建家庭后，就可以和家人共享日程和待办。</text>
      <view class="empty-actions">
        <button class="btn-primary" bindtap="onCreateFamily">创建家庭</button>
        <button class="btn-outline" style="margin-top: 24rpx;" bindtap="onJoinFamily">加入家庭</button>
      </view>
    </view>
  </block>

  <block wx:else>
    <!-- 两段式统计 + 切换 -->
    <view class="tab-bar">
      <view
        class="tab-item {{activeTab === 'pending' ? 'tab-active' : ''}}"
        data-tab="pending"
        bindtap="onTabChange"
      >
        <text class="tab-count">{{pendingCount}}</text>
        <text class="tab-text">进行中</text>
      </view>
      <view
        class="tab-item {{activeTab === 'completed' ? 'tab-active' : ''}}"
        data-tab="completed"
        bindtap="onTabChange"
      >
        <text class="tab-count">{{completedCount}}</text>
        <text class="tab-text">已完成</text>
      </view>
    </view>

    <!-- 加载失败 -->
    <view wx:if="{{listError}}" class="list-error" bindtap="onRetry">
      <text class="list-error-text">加载失败，点击重试</text>
    </view>

    <!-- 任务列表 -->
    <block wx:elif="{{displayTasks.length > 0}}">
      <view
        wx:for="{{displayTasks}}"
        wx:key="id"
        class="task-card"
        data-id="{{item.id}}"
        bindtap="onTaskTap"
      >
        <!-- 左侧复选框（扩大点击热区） -->
        <view class="task-check-hit" data-id="{{item.id}}" catchtap="onToggleStatus">
          <view class="task-check {{item.status === 'completed' ? 'check-done' : ''}} {{item.completing ? 'check-loading' : ''}}">
            <text wx:if="{{item.status === 'completed' && !item.completing}}" class="check-icon-done">✓</text>
            <text wx:if="{{item.completing}}" class="loading-dot"></text>
          </view>
        </view>

        <!-- 任务内容 -->
        <view class="task-body">
          <view class="task-name-row">
            <text class="task-name {{item.status === 'completed' ? 'name-done' : ''}} {{item.isOverdue ? 'name-overdue' : ''}}">{{item.name}}</text>
          </view>
          <view wx:if="{{item.assigneeText || item.dueText}}" class="task-meta">
            <text wx:if="{{item.assigneeText}}" class="assignee-tag">{{item.assigneeText}}</text>
            <text wx:if="{{item.dueText}}" class="due-tag {{item.isOverdue ? 'due-overdue' : ''}}">{{item.dueText}}</text>
          </view>
        </view>

        <!-- 进入详情箭头 -->
        <text class="task-arrow">›</text>
      </view>
    </block>

    <!-- 空状态（按当前 tab 区分） -->
    <view wx:else class="empty-state">
      <image class="empty-image" src="/assets/images/empty-family.png" mode="aspectFit" />
      <text class="empty-title">{{activeTab === 'pending' ? '还没有进行中的待办' : '还没有已完成的待办'}}</text>
      <view wx:if="{{activeTab === 'pending'}}" class="empty-actions">
        <button class="btn-primary" bindtap="onCreate">新建待办</button>
      </view>
    </view>

  </block>
</view>
