<!-- 待办任务列表页（进行中） -->
<view class="container tasks-root">
  <nav-bar title="待办任务" topInset="{{0}}" />

  <!-- 无家庭引导 -->
  <block wx:if="{{noFamily}}">
    <view class="empty-state">
      <image class="empty-image" src="/assets/images/empty-family.png" mode="aspectFit" />
      <text class="empty-title">还没有家庭</text>
      <text class="empty-desc">加入或创建家庭后，就可以和家人共享日程和待办。</text>
      <view class="empty-actions">
        <button class="btn-primary" bindtap="onCreateFamily">创建家庭</button>
        <button class="btn-outline" style="margin-top: 24rpx;" bindtap="onJoinFamily">加入家庭</button>
      </view>
    </view>
  </block>

  <block wx:else>
    <scroll-view
      class="tasks-scroll"
      scroll-y
      enable-flex
      refresher-enabled
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onRefresh"
    >
    <!-- 顶栏：成员范围 + 已完成入口 -->
    <view class="topbar">
      <view class="scope-btn" bindtap="onOpenScope">
        <text class="scope-text">{{scopeLabel}}</text>
        <text class="scope-caret">▾</text>
      </view>
      <view class="done-btn" bindtap="onViewCompleted">
        <text class="done-text">已完成 ›</text>
      </view>
    </view>

    <!-- 统计：进行中 / 已逾期 -->
    <view class="stat-bar">
      <view class="stat-item">
        <text class="stat-count">{{pendingCount}}</text>
        <text class="stat-text">进行中</text>
      </view>
      <view class="stat-item">
        <text class="stat-count {{overdueCount > 0 ? 'stat-count-overdue' : ''}}">{{overdueCount}}</text>
        <text class="stat-text">已逾期</text>
      </view>
    </view>

    <!-- 首屏加载骨架屏（对齐日程页，仅占位任务列表区） -->
    <view wx:if="{{!loaded}}" class="skeleton">
      <view class="skel-day" wx:for="{{[0, 1, 2]}}" wx:key="*this">
        <view class="skel-card"></view>
        <view class="skel-card"></view>
      </view>
    </view>

    <!-- 加载失败 -->
    <view wx:elif="{{listError}}" class="list-error" bindtap="onRetry">
      <text class="list-error-text">加载失败，点击重试</text>
    </view>

    <!-- 任务列表 -->
    <block wx:elif="{{pendingTasks.length > 0}}">
      <view
        wx:for="{{pendingTasks}}"
        wx:key="id"
        class="task-card"
        data-id="{{item.id}}"
        bindtap="onTaskTap"
      >
        <!-- 左侧复选框（扩大点击热区） -->
        <view class="task-check-hit" data-id="{{item.id}}" catchtap="onToggleStatus">
          <view class="task-check {{item.completing ? 'check-loading' : ''}}">
            <text wx:if="{{item.completing}}" class="loading-dot"></text>
          </view>
        </view>

        <!-- 任务内容 -->
        <view class="task-body">
          <view class="task-name-row">
            <text class="task-name {{item.isOverdue ? 'name-overdue' : ''}}">{{item.name}}</text>
          </view>
          <view wx:if="{{item.assigneeText || item.dueText}}" class="task-meta">
            <text wx:if="{{item.assigneeText}}" class="assignee-tag">{{item.assigneeText}}</text>
            <text wx:if="{{item.dueText}}" class="due-tag {{item.isOverdue ? 'due-overdue' : ''}}">{{item.dueText}}</text>
          </view>
        </view>

        <!-- 进入详情箭头 -->
        <text class="task-arrow">›</text>
      </view>
    </block>

    <!-- 空状态 -->
    <view wx:else class="empty-state">
      <image class="empty-image" src="/assets/images/empty-family.png" mode="aspectFit" />
      <text class="empty-title">{{scope === 'me' ? '你还没有进行中的待办' : '还没有进行中的待办'}}</text>
      <view class="empty-actions empty-actions-row">
        <button class="btn-primary btn-sm" bindtap="onCreate">新建待办</button>
      </view>
    </view>

    </scroll-view>

    <!-- 成员范围选择弹层 -->
    <view wx:if="{{showScopeSheet}}" class="sheet-mask" bindtap="onCloseScope" catchtouchmove="noop">
      <view class="sheet" catchtap="noop">
        <view class="sheet-header">
          <text class="sheet-title">选择待办</text>
        </view>
        <view
          wx:for="{{scopeOptions}}"
          wx:key="key"
          class="sheet-option {{scope === item.key ? 'sheet-option-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSelectScope"
        >
          <view wx:if="{{item.showAvatar}}" class="sheet-avatar-wrap">
            <image class="sheet-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
          </view>
          <view wx:else class="sheet-avatar-wrap sheet-avatar-all">
            <text class="sheet-avatar-all-text">家</text>
          </view>
          <text class="sheet-option-label">{{item.label}}</text>
          <text wx:if="{{scope === item.key}}" class="sheet-check">✓</text>
        </view>
        <view class="sheet-cancel" bindtap="onCloseScope">
          <text class="sheet-cancel-text">取消</text>
        </view>
      </view>
    </view>

  </block>
</view>
