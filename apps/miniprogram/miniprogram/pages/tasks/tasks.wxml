<!-- 待办任务列表页 -->
<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{!loaded}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 统计卡片 -->
    <view class="stats-row">
      <view class="stat-card">
        <text class="stat-number">{{pendingCount}}</text>
        <text class="stat-label">进行中</text>
      </view>
      <view class="stat-card">
        <text class="stat-number">{{completedCount}}</text>
        <text class="stat-label">已完成</text>
      </view>
    </view>

    <!-- 标签筛选 -->
    <view class="tab-bar">
      <view
        class="tab-item {{activeTab === 'all' ? 'tab-active' : ''}}"
        data-tab="all"
        bindtap="onTabChange"
      >
        <text class="tab-text">全部</text>
      </view>
      <view
        class="tab-item {{activeTab === 'pending' ? 'tab-active' : ''}}"
        data-tab="pending"
        bindtap="onTabChange"
      >
        <text class="tab-text">进行中</text>
      </view>
      <view
        class="tab-item {{activeTab === 'completed' ? 'tab-active' : ''}}"
        data-tab="completed"
        bindtap="onTabChange"
      >
        <text class="tab-text">已完成</text>
      </view>
    </view>

    <!-- 任务列表 / 空状态 -->
    <block wx:if="{{tasks.length > 0}}">
      <view
        wx:for="{{tasks}}"
        wx:key="id"
        wx:if="{{activeTab === 'all' || (activeTab === 'pending' && item.status === 'pending') || (activeTab === 'completed' && item.status === 'completed')}}"
        class="task-card"
        data-id="{{item.id}}"
        bindtap="onTaskTap"
      >
        <!-- 左侧复选框 -->
        <view
          class="task-check {{item.status === 'completed' ? 'check-done' : ''}} {{item.completing ? 'check-loading' : ''}}"
          data-id="{{item.id}}"
          catchtap="onToggleStatus"
        >
          <text wx:if="{{item.status === 'completed' && !item.completing}}" class="check-icon-done">✓</text>
          <text wx:if="{{item.completing}}" class="loading-dot"></text>
        </view>

        <!-- 任务内容 -->
        <view class="task-body">
          <view class="task-name-row">
            <text class="task-name {{item.status === 'completed' ? 'name-done' : ''}} {{item.isOverdue ? 'name-overdue' : ''}}">{{item.name}}</text>
          </view>
          <view class="task-meta">
            <block wx:if="{{item.assignees.length > 0}}">
              <text wx:for="{{item.assignees}}" wx:for-item="assignee" wx:for-index="assigneeIdx" wx:key="userId" class="assignee-tag">
                {{assignee.displayName}}
              </text>
            </block>
            <text wx:if="{{item.dueText}}" class="due-tag {{item.isOverdue ? 'due-overdue' : ''}}">
              <text class="due-icon">📅</text> {{item.dueText}}
            </text>
          </view>
        </view>

        <!-- 删除按钮 -->
        <view class="task-delete" data-id="{{item.id}}" catchtap="onDelete">
          <text class="delete-icon">×</text>
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <view wx:if="{{tasks.length === 0}}" class="empty-state">
      <image class="empty-image" src="/assets/images/empty-family.png" mode="aspectFit" />
      <text class="empty-title">暂无任务，去添加吧</text>
    </view>

    <!-- 悬浮新增按钮 -->
    <view class="fab" bindtap="onCreate">
      <text class="fab-text">+</text>
    </view>
  </block>
</view>
