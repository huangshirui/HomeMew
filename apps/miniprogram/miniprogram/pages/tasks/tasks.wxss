/* 待办任务列表页样式 */

/* 页面容器：底部留白，避免最后一条内容被 FAB 遮挡 */
/* 与日程页保持一致：不使用全局 .container 的 padding，由顶栏/统计栏/卡片自行携带 32rpx 留白 */
.container {
  padding: 0;
  padding-bottom: 160rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-hint);
}

/* ---------- 顶栏：成员范围 + 已完成入口（与日程页一致） ---------- */

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 12rpx;
  background-color: var(--color-card);
}

.scope-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 40%;
  flex-shrink: 0;
}

.scope-text {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scope-caret {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.done-btn {
  padding: 8rpx 24rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: 28rpx;
  flex-shrink: 0;
}

.done-text {
  font-size: 26rpx;
  color: var(--color-primary);
}

/* ---------- 统计：进行中 / 已逾期 ---------- */

.stat-bar {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 32rpx 24rpx;
  background-color: var(--color-card);
}

.stat-item {
  flex: 1;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background-color: var(--color-bg-white);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.stat-count {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-primary);
  line-height: 1.1;
}

.stat-count.stat-count-overdue {
  color: var(--color-danger);
}

.stat-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

/* 加载失败 */
.list-error {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.list-error-text {
  font-size: 28rpx;
  color: var(--color-text-hint);
}

/* 任务卡片 */
.task-card {
  background-color: var(--color-card);
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 12rpx 20rpx 4rpx;
  margin: 0 32rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 187, 120, 0.06);
}

/* 列表首尾卡片的圆角/间距微调（与日程页列表一致） */
.task-card:first-child {
  margin-top: 8rpx;
}

/* 复选框点击热区（视觉 44rpx，热区 ~84rpx） */
.task-check-hit {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.task-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  border: 3rpx solid #d0d0d0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
}

.task-check.check-done {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}

.task-check.check-loading {
  opacity: 0.6;
}

.check-icon-done {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
  line-height: 1;
}

.loading-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

/* 任务内容 */
.task-body {
  flex: 1;
  min-width: 0;
}

.task-name-row {
  margin-bottom: 8rpx;
}

.task-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.task-name.name-done {
  text-decoration: line-through;
  color: var(--color-text-hint);
}

.task-name.name-overdue {
  color: var(--color-danger);
}

/* 任务元信息 */
.task-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.assignee-tag {
  font-size: 22rpx;
  color: var(--color-primary);
  background-color: #eaf7ec;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.due-tag {
  font-size: 22rpx;
  color: var(--color-text-hint);
  background-color: var(--color-bg);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.due-tag.due-overdue {
  color: var(--color-danger);
  background-color: #fff5f5;
}

/* 进入详情箭头 */
.task-arrow {
  font-size: 40rpx;
  color: #c8c8c8;
  line-height: 1;
  flex-shrink: 0;
  margin-left: 8rpx;
  padding: 0 8rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 30rpx;
  color: var(--color-text-secondary);
}

.empty-desc {
  font-size: 26rpx;
  color: var(--color-text-hint);
  margin-top: 16rpx;
  text-align: center;
  padding: 0 60rpx;
  line-height: 1.6;
}

.empty-actions {
  margin-top: 48rpx;
  width: 60%;
  display: flex;
  flex-direction: column;
}

/* 与日程页「新建日程」按钮一致：行内、自适应宽度的小号主按钮 */
.empty-actions-row {
  flex-direction: row;
  justify-content: center;
  gap: 24rpx;
  width: auto;
}

.btn-sm {
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  padding: 0 40rpx;
}

/* ---------- 成员范围弹层（与日程页一致） ---------- */

.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  background-color: var(--color-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  overflow-y: auto;
}

.sheet-header {
  padding: 8rpx 0 20rpx;
  text-align: center;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.sheet-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 12rpx;
  border-radius: 18rpx;
}

.sheet-option-active {
  background-color: #eaf7ec;
}

.sheet-avatar-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.sheet-avatar {
  width: 100%;
  height: 100%;
}

.sheet-avatar-all {
  background-color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-avatar-all-text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 600;
}

.sheet-option-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-check {
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.sheet-cancel {
  margin-top: 16rpx;
  padding: 24rpx 0 8rpx;
  text-align: center;
  border-top: 2rpx solid rgba(0, 0, 0, 0.05);
}

.sheet-cancel-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 悬浮新增按钮样式已统一到全局 app.wxss */
