<!-- 家庭详情页 -->
<view class="container">
  <!-- 家庭资料卡 -->
  <view class="card family-card">
    <image
      class="family-avatar"
      src="{{detail.avatarUrl || '/assets/images/default-family.png'}}"
      mode="aspectFill"
    />
    <text class="family-name">{{detail.name}}</text>
    <text class="family-sub">{{detail.memberCount}} 位成员 · {{detail.currentUserRole === 'admin' ? '管理员' : '成员'}}</text>

    <view wx:if="{{detail.currentUserRole === 'admin'}}" class="edit-profile-btn" bindtap="onEditProfile">
      <text class="edit-profile-text">编辑家庭资料</text>
    </view>
  </view>

  <!-- 家庭管理 -->
  <view class="card group">
    <view class="menu-item" bindtap="onViewMembers">
      <text class="menu-text">家庭成员</text>
      <view class="menu-right">
        <text class="menu-count">{{detail.memberCount}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view wx:if="{{detail.currentUserRole === 'admin'}}" class="menu-item" bindtap="onViewInvites">
      <text class="menu-text">邀请家人加入</text>
      <text class="arrow">›</text>
    </view>
    <view wx:if="{{detail.currentUserRole === 'admin'}}" class="menu-item" bindtap="onViewIntegrations">
      <text class="menu-text">外部系统</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 危险操作 -->
  <view class="card group">
    <view class="menu-item menu-item-danger" bindtap="onLeave">
      <text class="menu-text text-danger">{{leaving ? '退出中...' : '退出家庭'}}</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
