<!-- 家庭邀请管理页 -->
<view class="container">
  <nav-bar title="家庭邀请" showBack="true" />

  <view class="header">
    <text class="title">邀请家人加入</text>
    <text class="subtitle">生成邀请后，发送微信分享卡片给家人，点击即可进入加入家庭页。</text>
  </view>

  <!-- 生成成功：分享卡片 -->
  <view wx:if="{{newInvite}}" class="card invite-card">
    <text class="card-label">邀请已生成</text>

    <view class="invite-meta">
      <text class="meta-line">有效期至 {{newInviteView.expiresAtText}}</text>
      <text class="meta-line">{{newInviteView.usesText}}</text>
    </view>

    <view class="code-box">
      <text class="code-text">{{newInvite.code}}</text>
    </view>

    <button class="btn-primary share-btn" open-type="share">发送给微信好友</button>

    <view class="secondary-actions">
      <button class="btn-outline sm" bindtap="onCopyCode">复制邀请码（手动输入）</button>
    </view>

    <view class="regenerate" bindtap="onCreate">
      <text class="regenerate-text">重新生成邀请</text>
    </view>
  </view>

  <!-- 初始 / 生成中：生成入口 -->
  <view wx:else class="card">
    <button
      class="btn-primary"
      disabled="{{creating}}"
      bindtap="onCreate"
    >
      {{creating ? '正在生成邀请...' : '生成邀请'}}
    </button>
  </view>

  <!-- 邀请记录 -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">邀请记录</text>
    </view>

    <block wx:if="{{invites.length > 0}}">
      <view
        class="invite-item"
        wx:for="{{invites}}"
        wx:key="id"
      >
        <view class="invite-meta">
          <text class="invite-status status-{{item.status}}">{{item.statusText}}</text>
          <text class="invite-sub">{{item.subText}}</text>
        </view>
        <text
          wx:if="{{item.status === 'active'}}"
          class="action-link danger"
          data-id="{{item.id}}"
          bindtap="onRevoke"
        >撤销</text>
      </view>
    </block>

    <view wx:else class="empty-hint">
      <text class="empty-text">暂无邀请记录</text>
    </view>
  </view>
</view>
