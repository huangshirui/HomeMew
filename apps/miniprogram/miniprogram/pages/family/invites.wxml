<!-- 家庭邀请管理页：小程序码图片优先，纯邀请码作为备用方式 -->
<view class="container">
  <nav-bar title="家庭邀请" showBack="{{true}}" />

  <view class="header">
    <text class="title">邀请家人加入</text>
    <text class="subtitle">选择一种邀请方式，家人确认后即可加入。</text>
  </view>

  <view wx:if="{{newInvite}}" class="card invite-card">
    <view class="invite-head">
      <text class="card-label">邀请已生成</text>
      <text class="invite-state {{newInviteAvailable ? 'invite-active' : 'invite-invalid'}}">{{newInviteAvailable ? '有效' : '已失效'}}</text>
    </view>
    <text class="invite-meta">有效期至 {{newInviteView.expiresAtText}} · {{newInviteView.usesText}}</text>

    <!-- 生成小程序码后提供保存与全屏截图；不显示微信已限制的分享入口。 -->
    <button
      class="btn-primary share-btn"
      disabled="{{creating || sharing || !newInviteAvailable}}"
      bindtap="onGenerateMiniCode"
    >{{sharing ? '正在生成小程序码...' : '生成小程序码图片'}}</button>
    <text class="share-hint">生成后可保存图片，或点击二维码全屏截图，再从微信聊天发送。</text>

    <view class="invite-divider">
      <view class="divider-line" />
      <text class="divider-label">或使用邀请码</text>
      <view class="divider-line" />
    </view>

    <view class="code-section">
      <text class="code-text" selectable="{{true}}">{{newInvite.code}}</text>
      <button
        class="btn-outline copy-btn"
        disabled="{{creating || !newInviteAvailable}}"
        bindtap="onCopyCode"
      >复制邀请码</button>
    </view>
    <text class="code-hint">家人打开家事喵，在「家庭管理 → 加入家庭」中粘贴邀请码。</text>
    <text wx:if="{{!newInviteAvailable}}" class="invite-warning">当前邀请不可再使用，请生成新邀请。</text>

    <view class="regenerate" bindtap="onCreate">
      <text class="regenerate-text">{{creating ? '正在生成...' : '再生成一个邀请'}}</text>
    </view>
  </view>

  <view wx:else class="card create-card">
    <text class="create-hint">生成邀请后，可查看并保存小程序码，或复制邀请码。</text>
    <button
      class="btn-primary"
      disabled="{{creating}}"
      bindtap="onCreate"
    >{{creating ? '正在生成邀请...' : '生成邀请'}}</button>
  </view>

  <view class="card">
    <view class="section-header">
      <text class="section-title">邀请记录</text>
    </view>
    <block wx:if="{{invites.length > 0}}">
      <view class="invite-item" wx:for="{{invites}}" wx:key="id">
        <view class="invite-item-meta">
          <text class="invite-status status-{{item.status}}">{{item.statusText}}</text>
          <text class="invite-sub">{{item.subText}}</text>
        </view>
        <text
          wx:if="{{item.status === 'active'}}"
          class="action-link danger"
          data-id="{{item.id}}"
          bindtap="onRevoke"
        >撤销</text>
      </view>
    </block>
    <view wx:else class="empty-hint">
      <text class="empty-text">暂无邀请记录</text>
    </view>
  </view>
</view>

<!-- 生成图片后展示，仅提供可用的相册保存、全屏截图与邀请码备用方案。 -->
<view wx:if="{{qrVisible}}" class="qr-overlay" catchtap="onCloseMiniCode">
  <view class="qr-sheet" catchtap="onStopQrTap">
    <text class="qr-title">家庭邀请小程序码</text>
    <image class="qr-image" src="{{qrCodePath}}" mode="aspectFit" bindtap="onPreviewMiniCode" />
    <text class="qr-preview-hint">点击图片可全屏查看，必要时可截图发送给微信好友</text>
    <text class="qr-caption">让家人用微信扫一扫，确认家庭信息后加入。</text>
    <text wx:if="{{qrCodeVersion === 'trial'}}" class="qr-trial-tip">当前二维码指向体验版，需要先上传体验版并添加体验成员。</text>
    <button class="btn-primary qr-action" bindtap="onSaveMiniCode" disabled="{{savingAlbum}}">{{savingAlbum ? '正在保存...' : '保存图片到相册'}}</button>
    <button wx:if="{{albumPermissionRequired}}" class="btn-outline qr-action" open-type="openSetting" bindopensetting="onAlbumSettingChanged">开启相册权限</button>
    <text class="qr-backup-hint">无法保存时，可点二维码全屏预览并截图发送；也可关闭后复制邀请码。</text>
    <view class="qr-close" bindtap="onCloseMiniCode">关闭</view>
  </view>
</view>
