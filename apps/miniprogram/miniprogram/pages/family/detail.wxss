/* 家庭详情页样式 */
.family-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 40rpx;
}

.family-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background-color: var(--color-bg);
  margin-bottom: 24rpx;
}

.family-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.family-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-hint);
}

.edit-profile-btn {
  margin-top: 28rpx;
  padding: 14rpx 40rpx;
  background-color: var(--color-primary);
  border-radius: 32rpx;
}

.edit-profile-text {
  font-size: 28rpx;
  color: #ffffff;
}

/* 分组 */
.group {
  margin-top: 20rpx;
  padding: 0 8rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 16rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-count {
  font-size: 28rpx;
  color: var(--color-text-hint);
}

.arrow {
  font-size: 32rpx;
  color: #cccccc;
}

.text-danger {
  color: var(--color-danger);
}

.menu-item-danger .arrow {
  color: #cccccc;
}
