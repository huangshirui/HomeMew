/* 家庭详情页样式 */
.family-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 40rpx;
}

.family-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background-color: var(--color-bg);
  margin-bottom: 24rpx;
}

.family-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.family-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-hint);
}

.edit-profile-btn {
  margin-top: 28rpx;
  padding: 14rpx 40rpx;
  background-color: var(--color-primary);
  border-radius: 32rpx;
}

.edit-profile-text {
  font-size: 28rpx;
  color: #ffffff;
}

/* 分组 */
.group {
  margin-top: 20rpx;
  padding: 0 8rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 16rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-count {
  font-size: 28rpx;
  color: var(--color-text-hint);
}

.arrow {
  font-size: 32rpx;
  color: #cccccc;
}

.text-danger {
  color: var(--color-danger);
}

.menu-item-danger .arrow {
  color: #cccccc;
}

.family-sheet-layer { position: fixed; inset: 0; z-index: 100; }
.family-sheet-mask { position: absolute; inset: 0; background: rgba(0,0,0,.45); animation: family-mask-in .2s ease-out; }
.family-sheet { position: absolute; bottom: 0; left: 0; right: 0; background: var(--color-card); border-radius: 32rpx 32rpx 0 0; padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom)); max-height: 75vh; box-sizing: border-box; animation: family-sheet-in .24s ease-out; }
.family-sheet-header { padding: 16rpx 0 24rpx; text-align: center; }
.family-sheet-handle { width: 64rpx; height: 8rpx; background: var(--color-border); border-radius: 8rpx; margin: 0 auto 24rpx; }
.family-sheet-title { font-size: 32rpx; font-weight: 600; }
.family-sheet-list { max-height: 50vh; }
.family-choice { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 16rpx; height: 120rpx; box-sizing: border-box; border-radius: 18rpx; }
.family-choice-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 30rpx; }
.family-choice-current, .family-choice-hover { background: var(--color-primary-tint); }
.family-choice-check { flex-shrink: 0; color: var(--color-primary); font-size: 25rpx; }
.family-sheet-cancel { margin-top: 24rpx; background: var(--color-bg); color: var(--color-text-secondary); border-radius: 20rpx; font-size: 28rpx; }
.family-sheet-cancel::after { border: none; }
@keyframes family-mask-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes family-sheet-in { from { transform: translateY(100%); } to { transform: translateY(0); } }
.action-link { margin-top: 18rpx; background: var(--color-primary-tint); color: var(--color-primary); font-size: 26rpx; }
.family-actions { display: flex; gap: 18rpx; }
.family-actions button { flex: 1; font-size: 28rpx; }
.empty-family { display: flex; flex-direction: column; align-items: center; gap: 18rpx; }
.empty-family image { width: 220rpx; height: 180rpx; }
