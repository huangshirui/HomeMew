/* 编辑家庭资料页样式 */
.avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 32rpx;
}

.family-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background-color: var(--color-border);
}

.avatar-tip {
  margin-top: 20rpx;
}

.avatar-tip-text {
  font-size: 24rpx;
  color: var(--color-primary);
}

.field {
  padding: 20rpx 28rpx 32rpx;
  border-top: 2rpx solid var(--color-divider);
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-hint);
  margin-bottom: 12rpx;
}

.field-input {
  height: 80rpx;
  background-color: var(--color-primary-tint);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.field-control {
  display: block;
  margin: 0 -28rpx -32rpx;
}

.save-btn {
  margin-top: 40rpx;
}

.btn-primary {
  width: 100%;
}
