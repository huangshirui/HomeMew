/* 编辑家庭资料页样式 */
.avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 32rpx;
}

.family-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background-color: #f0f0f0;
}

.avatar-tip {
  margin-top: 20rpx;
}

.avatar-tip-text {
  font-size: 24rpx;
  color: #4CAF50;
}

.field {
  padding: 20rpx 28rpx 32rpx;
  border-top: 2rpx solid #f5f5f5;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.field-input {
  height: 80rpx;
  background-color: #f7f8f9;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333333;
}

.save-btn {
  margin-top: 40rpx;
}

.btn-primary {
  width: 100%;
}
