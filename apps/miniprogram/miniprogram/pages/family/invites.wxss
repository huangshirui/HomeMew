/* 家庭邀请管理页样式 */
.header {
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-top: 4rpx;
  margin-bottom: 8rpx;
}

.new-invite {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-divider);
}

.new-invite-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-primary);
  margin-bottom: 12rpx;
}

.code-box {
  background-color: var(--color-bg);
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.code-text {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: var(--color-text-primary);
}

.new-invite-actions {
  display: flex;
  gap: 16rpx;
}

.btn-outline.sm {
  flex: 1;
  height: 72rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  border-radius: 36rpx;
}

.section-header {
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.invite-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.invite-item:last-child {
  border-bottom: none;
}

.invite-meta {
  display: flex;
  flex-direction: column;
}

.invite-status {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.invite-status.status-active {
  color: var(--color-primary);
}

.invite-status.status-revoked,
.invite-status.status-expired,
.invite-status.status-exhausted {
  color: var(--color-text-hint);
}

.invite-sub {
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-top: 4rpx;
}

.action-link {
  font-size: 26rpx;
  color: var(--color-danger);
}

.empty-hint {
  padding: 32rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: var(--color-text-hint);
}
