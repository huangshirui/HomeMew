/* 家庭邀请页：突出主分享、收起邀请码、避免三按钮并列 */
.header {
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-hint);
}

.invite-card { margin-bottom: 20rpx; }

.invite-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.card-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.invite-state {
  font-size: 22rpx;
  border-radius: 24rpx;
  padding: 6rpx 14rpx;
}

.invite-active {
  color: var(--color-primary);
  background: var(--color-bg);
}

.invite-invalid {
  color: var(--color-danger);
  background: var(--color-bg);
}

.invite-meta {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-hint);
  margin-bottom: 24rpx;
}

.share-btn { width: 100%; }

.share-hint, .code-hint, .create-hint {
  display: block;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--color-text-hint);
}

.share-hint {
  margin-top: 12rpx;
  text-align: center;
}

.invite-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 0 20rpx;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: var(--color-divider);
}

.divider-label {
  color: var(--color-text-hint);
  font-size: 24rpx;
  white-space: nowrap;
}

.code-section {
  background: var(--color-bg);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
}

.code-text {
  display: block;
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  overflow-wrap: anywhere;
  color: var(--color-text-primary);
}

.copy-btn {
  margin: 16rpx auto 0;
  height: 72rpx;
  width: 100%;
  line-height: 68rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.code-hint { margin-top: 12rpx; }

.invite-warning {
  display: block;
  margin-top: 16rpx;
  color: var(--color-danger);
  font-size: 24rpx;
}

.regenerate {
  margin-top: 26rpx;
  text-align: center;
  padding: 10rpx;
}

.regenerate-text { font-size: 25rpx; color: var(--color-text-hint); }
.create-hint { margin-bottom: 20rpx; }

.section-header { margin-bottom: 12rpx; }
.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.invite-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--color-divider);
}
.invite-item:last-child { border-bottom: none; }
.invite-item-meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.invite-status {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}
.invite-status.status-active { color: var(--color-primary); }
.invite-status.status-revoked,
.invite-status.status-expired,
.invite-status.status-exhausted { color: var(--color-text-hint); }
.invite-sub {
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-top: 4rpx;
}
.action-link { font-size: 26rpx; color: var(--color-danger); }
.empty-hint { padding: 32rpx 0; text-align: center; }
.empty-text { font-size: 26rpx; color: var(--color-text-hint); }
