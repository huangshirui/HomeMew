.domain-filters{white-space:nowrap;margin:0 0 20rpx}.chip-row{display:flex;gap:12rpx}.domain-chip{flex:none;border-radius:30rpx;background:white;color:#6f7974;padding:13rpx 24rpx;font-size:25rpx}.domain-chip.selected{background:var(--color-primary);color:white}.domain-list{padding:0 22rpx}.domain-row{display:flex;gap:20rpx;align-items:center;padding:25rpx 4rpx;border-bottom:1rpx solid var(--color-divider)}.domain-row:last-child{border:0}.record-symbol{width:54rpx;height:54rpx;border-radius:16rpx;background:var(--color-primary-tint);display:flex;align-items:center;justify-content:center;font-size:31rpx;flex-shrink:0}.record-symbol-img{width:100%;height:100%;border-radius:16rpx}.record-info{min-width:0;flex:1}.record-title-row{display:flex;gap:12rpx;align-items:center}.record-title{font-size:29rpx;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.record-status{font-size:21rpx;color:#60786a;background:#eef5ee;padding:4rpx 11rpx;border-radius:12rpx;flex:none}.record-description{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:23rpx;color:var(--color-text-secondary)}.record-meta{display:block;margin-top:5rpx;font-size:22rpx;color:var(--color-text-secondary)}.record-chevron{font-size:35rpx;color:#b2bcb5}.search-panel{padding:20rpx}.search-row{display:flex;justify-content:space-between;align-items:center;gap:14rpx}.search-row input{flex:1;min-width:0;border:1rpx solid var(--color-border);border-radius:14rpx;height:76rpx;padding:0 16rpx}.search-row view{color:var(--color-primary)}.search-person{padding:18rpx 4rpx;border-top:1rpx solid var(--color-border);margin-top:16rpx}.search-reset{font-size:23rpx;color:var(--color-text-secondary);margin-top:14rpx}.domain-empty{display:flex;flex-direction:column;gap:18rpx;align-items:center;text-align:center;color:#8b978c}.page-footer{color:#929e93;padding:30rpx;text-align:center;font-size:24rpx}
/* Match the shared list UX: one navigation title and a lower-right create action. */
.header-filter { position:relative; display:flex; align-items:center; justify-content:center; width:72rpx; height:72rpx; margin-right:12rpx; border:1rpx solid var(--color-border); border-radius:20rpx; background:var(--color-card); box-sizing:border-box; }
.header-filter-active, .header-filter-hover { background:var(--color-primary-tint); border-color:#c9dfcc; }
.filter-indicator { position:absolute; top:12rpx; right:12rpx; width:9rpx; height:9rpx; border-radius:50%; background:var(--color-primary); border:3rpx solid var(--color-card); }
.search-input { display:flex; align-items:center; gap:14rpx; flex:1; min-width:0; border:1rpx solid var(--color-border); border-radius:18rpx; padding:0 20rpx; background:var(--color-bg); }
.search-input input { flex:1; min-width:0; border:0; border-radius:0; height:76rpx; padding:0; font-size:27rpx; }
.search-submit { flex-shrink:0; margin:0; padding:0 24rpx; height:76rpx; line-height:76rpx; font-size:26rpx; color:var(--color-primary-dark); background:var(--color-primary-tint); border-radius:18rpx; }
.search-submit::after { border:0; }
.fab.domain-fab { display:flex; align-items:center; justify-content:center; width:92rpx; height:92rpx; line-height:normal; bottom:calc(48rpx + env(safe-area-inset-bottom)); }
.fab-plus { position:relative; width:34rpx; height:34rpx; flex-shrink:0; }
.fab-plus-line { position:absolute; left:50%; top:50%; border-radius:4rpx; background:#fff; transform:translate(-50%,-50%); }
.fab-plus-horizontal { width:34rpx; height:4rpx; }
.fab-plus-vertical { width:4rpx; height:34rpx; }
