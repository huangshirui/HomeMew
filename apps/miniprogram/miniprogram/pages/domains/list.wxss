.domain-page{padding-top:0}.domain-toolbar{display:flex;align-items:center;justify-content:space-between;padding:22rpx 4rpx}.domain-heading{font-weight:600;font-size:36rpx}.domain-tools{display:flex;gap:16rpx;align-items:center}.tool-btn{display:flex;gap:8rpx;color:var(--color-primary);padding:12rpx 16rpx;background:#fff;border-radius:20rpx;font-size:25rpx}.add-btn{background:var(--color-primary);color:white;padding:13rpx 24rpx;border-radius:22rpx;font-size:26rpx}.domain-filters{white-space:nowrap;margin:0 0 20rpx}.chip-row{display:flex;gap:12rpx}.domain-chip{flex:none;border-radius:30rpx;background:white;color:#6f7974;padding:13rpx 24rpx;font-size:25rpx}.domain-chip.selected{background:var(--color-primary);color:white}.domain-list{padding:0 22rpx}.domain-row{display:flex;gap:20rpx;align-items:center;padding:25rpx 4rpx;border-bottom:1rpx solid var(--color-divider)}.domain-row:last-child{border:0}.record-symbol{width:54rpx;height:54rpx;border-radius:16rpx;background:var(--color-primary-tint);display:flex;align-items:center;justify-content:center;font-size:31rpx;flex-shrink:0}.record-info{min-width:0;flex:1}.record-title-row{display:flex;gap:12rpx;align-items:center}.record-title{font-size:29rpx;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.record-status{font-size:21rpx;color:#60786a;background:#eef5ee;padding:4rpx 11rpx;border-radius:12rpx;flex:none}.record-description{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:23rpx;color:var(--color-text-secondary)}.record-meta{display:block;margin-top:5rpx;font-size:22rpx;color:var(--color-text-secondary)}.record-chevron{font-size:35rpx;color:#b2bcb5}.search-panel{padding:20rpx}.search-row{display:flex;justify-content:space-between;align-items:center;gap:14rpx}.search-row input{flex:1;min-width:0;border:1rpx solid var(--color-border);border-radius:14rpx;height:76rpx;padding:0 16rpx}.search-row view{color:var(--color-primary)}.search-person{padding:18rpx 4rpx;border-top:1rpx solid var(--color-border);margin-top:16rpx}.search-reset{font-size:23rpx;color:var(--color-text-secondary);margin-top:14rpx}.domain-empty{display:flex;flex-direction:column;gap:18rpx;align-items:center;text-align:center;color:#8b978c}.page-footer{color:#929e93;padding:30rpx;text-align:center;font-size:24rpx}