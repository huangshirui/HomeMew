.workspace-summary{padding:28rpx}.workspace-head{display:flex;align-items:center;gap:16rpx}.workspace-icon{width:60rpx;height:60rpx;font-size:39rpx;background:#eaf6eb;border-radius:15rpx;text-align:center;line-height:60rpx}.workspace-name{font-size:37rpx;flex:1;min-width:0;font-weight:600}.menu-dot{color:#657469;padding:12rpx;font-size:38rpx}.workspace-status{display:inline-block;color:#428252;background:#e9f5ea;border-radius:12rpx;font-size:23rpx;padding:5rpx 15rpx;margin-top:16rpx}.workspace-muted{color:#828f85;font-size:25rpx;margin-top:12rpx}.workspace-description{font-size:27rpx;color:#57635a;line-height:1.6;margin-top:18rpx}.workspace-tabs{margin-bottom:20rpx;white-space:nowrap}.workspace-tabs-inner{display:flex;gap:12rpx}.workspace-tab{padding:15rpx 22rpx;font-size:26rpx;background:white;border-radius:20rpx;color:#7b887e}.workspace-tab.active{background:var(--color-primary);color:white}.workspace-section{font-weight:600;font-size:30rpx;display:flex;align-items:center;justify-content:space-between;margin-bottom:17rpx}.workspace-count{font-size:22rpx;font-weight:400;color:#879589}.shortcut-grid{display:flex;gap:16rpx;margin-bottom:20rpx}.shortcut{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:8rpx;background:#f4f9f5;border-radius:20rpx;padding:22rpx 5rpx;text-align:center;font-size:24rpx;color:#50885b}.shortcut text:first-child{font-size:35rpx}.soft-link{color:var(--color-primary);font-size:25rpx;padding:14rpx 0}.more{text-align:center}.relation-row{display:flex;border-top:1rpx solid #edf1ef;padding:18rpx 0;align-items:center;gap:12rpx}.relation-body{display:flex;flex:1;align-items:center;gap:14rpx;min-width:0}.relation-type{font-size:21rpx;color:#839389;background:#f4f7f4;border-radius:12rpx;padding:5rpx 10rpx;flex-shrink:0}.relation-title{font-size:27rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.unlink{padding:12rpx;color:#c46767;font-size:36rpx}.streak-row{display:flex;justify-content:space-between;align-items:center;margin-top:24rpx;border-top:1rpx solid var(--color-border);padding-top:22rpx}.streak-value{font-size:53rpx;font-weight:700;color:#3c9850;margin-right:10rpx}.streak-unit{font-size:22rpx;color:#859088}.check-btn{border:0;border-radius:30rpx;color:#fff;background:var(--color-primary);padding:8rpx 24rpx;font-size:24rpx;margin:0}.check-btn[disabled]{background:#cbd8cc}.history-item{padding:15rpx 0;border-bottom:1rpx solid #eaf0eb}.mini-mask{position:fixed;inset:0;background:rgba(0,0,0,.36);z-index:100;display:flex;align-items:flex-end}.mini-sheet{width:100%;background:white;border-radius:30rpx 30rpx 0 0;padding:28rpx 32rpx calc(35rpx + env(safe-area-inset-bottom));box-sizing:border-box;max-height:80vh}.sheet-bar{width:80rpx;height:7rpx;border-radius:20rpx;background:#d5dfd7;margin:0 auto 22rpx}.sheet-input{border:1rpx solid #e2ebe4;background:#f9fcfa;border-radius:20rpx;padding:22rpx;margin-bottom:20rpx;font-size:26rpx}.cancel{padding:22rpx;text-align:center;color:#819084}.link-search{display:flex;gap:20rpx;align-items:center;margin-bottom:15rpx}.link-search input{flex:1;background:#f7faf8;padding:20rpx;border-radius:18rpx}.link-search text{color:var(--color-primary)}.candidates{max-height:40vh}.candidate{padding:20rpx;border-bottom:1rpx solid #edf1ef}.workspace .btn-primary{margin-top:18rpx;font-size:28rpx}