.domain-edit{padding-top:0}.icon-name{display:flex;align-items:center;gap:16rpx;margin-bottom:26rpx}.input-grow{flex:1;min-width:0}.field-label{display:block;color:#7d8781;font-size:25rpx;margin-bottom:12rpx}.input-grow input,.field-row input{font-size:29rpx;color:#222;padding:10rpx 0}.description-input{width:100%;min-height:118rpx;color:#333;font-size:27rpx;box-sizing:border-box}.field-row{min-height:94rpx;display:flex;align-items:center;justify-content:space-between;gap:20rpx;border-bottom:1rpx solid var(--color-border);font-size:27rpx}.field-row:last-child{border-bottom:0}.field-row text{color:var(--color-text-secondary)}.field-row input{text-align:right;max-width:220rpx}.field-hint{font-size:23rpx;color:var(--color-text-secondary);margin-top:15rpx;display:block}.person-pills{display:flex;gap:16rpx;flex-wrap:wrap}.person-pill{background:#f4f7f4;border:1rpx solid #e4ece5;border-radius:26rpx;padding:13rpx 22rpx;font-size:25rpx}.person-pill.chosen{background:var(--color-primary-tint);border-color:var(--color-primary);color:var(--color-primary)}.delete-link{text-align:center;color:var(--color-danger);border:0;background:none;font-size:26rpx;margin-top:30rpx}.delete-link::after{border:0}