/* 外部系统详情页样式 */

.loading-state {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-hint);
}

/* 主信息 */
.hero-card {
  padding: 32rpx 28rpx;
}

.hero-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-title {
  flex: 1;
  font-size: 38rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  word-break: break-all;
}

.hero-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.status-active {
  color: var(--color-primary-dark);
  background-color: rgba(45, 187, 120, 0.12);
}

.status-disabled {
  color: var(--color-text-hint);
  background-color: #f0f0f0;
}

.status-deleted {
  color: var(--color-danger);
  background-color: rgba(244, 67, 54, 0.1);
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.info-label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--color-text-hint);
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.info-actions {
  display: flex;
  gap: 40rpx;
  padding-top: 24rpx;
}

.action-link {
  font-size: 28rpx;
  color: var(--color-primary);
}

.action-link.danger {
  color: var(--color-danger);
}

/* 凭证区 */
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-hint {
  display: block;
  margin: 8rpx 0 16rpx;
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.cred-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.cred-info {
  flex: 1;
}

.cred-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cred-type {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.cred-mask {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-family: monospace;
}

.cred-status {
  font-size: 22rpx;
  color: var(--color-primary-dark);
}

.cred-status.revoked {
  color: var(--color-text-hint);
}

.cred-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.cred-empty {
  padding: 24rpx 0;
}

.cred-empty-text {
  font-size: 26rpx;
  color: var(--color-text-hint);
}

/* 生成凭证入口 */
.cred-create {
  margin-top: 16rpx;
}

.cred-create-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 2rpx solid var(--color-divider);
}

.cci-info {
  flex: 1;
}

.cci-title {
  display: block;
  font-size: 30rpx;
  color: var(--color-primary);
}

.cci-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.arrow {
  font-size: 40rpx;
  color: #cccccc;
}

/* 删除 */
.delete-row {
  display: flex;
  justify-content: center;
  padding: 12rpx 0;
}

.text-danger {
  color: var(--color-danger);
  font-size: 30rpx;
}
