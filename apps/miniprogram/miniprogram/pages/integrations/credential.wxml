<!-- 凭证一次性展示页 -->
<view class="container">
  <view wx:if="{{!loaded}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 安全提示 -->
    <view class="warn-card">
      <text class="warn-title">请立即保存凭证</text>
      <text wx:if="{{kind === 'oauth'}}" class="warn-text">Client Secret 关闭后无法再次查看，请先保存到外部系统。</text>
      <text wx:else class="warn-text">API Token 关闭后无法再次查看，请先保存到外部系统。</text>
    </view>

    <!-- OAuth 配置 -->
    <block wx:if="{{kind === 'oauth'}}">
      <view class="card">
        <text class="card-title">OAuth 2.0 · {{systemName}}</text>

        <view class="cfg-row">
          <text class="cfg-label">Token URL</text>
          <view class="cfg-value-row">
            <text class="cfg-value" selectable="true" user-select="true">{{tokenUrl}}</text>
            <text class="copy-btn" data-value="{{tokenUrl}}" bindtap="onCopy">复制</text>
          </view>
        </view>

        <view class="cfg-row">
          <text class="cfg-label">Grant Type</text>
          <view class="cfg-value-row">
            <text class="cfg-value">{{grantType}}</text>
          </view>
        </view>

        <view class="cfg-row">
          <text class="cfg-label">Client ID</text>
          <view class="cfg-value-row">
            <text class="cfg-value mono" selectable="true" user-select="true">{{clientId}}</text>
            <text class="copy-btn" data-value="{{clientId}}" bindtap="onCopy">复制</text>
          </view>
        </view>

        <view class="cfg-row">
          <text class="cfg-label">Client Secret</text>
          <view class="cfg-value-row">
            <text class="cfg-value mono secret" selectable="true" user-select="true">{{clientSecret}}</text>
            <text class="copy-btn" data-value="{{clientSecret}}" bindtap="onCopy">复制</text>
          </view>
        </view>
      </view>

      <!-- 接入示例 -->
      <view class="card">
        <text class="card-title">在 n8n 中接入</text>
        <text class="example-line">Credential Type：OAuth2 API</text>
        <text class="example-line">Grant Type：Client Credentials</text>
        <text class="example-line">Access Token URL：上方 Token URL</text>
        <text class="example-line">Client Authentication：Header / Basic</text>
      </view>
    </block>

    <!-- API Token 配置 -->
    <block wx:elif="{{kind === 'api_token'}}">
      <view class="card">
        <text class="card-title">API Token · {{systemName}}</text>

        <view class="cfg-row">
          <text class="cfg-label">API Base URL</text>
          <view class="cfg-value-row">
            <text class="cfg-value" selectable="true" user-select="true">{{apiBaseUrl}}</text>
            <text class="copy-btn" data-value="{{apiBaseUrl}}" bindtap="onCopy">复制</text>
          </view>
        </view>

        <view class="cfg-row">
          <text class="cfg-label">Authentication</text>
          <view class="cfg-value-row">
            <text class="cfg-value">{{authScheme}}</text>
          </view>
        </view>

        <view class="cfg-row">
          <text class="cfg-label">Token</text>
          <view class="cfg-value-row">
            <text class="cfg-value mono secret" selectable="true" user-select="true">{{token}}</text>
            <text class="copy-btn" data-value="{{token}}" bindtap="onCopy">复制</text>
          </view>
        </view>
      </view>

      <!-- 接入示例 -->
      <view class="card">
        <text class="card-title">通用 Bearer 接入</text>
        <text class="example-line mono">Authorization: Bearer &lt;API Token&gt;</text>
      </view>
    </block>

    <view class="footer">
      <button class="btn-outline" bindtap="onCopyAll">一键复制全部配置</button>
      <button class="btn-primary mt" bindtap="onDone">我已保存，返回</button>
    </view>
  </block>
</view>
