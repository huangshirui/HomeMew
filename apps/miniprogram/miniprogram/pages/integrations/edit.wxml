<!-- 创建 / 编辑外部系统页 -->
<view class="container">
  <view wx:if="{{!loaded}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 基本信息 -->
    <view class="card">
      <view class="field">
        <text class="field-label">系统名称</text>
        <input
          class="field-input"
          placeholder="例如：家庭 n8n"
          maxlength="100"
          value="{{name}}"
          bindinput="onNameInput"
        />
      </view>
      <view class="field">
        <text class="field-label">系统说明（可选）</text>
        <textarea
          class="field-textarea"
          placeholder="例如：用于家庭自动化"
          maxlength="500"
          value="{{description}}"
          bindinput="onDescInput"
        />
      </view>
    </view>

    <!-- 权限选择 -->
    <view class="card">
      <text class="section-title">授予权限</text>
      <text class="section-hint">勾选“创建和编辑”会自动包含对应的“查看”。</text>

      <!-- 家庭 -->
      <view class="perm-row" data-key="familyRead" bindtap="onTogglePerm">
        <view class="perm-info">
          <text class="perm-name">查看家庭基础信息</text>
        </view>
        <view class="checkbox {{permFamilyRead ? 'checked' : ''}}">
          <text wx:if="{{permFamilyRead}}" class="check-mark">✓</text>
        </view>
      </view>

      <view class="perm-group-label">日程</view>
      <view class="perm-row" data-key="eventsRead" bindtap="onTogglePerm">
        <view class="perm-info">
          <text class="perm-name">查看日程</text>
        </view>
        <view class="checkbox {{permEventsRead ? 'checked' : ''}}">
          <text wx:if="{{permEventsRead}}" class="check-mark">✓</text>
        </view>
      </view>
      <view class="perm-row" data-key="eventsWrite" bindtap="onTogglePerm">
        <view class="perm-info">
          <text class="perm-name">创建和编辑日程</text>
        </view>
        <view class="checkbox {{permEventsWrite ? 'checked' : ''}}">
          <text wx:if="{{permEventsWrite}}" class="check-mark">✓</text>
        </view>
      </view>

      <view class="perm-group-label">待办</view>
      <view class="perm-row" data-key="tasksRead" bindtap="onTogglePerm">
        <view class="perm-info">
          <text class="perm-name">查看待办</text>
        </view>
        <view class="checkbox {{permTasksRead ? 'checked' : ''}}">
          <text wx:if="{{permTasksRead}}" class="check-mark">✓</text>
        </view>
      </view>
      <view class="perm-row" data-key="tasksWrite" bindtap="onTogglePerm">
        <view class="perm-info">
          <text class="perm-name">创建和编辑待办</text>
        </view>
        <view class="checkbox {{permTasksWrite ? 'checked' : ''}}">
          <text wx:if="{{permTasksWrite}}" class="check-mark">✓</text>
        </view>
      </view>
    </view>

    <view class="footer">
      <button
        class="btn-primary"
        disabled="{{submitting}}"
        bindtap="onSubmit"
      >
        {{submitting ? '提交中...' : (isEdit ? '保存' : '创建外部系统')}}
      </button>
    </view>
  </block>
</view>
