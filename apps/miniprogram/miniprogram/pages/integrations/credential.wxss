/* 凭证一次性展示页样式 */

.loading-state {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-hint);
}

/* 安全警告 */
.warn-card {
  background-color: rgba(255, 152, 0, 0.1);
  border: 2rpx solid var(--color-warning);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.warn-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-warning);
  margin-bottom: 8rpx;
}

.warn-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

/* 配置行 */
.cfg-row {
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.cfg-row:last-child {
  border-bottom: none;
}

.cfg-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-bottom: 10rpx;
}

.cfg-value-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cfg-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
  word-break: break-all;
}

.cfg-value.mono {
  font-family: monospace;
}

.cfg-value.secret {
  color: var(--color-primary-dark);
}

.copy-btn {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--color-primary);
  padding: 6rpx 20rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: 24rpx;
}

/* 示例 */
.example-line {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
}

.example-line.mono {
  font-family: monospace;
  word-break: break-all;
}

/* 底部 */
.footer {
  margin-top: 32rpx;
  padding: 0 8rpx;
}

.mt {
  margin-top: 20rpx;
}
