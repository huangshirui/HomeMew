<!-- 外部系统列表页 -->
<view class="container">
  <view wx:if="{{!loaded}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <view class="intro">
      <text class="intro-text">可将 n8n、Agent、Home Assistant 或其他应用连接到本家庭，让外部系统以独立身份访问家庭日程与待办。</text>
    </view>

    <!-- 列表 -->
    <block wx:if="{{integrations.length > 0}}">
      <view
        class="card sys-item"
        wx:for="{{integrations}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onTapItem"
      >
        <view class="sys-top">
          <text class="sys-name">{{item.name}}</text>
          <text class="sys-status status-{{item.status}}">{{item.statusText}}</text>
        </view>
        <text class="sys-perm">权限：{{item.permissionSummary}}</text>
        <text class="sys-used">{{item.lastUsedText}}</text>
        <text class="arrow">›</text>
      </view>
    </block>

    <!-- 空状态 -->
    <view wx:else class="empty">
      <text class="empty-title">尚未接入外部系统</text>
      <text class="empty-desc">可将 n8n、Agent、Home Assistant 或其他应用连接到本家庭。</text>
    </view>

    <view class="footer">
      <button class="btn-primary" bindtap="onCreate">添加外部系统</button>
    </view>
  </block>
</view>
