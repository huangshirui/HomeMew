.entry-hover { opacity: .65; }
.load-error { padding: 20rpx; color: var(--color-danger); font-size: 25rpx; text-align: center; }
.more-group { margin-top: 28rpx; }
.more-group-label { font-size: 27rpx; font-weight: 600; margin-bottom: 16rpx; color: #607269; padding-left: 6rpx; }
.tile-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18rpx; }
.more-tile { background: var(--color-card); border-radius: 26rpx; display: flex; min-width: 0; flex-direction: column; align-items: center; justify-content: center; padding: 25rpx 6rpx 21rpx; box-shadow: 0 4rpx 16rpx rgba(67,160,71,.06); }
.tile-icon { width: 79rpx; height: 79rpx; display: flex; justify-content: center; align-items: center; background: var(--color-bg); border-radius: 24rpx; font-size: 40rpx; margin-bottom: 12rpx; }
.tile-name { font-size: 25rpx; color: #2c3f32; text-align: center; }

.first-group { margin-top: 0; }
.brand-icon { width: 64rpx; height: 64rpx; }
.tile-name { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
