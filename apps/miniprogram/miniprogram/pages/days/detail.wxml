<!-- 日子详情页 -->
<view class="container days-detail-root">
  <nav-bar title="日子详情" showBack="true" />

  <scroll-view
    class="days-detail-scroll"
    scroll-y
    enable-flex
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
  <!-- 加载失败 -->
  <view wx:if="{{loadError}}" class="load-error-state">
    <text class="load-error-text">加载失败</text>
    <button class="btn-outline btn-sm" bindtap="onRetry">重新加载</button>
  </view>

  <view wx:elif="{{!loaded}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 头部：名称 + 主状态 -->
    <view class="hero attention-{{attentionLevel}}">
      <view class="hero-top">
        <view class="hero-icon">{{icon}}</view>
        <view class="hero-title-box">
          <text class="hero-name">{{name}}</text>
          <text wx:if="{{status === 'archived'}}" class="hero-archived">已归档</text>
        </view>
      </view>
      <text class="hero-primary">{{primaryText}}</text>
      <text wx:if="{{secondaryText}}" class="hero-secondary">{{secondaryText}}</text>
    </view>

    <!-- 信息 -->
    <view class="card">
      <view wx:for="{{metaRows}}" wx:key="label" class="meta-row">
        <text class="meta-label">{{item.label}}</text>
        <text class="meta-value">{{item.value}}</text>
      </view>
    </view>

    <!-- 说明 -->
    <view wx:if="{{description}}" class="card">
      <text class="meta-label">说明</text>
      <text class="desc-text">{{description}}</text>
    </view>

    <!-- 主操作：记录一次（countdown 与已归档不显示） -->
    <button
      wx:if="{{canRecord}}"
      class="btn-primary record-btn"
      disabled="{{submitting}}"
      bindtap="onOpenSheet"
    >{{actionText}}</button>

    <!-- 记录历史（countdown 不显示） -->
    <view wx:if="{{kind !== 'countdown'}}" class="card">
      <view class="section-header">
        <text class="section-title">记录历史</text>
        <text wx:if="{{occurrencesLoading}}" class="inline-spin">↻</text>
      </view>

      <block wx:if="{{occurrences.length > 0}}">
        <view wx:for="{{occurrences}}" wx:key="id" class="occ-item">
          <text class="occ-date">{{item.dateText}}</text>
          <text wx:if="{{item.intervalText}}" class="occ-interval">{{item.intervalText}}</text>
          <text wx:if="{{item.recorderText}}" class="occ-meta">{{item.recorderText}}</text>
          <text wx:if="{{item.noteText}}" class="occ-meta">{{item.noteText}}</text>
        </view>
        <view wx:if="{{occurrencesHasMore}}" class="occ-more" bindtap="onLoadMoreOccurrences">
          <text class="empty-link">{{occurrencesLoadingMore ? '加载中...' : '加载更多'}}</text>
        </view>
      </block>
      <view wx:elif="{{!occurrencesLoading}}" class="empty-hint">
        <text class="empty-text">还没有记录</text>
      </view>
    </view>

    <!-- 次级操作 -->
    <view class="card actions-card">
      <button
        wx:if="{{status === 'active'}}"
        class="btn-outline action-btn"
        disabled="{{submitting}}"
        bindtap="onEdit"
      >编辑</button>
      <button
        wx:if="{{status === 'active'}}"
        class="btn-outline action-btn"
        disabled="{{submitting}}"
        bindtap="onArchive"
      >归档</button>
      <button
        wx:if="{{status === 'archived'}}"
        class="btn-outline action-btn"
        disabled="{{submitting}}"
        bindtap="onRestore"
      >恢复</button>
      <button
        class="btn-outline danger action-btn"
        disabled="{{submitting}}"
        bindtap="onDelete"
      >删除</button>
    </view>
  </block>
  </scroll-view>

  <!-- 记录 occurrence 弹层 -->
  <view wx:if="{{sheetOpen}}" class="sheet-mask" bindtap="onCloseSheet">
    <view class="sheet" catchtap="noop">
      <text class="sheet-title">{{actionText}}</text>

      <picker
        mode="date"
        value="{{sheetDate}}"
        start="{{sheetMinDate}}"
        end="{{sheetMaxDate}}"
        bindchange="onSheetDateChange"
      >
        <view class="sheet-row">
          <text class="sheet-label">记录日期</text>
          <view class="sheet-value">
            <text class="sheet-text">{{sheetDate}}</text>
            <text class="sheet-arrow">›</text>
          </view>
        </view>
      </picker>

      <view class="sheet-row column">
        <text class="sheet-label">备注</text>
        <textarea
          class="sheet-textarea"
          value="{{sheetNote}}"
          bindinput="onSheetNoteInput"
          placeholder="选填"
          maxlength="200"
          auto-height
        />
      </view>

      <view class="sheet-actions">
        <button class="btn-outline sheet-btn" disabled="{{submitting}}" bindtap="onCloseSheet">取消</button>
        <button
          class="btn-primary sheet-btn"
          disabled="{{submitting}}"
          bindtap="onSubmitOccurrence"
        >{{submitting ? '记录中...' : '确定'}}</button>
      </view>
    </view>
  </view>
</view>
