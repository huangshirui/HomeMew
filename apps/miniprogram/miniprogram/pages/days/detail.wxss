/* 日子详情页 */

/* 下拉刷新容器：nav-bar 在容器外固定，仅内容区可下拉刷新 */
.days-detail-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.days-detail-scroll {
  flex: 1;
  min-height: 0;
}

/* 头部 */
.hero {
  background-color: var(--color-card);
  border-radius: 30rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(67, 160, 71, 0.06);
  border-left: 10rpx solid var(--color-primary);
}

.hero.attention-info {
  border-left-color: var(--color-info);
}

.hero.attention-warning {
  border-left-color: var(--color-warning);
}

.hero.attention-critical {
  border-left-color: var(--color-danger);
}

.hero-top {
  display: flex;
  align-items: center;
}

.hero-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background-color: var(--color-primary-tint);
  font-size: 38rpx;
  line-height: 76rpx;
  text-align: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.hero-title-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-archived {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  background-color: #f0f2f1;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.hero-primary {
  display: block;
  margin-top: 24rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.2;
}

.hero.attention-warning .hero-primary {
  color: var(--color-warning);
}

.hero.attention-critical .hero-primary {
  color: var(--color-danger);
}

.hero-secondary {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 信息行 */
.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.meta-row:last-child {
  border-bottom: none;
}

.meta-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.meta-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  text-align: right;
  margin-left: 24rpx;
}

.desc-text {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.7;
}

/* 主操作按钮 */
.record-btn {
  margin-bottom: 22rpx;
}

/* 记录历史 */
.occ-item {
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.occ-item:last-child {
  border-bottom: none;
}

.occ-date {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.occ-interval {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--color-primary);
}

.occ-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.occ-more {
  padding: 20rpx 0 4rpx;
  text-align: center;
}

/* 次级操作 */
.actions-card {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.action-btn {
  flex: 1;
  min-width: 200rpx;
  height: 78rpx;
  line-height: 78rpx;
  font-size: 28rpx;
}

/* occurrence 弹层 */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 60;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  padding-bottom: 12rpx;
}

.sheet-row {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.sheet-row.column {
  flex-direction: column;
  align-items: stretch;
  padding: 20rpx 0;
}

.sheet-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.sheet-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.sheet-text {
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.sheet-arrow {
  font-size: 32rpx;
  color: #cccccc;
}

.sheet-textarea {
  width: 100%;
  margin-top: 14rpx;
  min-height: 100rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.sheet-btn {
  flex: 1;
}
