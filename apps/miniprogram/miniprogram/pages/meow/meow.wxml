<!-- 喵一下：自然语言起草表单 -->

<view class="meow-container">

  <!-- 输入区：只有一个文本框 -->
  <view class="meow-card">
    <view class="meow-head">
      <text class="meow-emoji">🪄</text>
      <text class="meow-title">说一句话，帮你起草</text>
    </view>
    <textarea
      class="meow-input {{submitting ? 'is-locked' : ''}}"
      placeholder="例如：明天下午3点和爸妈视频通话，提醒我一下"
      placeholder-class="meow-placeholder"
      value="{{text}}"
      bindinput="onInput"
      disabled="{{submitting}}"
      maxlength="5000"
      auto-height
      focus="{{!hasResult && !submitting}}"
    />
    <view class="meow-counter">{{textLength}}/5000</view>
  </view>

  <!-- 错误提示 -->
  <view wx:if="{{error}}" class="meow-error">{{error}}</view>

  <!-- 解析中：循环展示「日程/待办/日子/愿望」，让人知道仍在处理 -->
  <view wx:if="{{submitting}}" class="meow-thinking">
    <view class="meow-thinking-dots">
      <view class="meow-thinking-dot"></view>
      <view class="meow-thinking-dot"></view>
      <view class="meow-thinking-dot"></view>
    </view>
    <text class="meow-thinking-text">正在识别为{{thinkingWords[thinkingIndex]}}…</text>
  </view>

  <!-- 提交按钮 -->
  <button
    class="meow-submit {{submitting ? 'is-loading' : ''}}"
    loading="{{submitting}}"
    disabled="{{submitting}}"
    bindtap="onMeow"
  >喵一下</button>

  <!-- choose_kind：弹出底部选择框（浮在页面之上），让用户选择类型 -->
  <view wx:if="{{sheetOpen}}" class="sheet-mask" bindtap="onSheetClose" catchtouchmove="noop">
    <view
      class="sheet"
      catchtap="noop"
      bindtouchstart="onSheetTouchStart"
      bindtouchend="onSheetTouchEnd"
    >
      <view class="sheet-handle"></view>
      <text class="sheet-title">想记成哪种？</text>
      <view
        wx:for="{{chooseKinds}}"
        wx:key="*this"
        class="sheet-action"
        data-kind="{{item}}"
        bindtap="onChooseKind"
      >
        <text class="sheet-action-icon">{{kindIcons[item]}}</text>
        <text class="sheet-action-text">{{kindLabels[item]}}</text>
      </view>
    </view>
  </view>

  <!-- ready：展示预览并确认跳转 -->
  <view wx:if="{{resultKind && preview.length > 0}}" class="meow-result">
    <view class="meow-result-head">
      <text class="meow-result-badge">{{kindLabels[resultKind]}}</text>
      <text class="meow-result-hint">已为你填好，确认后可在表单里修改</text>
    </view>

    <view class="meow-preview">
      <view
        wx:for="{{preview}}"
        wx:key="label"
        class="meow-row {{item.empty ? 'is-empty' : ''}}"
      >
        <text class="meow-row-label">{{item.label}}</text>
        <text class="meow-row-value">{{item.empty ? '待补充' : item.value}}</text>
      </view>
    </view>

    <!-- 解析警告 -->
    <view wx:if="{{warnings.length > 0}}" class="meow-warnings">
      <view wx:for="{{warnings}}" wx:key="message" class="meow-warning">
        <text class="meow-warning-dot">!</text>
        <text class="meow-warning-text">{{item.message}}</text>
      </view>
    </view>

    <button class="meow-go" bindtap="onGoCreate">去确认</button>
    <button class="meow-again" bindtap="onReset">重新说一句</button>
  </view>

</view>
