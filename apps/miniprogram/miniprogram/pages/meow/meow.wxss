/* 喵一下页 */

.meow-container {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.meow-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(67, 160, 71, 0.08);
}

.meow-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.meow-emoji {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.meow-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.meow-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #333333;
  box-sizing: border-box;
}

.meow-placeholder {
  color: #b5bdb9;
}

.meow-counter {
  text-align: right;
  font-size: 22rpx;
  color: #b5bdb9;
  margin-top: 8rpx;
}

.meow-error {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #e25b5b;
  background: #fdecec;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
}

.meow-submit {
  margin-top: 32rpx;
  background: #43a047;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}

.meow-input.is-locked {
  opacity: 0.55;
}

.meow-submit.is-loading {
  opacity: 0.8;
}

/* 解析中等待动效 */
.meow-thinking {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  background: #eaf6eb;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
}

.meow-thinking-dots {
  display: flex;
  align-items: center;
  margin-right: 18rpx;
}

.meow-thinking-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #43a047;
  margin-right: 8rpx;
  opacity: 0.4;
  animation: thinkingBlink 1.2s infinite ease-in-out;
}

.meow-thinking-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.meow-thinking-dot:nth-child(3) {
  animation-delay: 0.4s;
  margin-right: 0;
}

@keyframes thinkingBlink {
  0%, 100% { opacity: 0.3; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1.1); }
}

.meow-thinking-text {
  font-size: 28rpx;
  color: #43a047;
  font-weight: 500;
}

.meow-submit::after {
  border: none;
}

/* choose_kind 底部选择框（与 tab bar 面板同款） */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  animation: sheetUp 0.2s ease-out;
}

@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #e0e0e0;
  margin: 8rpx auto 16rpx;
}

.sheet-title {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 12rpx;
}

.sheet-action {
  display: flex;
  align-items: center;
  padding: 28rpx 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.sheet-action:first-of-type {
  border-top: none;
}

.sheet-action-icon {
  width: 48rpx;
  margin-right: 24rpx;
  font-size: 40rpx;
  text-align: center;
}

.sheet-action-text {
  font-size: 32rpx;
  color: #333333;
}

/* ready 结果预览 */
.meow-result {
  margin-top: 36rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(67, 160, 71, 0.08);
}

.meow-result-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.meow-result-badge {
  font-size: 24rpx;
  font-weight: 600;
  color: #43a047;
  background: #eaf6eb;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.meow-result-hint {
  font-size: 22rpx;
  color: #999999;
  flex: 1;
}

.meow-preview {
  border-top: 2rpx solid #f0f4f2;
  padding-top: 12rpx;
}

.meow-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f7f6;
}

.meow-row-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #999999;
}

.meow-row-value {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  word-break: break-all;
}

.meow-row.is-empty .meow-row-value {
  color: #c0c8c4;
}

.meow-warnings {
  margin-top: 16rpx;
}

.meow-warning {
  display: flex;
  align-items: center;
  background: #fff8e8;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-top: 10rpx;
}

.meow-warning-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #f0a020;
  color: #ffffff;
  font-size: 22rpx;
  text-align: center;
  line-height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.meow-warning-text {
  flex: 1;
  font-size: 24rpx;
  color: #a8771a;
}

.meow-go {
  margin-top: 28rpx;
  background: #43a047;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}

.meow-go::after {
  border: none;
}

.meow-again {
  margin-top: 18rpx;
  background: #f5f8f6;
  color: #666666;
  font-size: 28rpx;
  border-radius: 16rpx;
  border: none;
}

.meow-again::after {
  border: none;
}
