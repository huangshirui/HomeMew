/* 我的页面样式 */

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
}

.profile-avatar {
  flex-shrink: 0;
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.user-id {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.edit-btn {
  padding: 12rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
}

.edit-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 区域 */
.section {
  padding: 0 8rpx;
}

.section-header {
  padding: 20rpx 16rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* 家庭项 */
.family-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.family-item:last-child {
  border-bottom: none;
}

.family-item-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background-color: var(--color-border);
  flex-shrink: 0;
  margin-right: 20rpx;
}

.family-item-info {
  flex: 1;
  min-width: 0;
}

.family-item-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.family-item-name {
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.current-tag {
  font-size: 20rpx;
  color: var(--color-primary);
  background-color: var(--color-primary-tint);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.family-item-role {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.manage-btn {
  flex-shrink: 0;
  padding: 8rpx 4rpx 8rpx 20rpx;
}

.manage-text {
  font-size: 26rpx;
  color: var(--color-primary);
}

.no-family-text {
  display: block;
  padding: 32rpx 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-hint);
}

.family-actions {
  display: flex;
  gap: 24rpx;
  padding: 20rpx 16rpx;
  border-top: 2rpx solid var(--color-divider);
}

.action-link {
  background: transparent;
  font-size: 26rpx;
  color: var(--color-primary);
  padding: 0;
  line-height: normal;
  border: none;
}

.action-link::after {
  border: none;
}

/* 菜单项 */
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 16rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.menu-text-hint {
  color: var(--color-text-hint);
}

.arrow {
  font-size: 32rpx;
  color: var(--color-text-hint);
}

.menu-item-danger {
  margin-top: 16rpx;
  border-top: 2rpx solid var(--color-divider);
}
