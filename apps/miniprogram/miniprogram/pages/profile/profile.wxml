<!-- 我的页面 -->
<view class="container">
  <!-- 用户信息卡片 -->
  <block wx:if="{{userInfo}}">
    <view class="user-card card">
      <image class="avatar" src="{{userInfo.avatarUrl || '/assets/images/default-avatar.png'}}" mode="aspectFill" />
      <view class="user-info">
        <text class="nickname">{{userInfo.displayName}}</text>
        <text class="user-id">ID: {{userInfo.id}}</text>
      </view>
      <view class="edit-btn" bindtap="onEditProfile">
        <text class="edit-text">编辑</text>
      </view>
    </view>
  </block>

  <!-- 家庭区域 -->
  <view class="section card">
    <view class="section-header">
      <text class="section-title">我的家庭</text>
    </view>

    <!-- 有家庭 -->
    <block wx:if="{{families.length > 0}}">
      <view
        class="family-item"
        wx:for="{{families}}"
        wx:key="id"
        bindtap="onFamilyTap"
        data-id="{{item.id}}"
      >
        <image
          class="family-item-avatar"
          src="{{item.avatarUrl || '/assets/images/default-family.png'}}"
          mode="aspectFill"
        />
        <view class="family-item-info">
          <view class="family-item-name-row">
            <text class="family-item-name">{{item.name}}</text>
            <text wx:if="{{currentFamily && currentFamily.id === item.id}}" class="current-tag">当前</text>
          </view>
          <text class="family-item-role">{{item.role === 'admin' ? '管理员' : '成员'}} · {{item.memberCount}}人</text>
        </view>
        <view class="manage-btn" catchtap="onManageFamily" data-id="{{item.id}}">
          <text class="manage-text">管理 ›</text>
        </view>
      </view>
    </block>

    <!-- 无家庭提示 -->
    <block wx:else>
      <text class="no-family-text">还没有加入任何家庭</text>
    </block>

    <!-- 操作按钮 -->
    <view class="family-actions">
      <button class="action-link" bindtap="onCreateFamily">+ 创建家庭</button>
      <button class="action-link" bindtap="onJoinFamily">+ 加入家庭</button>
    </view>
  </view>

  <!-- 其他选项 -->
  <view class="section card">
    <view class="menu-item" bindtap="onAbout">
      <text class="menu-text">关于家事喵</text>
      <text class="arrow">›</text>
    </view>

    <!-- 开发版显示调试信息 -->
    <block wx:if="{{isDev}}">
      <view class="menu-item" bindtap="onDebugInfo">
        <text class="menu-text menu-text-hint">调试信息</text>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onClearLocalAuth">
        <text class="menu-text menu-text-hint">清除本地登录状态</text>
        <text class="arrow">›</text>
      </view>
    </block>
  </view>
</view>
