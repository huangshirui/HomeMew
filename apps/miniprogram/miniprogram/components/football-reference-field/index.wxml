<view class="fr-view field-label">{{label}}</view><view class="fr-view field"><button class="fr-button field-open" bindtap="onOpen" disabled="{{disabled}}" aria-label="选择{{label}}"><text class="fr-text {{value?'selected':''}}">{{name||placeholder}}</text><lucide-icon name="chevron-down" size="16" color="#78716c"/></button><button wx:if="{{value}}" class="fr-button field-clear" bindtap="onClear" disabled="{{disabled}}" aria-label="清除{{label}}"><lucide-icon name="x" size="15" color="#78716c"/></button></view>
<view wx:if="{{open}}" class="fr-view mask" catchtap="onClose"><view class="fr-view sheet" catchtap="noop"><view class="fr-view sheet-title"><text class="fr-text">选择{{label}}</text><button class="fr-button" bindtap="onClose" aria-label="关闭选择器" disabled="{{saving}}"><lucide-icon name="x" size="20" color="#57534e"/></button></view><view class="fr-view search"><lucide-icon name="search" size="18" color="#a8a29e"/><input class="fr-input" value="{{search}}" placeholder="搜索名称，至少两个字" bindinput="onInput" bindconfirm="onSearch" confirm-type="search"/></view><scroll-view scroll-y class="fr-scroll-view results">
  <block wx:if="{{!search&&recent.length}}"><view class="fr-view hint">最近选择</view><view wx:for="{{recent}}" wx:key="id" class="fr-view recent-row"><button class="fr-button choice" data-id="{{item.id}}" bindtap="onPick">{{item.name}}</button><button class="fr-button" data-id="{{item.id}}" bindtap="onForget" aria-label="移除最近选择{{item.name}}"><lucide-icon name="x" size="15" color="#78716c"/></button></view></block>
  <view wx:if="{{search.length===1}}" class="fr-view hint">输入至少两个字可搜索更多</view><button wx:for="{{rows}}" wx:key="id" class="fr-button choice" data-id="{{item.id}}" bindtap="onPick" disabled="{{busy}}"><text class="fr-text">{{item.name}}</text><lucide-icon wx:if="{{item.id===value}}" name="check" size="17" color="#047857"/></button>
  <view wx:if="{{busy}}" class="fr-view hint">加载中…</view><view wx:elif="{{error}}" class="fr-view error">{{error}}<button class="fr-button" bindtap="onSearch">重试</button></view><button wx:elif="{{canCreate}}" class="fr-button create" bindtap="onCreate"><lucide-icon name="plus" size="17" color="#047857"/><text class="fr-text">新建“{{searched}}”</text></button><view wx:elif="{{!rows.length&&!recent.length}}" class="fr-view hint">没有找到结果，请调整搜索词</view><button class="fr-button" wx:if="{{nextCursor}}" bindtap="onMore" disabled="{{busy}}">加载更多</button>
</scroll-view></view></view>
