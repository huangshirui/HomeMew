.fr-button{background:transparent;font-size:27rpx;margin:0;color:#57534e}.fr-button::after{border:0}.field-label{font-size:26rpx;color:#57534e;margin-bottom:10rpx}.field{display:flex;background:#fff;border:1rpx solid #e7e5e4;border-radius:20rpx;min-width:0}.field-open{flex:1;min-width:0;display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:0 18rpx;min-height:84rpx;line-height:1.4}.field-open .fr-text{color:#a8a29e;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.field-open .selected{color:#44403c}.field-clear{padding:0 16rpx;display:flex;align-items:center}.mask{position:fixed;inset:0;z-index:95;background:#0006;display:flex;align-items:flex-end}.sheet{box-sizing:border-box;width:100%;background:#fff;border-radius:30rpx 30rpx 0 0;padding:24rpx 28rpx calc(28rpx + env(safe-area-inset-bottom))}.sheet-title{display:flex;align-items:center;justify-content:space-between;font-size:30rpx;font-weight:600}.sheet-title .fr-button{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;padding:0}.search{display:flex;gap:16rpx;align-items:center;border:1rpx solid #e7e5e4;border-radius:20rpx;padding:16rpx 20rpx;margin:16rpx 0}.search .fr-input{flex:1;min-width:0;font-size:27rpx;min-height:48rpx}.results{height:46vh}.choice{display:flex;align-items:center;justify-content:space-between;gap:16rpx;text-align:left;width:100%;min-height:92rpx;font-size:27rpx;line-height:1.5;padding:18rpx 4rpx;border-bottom:1rpx solid #f5f5f4}.choice .fr-text{min-width:0}.recent-row{display:flex;align-items:center}.recent-row .choice{flex:1;min-width:0}.recent-row>.fr-button:last-child{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;padding:0}.hint{font-size:24rpx;color:#78716c;padding:24rpx 0}.error{font-size:25rpx;color:#b91c1c}.create{display:flex;align-items:center;justify-content:center;gap:12rpx;color:#047857;font-size:27rpx;padding:22rpx 0}

.field-open{min-height:44px}.field-clear,.sheet-title .fr-button,.recent-row>.fr-button:last-child{min-width:44px;min-height:44px}
