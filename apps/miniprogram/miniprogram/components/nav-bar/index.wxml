<view
  class="nav-bar"
  style="background: {{background}}; margin-top: -{{topInset}}rpx; padding-top: {{statusBarHeight}}px;"
>
  <view
    class="nav-bar-inner"
    style="height: {{navBarHeight}}px; padding-left: 30rpx; padding-right: {{capsuleRight}}px;"
  >
    <view
      wx:if="{{showBack}}"
      class="nav-back"
      hover-class="nav-back--hover"
      hover-stay-time="100"
      bindtap="onBack"
      aria-role="button"
      aria-label="返回"
    >
      <view class="nav-back-icon"></view>
    </view>
    <view wx:else class="nav-left">
      <slot name="left"></slot>
    </view>

    <view wx:if="{{title}}" class="nav-title">{{title}}</view>
    <slot name="center"></slot>

    <view class="nav-right">
      <slot name="right"></slot>
    </view>
  </view>
</view>
