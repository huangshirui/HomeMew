/* Shared, compact Notion-inspired Icon picker for all Native Record editors. */
.icon-trigger{width:72rpx;height:72rpx;flex:0 0 72rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;background:var(--color-primary-tint,#e8f5ef);margin-right:18rpx}
.icon-trigger:active{opacity:.78}
.icon-disabled{opacity:.5}
.trigger-emoji{font-size:44rpx;line-height:1}
.trigger-empty{display:flex;width:100%;height:100%;align-items:center;justify-content:center;border:2rpx dashed #b5cfc0;border-radius:18rpx;box-sizing:border-box}
.trigger-plus{font-size:42rpx;line-height:1;color:var(--color-primary,#218b58);font-weight:300}
.trigger-image{width:64rpx;height:64rpx;border-radius:12rpx}
.trigger-image-placeholder{font-size:42rpx;color:var(--color-primary,#218b58)}
.icon-mask{position:fixed;inset:0;z-index:9999;background:rgba(20,30,25,.47);display:flex;align-items:flex-end}
.icon-sheet{width:100%;height:75vh;max-height:1150rpx;background:var(--color-surface,#fff);border-radius:28rpx 28rpx 0 0;box-sizing:border-box;display:flex;flex-direction:column;padding-bottom:env(safe-area-inset-bottom);overflow:hidden}
.sheet-grabber{width:68rpx;height:8rpx;border-radius:8rpx;background:#d9e4dc;align-self:center;margin:14rpx 0 6rpx}
.sheet-header{display:flex;justify-content:space-between;align-items:center;padding:12rpx 30rpx 20rpx}
.sheet-title-wrap{display:flex;flex-direction:column;gap:6rpx}
.sheet-title{font-size:34rpx;font-weight:600;color:var(--color-text-primary,#23382b)}
.sheet-subtitle{font-size:23rpx;color:var(--color-text-hint,#839389)}
.sheet-close{width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;color:var(--color-text-hint,#7b877f);font-size:30rpx}
.group-tabs{white-space:nowrap;flex-shrink:0;border-bottom:2rpx solid var(--color-divider,#edf0ed)}
.tabs-inner{display:flex;width:max-content;padding:0 18rpx;gap:4rpx}
.group-tab{flex-shrink:0;padding:16rpx 18rpx 20rpx;font-size:25rpx;color:var(--color-text-secondary,#6c7c72);border-bottom:4rpx solid transparent}
.group-tab-active{color:var(--color-primary,#218b58);border-bottom-color:var(--color-primary,#218b58);font-weight:600}
.search-wrap{display:flex;align-items:center;background:var(--color-bg,#f5f8f6);border-radius:16rpx;margin:18rpx 26rpx 8rpx;padding:0 20rpx;flex-shrink:0;height:76rpx}
.search-icon{color:var(--color-text-hint,#839389);font-size:38rpx;margin-right:14rpx}
.search-input{flex:1;font-size:27rpx;min-width:0;height:70rpx}
.result-bar{display:flex;justify-content:space-between;padding:12rpx 30rpx 8rpx;font-size:24rpx;color:var(--color-text-secondary,#6c7c72)}
.result-count{font-variant-numeric:tabular-nums;color:var(--color-text-hint,#839389)}
.emoji-scroll{flex:1;min-height:100rpx;box-sizing:border-box}
.emoji-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8rpx;padding:10rpx 24rpx 20rpx}
.emoji-cell{height:82rpx;font-size:43rpx;display:flex;align-items:center;justify-content:center;border-radius:12rpx}
.emoji-cell:active{background:var(--color-primary-tint,#e8f5ef)}
.emoji-cell-selected{background:var(--color-primary-tint,#e8f5ef);outline:2rpx solid var(--color-primary,#218b58)}
.empty-results{text-align:center;font-size:26rpx;color:var(--color-text-hint,#839389);padding:80rpx 20rpx}
.load-more{text-align:center;font-size:26rpx;color:var(--color-primary,#218b58);padding:26rpx 0 42rpx}
.sheet-actions{flex-shrink:0;padding:12rpx 30rpx 16rpx;border-top:2rpx solid var(--color-divider,#edf0ed);background:#fff}
.action-upload{display:flex;align-items:center;gap:20rpx;padding:12rpx 6rpx}
.action-picture{display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;background:var(--color-primary-tint,#e8f5ef);border-radius:12rpx;font-size:36rpx;color:var(--color-primary,#218b58)}
.action-text{display:flex;flex-direction:column;gap:4rpx;flex:1}
.action-title{font-size:28rpx;color:var(--color-text-primary,#23382b);font-weight:500}
.action-hint{font-size:22rpx;color:var(--color-text-hint,#839389)}
.action-arrow{font-size:34rpx;color:var(--color-text-hint,#839389)}
.action-clear{text-align:center;color:#a35650;font-size:26rpx;padding:15rpx 0 5rpx}
