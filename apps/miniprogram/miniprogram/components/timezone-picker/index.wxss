/* 时区选择组件样式（与设置页时区选择面板一致） */

.tz-picker-entry {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
}

.tz-picker-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.tz-picker-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tz-picker-text {
  font-size: 28rpx;
  color: var(--color-primary);
}

.arrow {
  font-size: 32rpx;
  color: var(--color-text-hint);
}

/* 时区选择面板 */
.picker-mask {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.picker-sheet {
  width: 100%;
  height: 75vh;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.picker-close {
  font-size: 28rpx;
  color: var(--color-primary);
}

.picker-search {
  padding: 20rpx 32rpx;
}

.picker-search-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  background-color: var(--color-border);
  border-radius: 36rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-list {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx 32rpx;
}

.picker-option {
  display: flex;
  flex-direction: column;
  padding: 24rpx 8rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.picker-option-active {
  background-color: var(--color-primary-tint);
}

.picker-option-label {
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.picker-option-id {
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-top: 4rpx;
}

.picker-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-hint);
}
