.panel{background:#fff;border:1rpx solid #e7e5e4;border-radius:26rpx;padding:28rpx;margin-bottom:24rpx}.heading{font-size:30rpx;font-weight:600;color:#292524}.caption{font-size:23rpx;line-height:1.7;color:#78716c;margin-top:12rpx}.metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin:24rpx 0}.metric{background:#fafaf9;border-radius:20rpx;padding:22rpx;min-width:0;font-size:24rpx;color:#78716c}.metric.wide{grid-column:span 2}.metric .fd-view{display:flex;align-items:baseline;gap:10rpx;margin-top:8rpx}.value{font-size:48rpx;font-weight:600;color:#292524}.unit{font-size:23rpx}.hint{display:block;font-size:22rpx;margin-top:10rpx}.trend-tabs{display:flex;gap:6rpx;padding:6rpx;border-radius:20rpx;background:#f5f5f4;margin-top:24rpx}.trend-tabs .fd-button{flex:1;min-width:0;background:transparent;border:0;border-radius:16rpx;color:#57534e;font-size:23rpx;margin:0;line-height:1.5;padding:18rpx 4rpx}.trend-tabs .selected{background:#fff;color:#065f46;box-shadow:0 1rpx 4rpx #0001}.fd-button::after{border:0}.legend{display:flex;flex-wrap:wrap;gap:16rpx;font-size:21rpx;margin:22rpx 0 10rpx;color:#78716c}.legend .series-a{color:#059669}.legend .series-b{color:#d97706}.chart{width:100%}.plot{height:306px;background-repeat:no-repeat;background-size:100% 100%}.status{padding:40rpx 20rpx;text-align:center;font-size:26rpx;color:#78716c}.error{color:#b91c1c}.status .fd-button{display:flex;align-items:center;justify-content:center;gap:12rpx;margin-top:20rpx;background:transparent;font-size:25rpx;color:#047857}.data-details{border-top:1rpx solid #f5f5f4;padding-top:18rpx;font-size:22rpx;color:#78716c}.month-values{display:flex;gap:22rpx}.month-values .fd-view{flex:none;display:flex;flex-direction:column;gap:4rpx;padding:16rpx 0;min-width:120rpx;font-size:21rpx}
