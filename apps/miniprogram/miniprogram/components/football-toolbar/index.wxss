.ft-button{margin:0;box-sizing:border-box;font-size:28rpx;font-weight:500;line-height:1.3}.ft-button::after{border:0}.toolbar{padding:4rpx 0 24rpx}.toolbar-main,.tabs,.actions,.tab,.toolbar-context,.player,.context-action{display:flex;align-items:center}.toolbar-main{justify-content:space-between;gap:16rpx}.tabs,.actions{gap:12rpx}.tab{justify-content:center;gap:12rpx;min-height:80rpx;padding:16rpx 24rpx;background:#fff;border:1rpx solid #e7e5e4;border-radius:22rpx;color:#57534e}.tab.active{background:#047857;border-color:#047857;color:#fff}.icon-button{display:flex;align-items:center;justify-content:center;width:84rpx;height:84rpx;padding:0;background:#fff;border:1rpx solid #e7e5e4;border-radius:24rpx;position:relative}.icon-button.primary{background:#059669;border-color:#059669}.icon-button.filter-active{border-color:#6ee7b7;background:#ecfdf5}.filter-dot{position:absolute;right:15rpx;top:15rpx;width:10rpx;height:10rpx;border-radius:50%;background:#059669}.toolbar-context{margin-top:20rpx;gap:10rpx}.player-picker{flex:1;min-width:0}.player{gap:12rpx;min-height:84rpx;padding:0 16rpx;border:1rpx solid #e7e5e4;border-radius:20rpx;background:#fff;font-size:27rpx}.player-label{color:#78716c;flex:none}.player-name{flex:1;min-width:0;color:#44403c;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.context-action{gap:8rpx;justify-content:center;min-height:88rpx;padding:0 10rpx;background:transparent;color:#57534e;font-size:26rpx;flex:none}

.icon-button{width:44px;height:44px}.tab,.player,.context-action{min-height:44px}
