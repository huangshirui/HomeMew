# Comma-separated browser origins allowed to call Core during development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public base URL used to expose objects stored under users.avatar_key.
# Production should use the custom domain bound to the homemew-assets R2 bucket.
ASSETS_PUBLIC_URL=https://assets.example.com

# Development-only HS256 key. Replace it locally and configure production with:
# wrangler secret put JWT_SECRET
JWT_SECRET=development-only-change-me-at-least-32-characters
