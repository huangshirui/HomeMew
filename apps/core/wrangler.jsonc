{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homemew-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ASSETS_PUBLIC_URL": "https://homemew-assets.aisr.online",
    "AI_BASE_URL": "https://openrouter.ai/api/v1",
    "AI_MODEL": "",
    "AI_PROMPT_APPENDIX": ""
  },
  "secrets": {
    "required": ["JWT_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homemew-core",
      "database_id": "3921d02d-8158-4706-a979-c18ff9f05ff8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "homemew-assets"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CREATION_DRAFT_QUEUE",
        "queue": "homemew-creation-drafts"
      }
    ],
    "consumers": [
      {
        "queue": "homemew-creation-drafts",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2
      }
    ]
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "24001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
