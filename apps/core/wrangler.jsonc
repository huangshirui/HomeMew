{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homemew-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homemew-core",
      // Local development uses local storage. Replace this value with the ID
      // returned by `wrangler d1 create homemew-core` before remote deployment.
      "database_id": "3921d02d-8158-4706-a979-c18ff9f05ff8",
      "migrations_dir": "migrations"
    }
  ]
}
