{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homemew-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ASSETS_PUBLIC_URL": "https://homemew-assets.aisr.online"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homemew-core",
      "database_id": "3921d02d-8158-4706-a979-c18ff9f05ff8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "homemew-assets"
    }
  ]
}
