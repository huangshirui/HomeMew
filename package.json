{
  "name": "homemew",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @homemew/web dev",
    "test": "pnpm test:miniprogram && pnpm test:web",
    "test:miniprogram": "pnpm --filter homemew-miniprogram test",
    "test:web": "node --test apps/web/*.test.mjs",
    "typecheck": "pnpm typecheck:miniprogram && pnpm typecheck:web",
    "typecheck:miniprogram": "pnpm --filter homemew-miniprogram typecheck",
    "typecheck:web": "pnpm --filter @homemew/web typecheck",
    "build": "pnpm build:web",
    "build:web": "pnpm --filter @homemew/web build",
    "deploy:web:staging": "pnpm --filter @homemew/web deploy:staging",
    "check": "node --check apps/backend/worker.mjs && pnpm test && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "miniprogram-api-typings": "5.2.1"
  }
}
