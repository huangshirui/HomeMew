{
  "name": "homemew",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @homemew/core dev",
    "test": "pnpm --filter @homemew/core test",
    "test:miniprogram-login": "node --check apps/miniprogram/cloudfunctions/login/index.js && node --check apps/miniprogram/cloudfunctions/login/lifespace.js && node --test apps/miniprogram/cloudfunctions/login/identity.test.js apps/miniprogram/cloudfunctions/login/lifespace.test.js",
    "typecheck": "pnpm --filter @homemew/core typecheck",
    "typecheck:miniprogram": "pnpm --filter homemew-miniprogram typecheck",
    "build": "pnpm --filter @homemew/core build",
    "check": "pnpm typecheck:miniprogram && pnpm test:miniprogram-login && pnpm --filter @homemew/core contract && pnpm test && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "miniprogram-api-typings": "5.2.1"
  }
}
